<UserControl
    x:Class="MelodayMusic.Controls.MediaListRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:helpers="using:MelodayMusic.Helpers"
    IsTabStop="False">

    <Grid x:Name="Root" ColumnSpacing="16" Padding="4,6,4,6" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
          ContextRequested="OnContextRequested">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:ArtworkImage x:Name="Art" Width="52" Height="52" DecodeSize="104" ArtworkCornerRadius="{StaticResource MelodayRadiusThumb}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource MelodayBodyStrongText}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource MelodaySecondaryText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="DetailText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MelodaySecondaryText}" />
        <Button x:Name="PlayButton" Grid.Column="3" Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonS}" Height="{StaticResource MelodayButtonS}"
                Opacity="0" IsHitTestVisible="False" helpers:Anim.Fade="True" IsTabStop="False"
                ToolTipService.ToolTip="Play" AutomationProperties.Name="Play" Click="OnPlayClick">
            <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}" Margin="2,0,0,0" />
        </Button>
    </Grid>
</UserControl>
