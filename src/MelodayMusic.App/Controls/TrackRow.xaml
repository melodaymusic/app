<UserControl
    x:Class="MelodayMusic.Controls.TrackRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:helpers="using:MelodayMusic.Helpers"
    IsTabStop="False">

    <Grid x:Name="Root" Height="{StaticResource MelodayTrackRowHeight}" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
          ContextRequested="OnContextRequested">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RankColumn" Width="0" />
            <ColumnDefinition x:Name="LeadColumn" Width="Auto" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition x:Name="AlbumColumn" Width="2*" />
            <ColumnDefinition x:Name="PlaysColumn" Width="0" />
            <ColumnDefinition x:Name="RatingColumn" Width="0" />
            <ColumnDefinition Width="Auto" MinWidth="{StaticResource MelodayButtonXXL}" />
            <ColumnDefinition x:Name="RemoveColumn" Width="0" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,8,0" Spacing="2">
         <TextBlock x:Name="RankText" Style="{StaticResource MelodayBodyStrongText}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
         <TextBlock x:Name="MovementText" FontSize="{StaticResource MelodayFontCaption}" HorizontalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Column="1" Width="{StaticResource MelodayArtThumb}" Height="{StaticResource MelodayArtThumb}" VerticalAlignment="Center">
            <controls:ArtworkImage x:Name="Art" DecodeSize="48" ArtworkCornerRadius="{StaticResource MelodayRadiusThumb}" PlaceholderIcon="Music" />
            <Border x:Name="ArtShade" Background="{StaticResource MelodayArtworkShadeBrush}" CornerRadius="{StaticResource MelodayRadiusThumb}" Visibility="Collapsed" IsHitTestVisible="False" />
            <TextBlock x:Name="NumberText" Style="{StaticResource MelodaySecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
            <controls:LucideIcon x:Name="PlayingIcon" Icon="AudioWaveform" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" Foreground="{ThemeResource MelodayAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <Button x:Name="PlayButton" Style="{StaticResource MelodayRowPlayButtonStyle}" Visibility="Collapsed" IsTabStop="False"
                    Click="OnPlayClick" AutomationProperties.Name="Play">
                <controls:LucideIcon x:Name="PlayGlyph" Icon="Play" IsFilled="True" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}" />
            </Button>
        </Grid>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="12,0,0,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource MelodayBodyText}" />
            <TextBlock x:Name="ArtistText" Style="{StaticResource MelodaySecondaryText}" />
        </StackPanel>

        <TextBlock x:Name="AlbumText" Grid.Column="3" Style="{StaticResource MelodaySecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock x:Name="PlaysText" Grid.Column="4" Style="{StaticResource MelodaySecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" />
        <controls:StarRating x:Name="Rating" Grid.Column="5" StarSize="{StaticResource MelodayStarS}" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0" Margin="12,0,0,0"
                             helpers:Anim.Fade="True" />
        <TextBlock x:Name="DurationText" Grid.Column="6" Style="{StaticResource MelodaySecondaryText}" VerticalAlignment="Center" Margin="12,0,4,0"
                   HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />

        <Rectangle x:Name="Separator" Grid.Column="2" Grid.ColumnSpan="7" Height="1" VerticalAlignment="Bottom"
                   Fill="{ThemeResource MelodayDividerBrush}" IsHitTestVisible="False" />

        <StackPanel x:Name="RowActions" Grid.Column="7" Orientation="Horizontal">
            <Button x:Name="DupeButton" Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonS}" Height="{StaticResource MelodayButtonS}"
                    Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" helpers:Anim.Fade="True" Click="OnDupeClick"
                    ToolTipService.ToolTip="This is a dupe of another song" AutomationProperties.Name="Mark as a dupe">
                <controls:LucideIcon Icon="Merge" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
            </Button>
            <Button x:Name="RemoveButton" Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonS}" Height="{StaticResource MelodayButtonS}"
                    Opacity="0" IsHitTestVisible="False" helpers:Anim.Fade="True" Click="OnRemoveClick" ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove">
                <controls:LucideIcon Icon="X" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
            </Button>
        </StackPanel>
        <Button x:Name="MoreButton" Grid.Column="8" Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonS}" Height="{StaticResource MelodayButtonS}"
                Opacity="0" helpers:Anim.Fade="True" Click="OnMoreClick" ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
            <controls:LucideIcon Icon="Ellipsis" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
        </Button>
    </Grid>
</UserControl>
