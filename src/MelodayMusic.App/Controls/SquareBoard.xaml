<UserControl
    x:Class="MelodayMusic.Controls.SquareBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    IsTabStop="False">

    <Grid>
        <Border x:Name="Plate" Background="{ThemeResource MelodayHoverOverlayBrush}" />
        <controls:AspectBox x:Name="Box">
            <Grid x:Name="Root" CornerRadius="{StaticResource MelodayRadiusBoard}" Background="#2A2930"
                  PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
                  ContextRequested="OnContextRequested">
                <Viewbox x:Name="Portrait" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid Width="1000" Height="1000">
                        <controls:ArtworkImage x:Name="PortraitImage" Width="950" Height="950" DecodeSize="480" ArtworkCornerRadius="475" ShowOutline="False"
                                               PlaceholderIcon="MicVocal" />
                        <controls:PortraitRingLayer x:Name="PortraitRings" />
                    </Grid>
                </Viewbox>
                <controls:MotionArtwork x:Name="Field" />
                <controls:MelodayArt x:Name="MelodayCover" Visibility="Collapsed" IsHitTestVisible="False" />

                <controls:CoverEdgeLayer x:Name="StationEdges" Visibility="Collapsed" />
                <controls:CoverLabels x:Name="StationLabels" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" Style="{StaticResource MelodayBoardTitleText}" FontSize="{StaticResource MelodayFontColourTitle}" TextWrapping="WrapWholeWords" MaxLines="2"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,56,14" IsHitTestVisible="False" />
                <controls:CoverSymbolLayer x:Name="StationSymbol" Visibility="Collapsed" />
                <Button x:Name="PlayButton" x:Load="False" Style="{StaticResource MelodayOverlayButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" IsTabStop="False"
                        ToolTipService.ToolTip="Play" AutomationProperties.Name="Play" Click="OnPlayClick">
                    <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}" Margin="2,0,0,0" />
                </Button>
            </Grid>
        </controls:AspectBox>
    </Grid>
</UserControl>
