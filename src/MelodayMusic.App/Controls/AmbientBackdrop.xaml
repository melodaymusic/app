<UserControl
    x:Class="MelodayMusic.Controls.AmbientBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MelodayMusic.Controls"
    IsHitTestVisible="False" IsTabStop="False">

    <Grid>
        <Border x:Name="BaseLayer" />

        <Grid>
            <Image x:Name="PlayingA" Stretch="UniformToFill" Opacity="0" />
            <Image x:Name="PlayingB" Stretch="UniformToFill" Opacity="0" />
        </Grid>
        <Border x:Name="DimLayer" />
        <Border x:Name="FillLayer" Opacity="0" />

        <local:FadedArtwork x:Name="HeaderLayer" FadeLeft="0" FadeTop="0" FadeBottom="0.7" />
        <Border x:Name="HeaderShade" Height="680" VerticalAlignment="Top" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#59000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="0.6" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Image x:Name="PageA" Stretch="UniformToFill" Opacity="0" />
            <Image x:Name="PageB" Stretch="UniformToFill" Opacity="0" />
        </Grid>
        <Border x:Name="PageShade" Background="Black" Opacity="0" />

        <Border x:Name="WashLayer" Height="680" VerticalAlignment="Top" />
    </Grid>
</UserControl>
