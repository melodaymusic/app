<UserControl
    x:Class="MelodayMusic.Controls.ColourBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    IsTabStop="False">

    <Grid>
    <Border x:Name="Plate" Background="{ThemeResource MelodayHoverOverlayBrush}" />
    <Grid x:Name="Root" Width="{StaticResource MelodayBoard}" CornerRadius="{StaticResource MelodayRadiusBoard}" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
          ContextRequested="OnContextRequested">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:AspectBox>
        <Grid x:Name="ArtHost">
            <controls:ArtworkImage x:Name="Art" DecodeSize="320" ArtworkCornerRadius="{StaticResource MelodayRadiusBoardTop}" ShowOutline="False" />
            <Border x:Name="MixArt" Visibility="Collapsed" CornerRadius="{StaticResource MelodayRadiusBoardTop}">
                <controls:MixCircles Layout="Float" Background="Transparent">
                    <controls:ArtworkImage x:Name="MixArtist1" DecodeSize="200" ArtworkCornerRadius="999" ShowOutline="False" PlaceholderIcon="MicVocal" />
                    <controls:ArtworkImage x:Name="MixArtist2" DecodeSize="200" ArtworkCornerRadius="999" ShowOutline="False" PlaceholderIcon="MicVocal" />
                    <controls:ArtworkImage x:Name="MixArtist3" DecodeSize="200" ArtworkCornerRadius="999" ShowOutline="False" PlaceholderIcon="MicVocal" />
                    <controls:ArtworkImage x:Name="MixArtist4" DecodeSize="120" ArtworkCornerRadius="999" ShowOutline="False" PlaceholderIcon="MicVocal" Visibility="Collapsed" />
                    <controls:ArtworkImage x:Name="MixArtist5" DecodeSize="120" ArtworkCornerRadius="999" ShowOutline="False" PlaceholderIcon="MicVocal" Visibility="Collapsed" />
                    <controls:ArtworkImage x:Name="MixArtist6" DecodeSize="120" ArtworkCornerRadius="999" ShowOutline="False" PlaceholderIcon="MicVocal" Visibility="Collapsed" />
                </controls:MixCircles>
            </Border>
            <Border x:Name="ShapeArt" Visibility="Collapsed" CornerRadius="{StaticResource MelodayRadiusBoardTop}">
                <Viewbox Stretch="Fill">
                    <Canvas Width="1000" Height="1000">
                        <Image x:Name="ShapeBack" Stretch="Fill" />
                        <Image x:Name="ShapeFront" Stretch="Fill" />
                        <Image x:Name="ShapeOverlay" Width="1000" Height="1000" Stretch="Fill" />
                    </Canvas>
                </Viewbox>
            </Border>
            <controls:CoverSymbolLayer x:Name="MixSymbol" Visibility="Collapsed" />
            <Button x:Name="PlayButton" x:Load="False" Style="{StaticResource MelodayOverlayButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12" IsTabStop="False" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play" Click="OnPlayClick">
                <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}" Margin="2,0,0,0" />
            </Button>
        </Grid>
        </controls:AspectBox>

        <Border x:Name="Panel" Grid.Row="1" Height="{StaticResource MelodayColourPanel}" Padding="{StaticResource MelodayColourPanelPadding}" CornerRadius="{StaticResource MelodayRadiusBoardBottom}"
                Background="{StaticResource MelodayColourBoardFallbackBrush}">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TitleText" Style="{StaticResource MelodayTextBase}" FontSize="{StaticResource MelodayFontColourTitle}" FontWeight="SemiBold" Foreground="{StaticResource MelodayOnColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,18,0" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource MelodayTextBase}" FontSize="{StaticResource MelodayFontCaption}" Foreground="{StaticResource MelodayOnColorBodyBrush}"
                               TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <controls:LucideIcon x:Name="SmartIcon" Icon="Sparkles" Width="{StaticResource MelodayIconXS}" Height="{StaticResource MelodayIconXS}" Foreground="{StaticResource MelodayOnColorBodyBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0" Visibility="Collapsed"
                                     ToolTipService.ToolTip="Smart playlist" AutomationProperties.Name="Smart playlist" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
