<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>MelodayMusic</RootNamespace>
    <AssemblyName>MelodayMusic</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MelodayMusic.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Product>Meloday Music</Product>
    <Company>Meloday Music</Company>
    <AssemblyTitle>Meloday Music</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" GeneratePathProperty="true" />
    <!-- Its ONNX Runtime copies would replace the pinned CPU runtime. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2223" ExcludeAssets="all" />
    <Content Include="Assets\**\*.*" Exclude="Assets\Genres\generation-prompts.json;Assets\Genres\verification.json;Assets\Genres\palette.json;Assets\Genres\status.json;Assets\Genres\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <Content Include="Native\$(RuntimeIdentifier)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MelodayMusic.Core\MelodayMusic.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MelodayUiSmoke)' == 'true'">
    <Compile Include="..\..\tools\ui-smoke\RadioSmoke.cs" Link="Testing\RadioSmoke.cs" />
    <Compile Include="..\..\tools\ui-smoke\PolishSmoke.cs" Link="Testing\PolishSmoke.cs" />
  </ItemGroup>
  <!-- Unpackaged publish leaves out the app's .pri, which holds the compiled XAML. -->
  <Target Name="IncludeAppPriInPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)$(TargetName).pri')" />
    <Copy SourceFiles="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\$(RuntimeIdentifier)\native\onnxruntime.dll;$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\$(RuntimeIdentifier)\native\onnxruntime_providers_shared.dll" DestinationFolder="$(PublishDir)" />
    <GetAssemblyIdentity AssemblyFiles="$(PublishDir)Microsoft.ML.OnnxRuntime.dll">
      <Output TaskParameter="Assemblies" ItemName="PublishedEngineRuntime" />
    </GetAssemblyIdentity>
    <Error Condition="'%(PublishedEngineRuntime.Version)' != '1.23.2.0'" Text="The published ONNX managed runtime was overwritten. Clean stale build/publish outputs and rebuild; ME requires runtime 1.23.2.0." />
  </Target>
  <Target Name="PinEngineNativeRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\$(RuntimeIdentifier)\native\onnxruntime.dll;$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\$(RuntimeIdentifier)\native\onnxruntime_providers_shared.dll" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="CheckProjectMRuntime" BeforeTargets="PrepareForBuild" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('Native\win-x64\Meloday.ProjectM.dll') Or !Exists('Native\win-x64\projectM-4.dll') Or !Exists('Native\win-x64\glew32.dll')" Text="The projectM runtime is missing. Run tools/projectm/build.ps1 before building the x64 app." />
  </Target>
  <Target Name="CheckMelodayEngineModel" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Assets\Engine\audio.onnx')" Text="The ME audio model is missing. Run tools/engine/download.ps1 before building." />
  </Target>
</Project>
