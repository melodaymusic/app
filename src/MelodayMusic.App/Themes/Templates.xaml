<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MelodayMusic.Helpers">

    <Style x:Key="MelodayTileItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="{StaticResource MelodayTileMargin}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MelodayRadiusTileHost}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>
    <Style x:Key="MelodayRowTileItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="helpers:SelectionChrome.Neutral" Value="True" />
        <Setter Property="Margin" Value="{StaticResource MelodayRowTileMargin}" />
        <Setter Property="Padding" Value="{StaticResource MelodayRowCardPadding}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MelodayRadiusRowTileHost}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>

    <Style x:Key="MelodayRowBoardItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="helpers:SelectionChrome.Neutral" Value="True" />
        <Setter Property="Margin" Value="{StaticResource MelodayRowBoardMargin}" />
        <Setter Property="Padding" Value="{StaticResource MelodayRowCardPadding}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MelodayRadiusRowBoardHost}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>
    <Style x:Key="MelodayTrackItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="helpers:SelectionChrome.Neutral" Value="True" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource MelodayTrackRowHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource MelodayRadiusRow}" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>

    <Style x:Key="MelodayNavItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="helpers:SelectionChrome.Neutral" Value="True" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="{StaticResource MelodayNavItemHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource MelodayRadiusNavItem}" />
        <Setter Property="FontFamily" Value="{StaticResource MelodayFont}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="MelodaySettingsNavItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource MelodayNavItemStyle}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="MelodayChipItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="helpers:SelectionChrome.Neutral" Value="True" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="{StaticResource MelodayNavItemHeight}" />
        <Setter Property="Height" Value="{StaticResource MelodayNavItemHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MelodayRadiusChip}" />
    </Style>
</ResourceDictionary>
