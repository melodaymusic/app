    <Style x:Key="MelodayTextBase" TargetType="TextBlock">
        <Setter Property="helpers:TextOverflow.Reveal" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource MelodayFont}" />
        <Setter Property="Foreground" Value="{ThemeResource MelodayTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="MelodayHeroText" TargetType="TextBlock" BasedOn="{StaticResource MelodayTextBase}">
        <Setter Property="AutomationProperties.HeadingLevel" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource MelodayFontHero}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="{StaticResource MelodayLineHero}" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="MelodayDisplayText" TargetType="TextBlock" BasedOn="{StaticResource MelodayTextBase}">
        <Setter Property="FontSize" Value="{StaticResource MelodayFontDisplay}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="{StaticResource MelodayLineDisplay}" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="MelodayTitleText" TargetType="TextBlock" BasedOn="{StaticResource MelodayTextBase}">
