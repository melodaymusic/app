    <Style x:Key="MelodayIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource MelodayTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource MelodayButtonM}" />
        <Setter Property="Height" Value="{StaticResource MelodayButtonM}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="Fill" Background="{ThemeResource MelodayAccentBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" helpers:Anim.Fade="True" />
                        <Border x:Name="Overlay" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" helpers:Anim.Fade="True" />
                        <ContentPresenter x:Name="Presenter" helpers:Anim.Fade="True"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                        <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{ThemeResource MelodayAccentBrush}" helpers:Anim.Fade="True"
                                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-4" Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Fill.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Fill.Opacity" Value="0" />
                                        <Setter Target="Overlay.Background" Value="{ThemeResource MelodayHoverOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource MelodayTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Fill.Opacity" Value="0" />
                                        <Setter Target="Overlay.Background" Value="{ThemeResource MelodayPressedOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource MelodayTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Fill.Opacity" Value="0" />
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource MelodayAccentBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                        <Setter Target="Fill.Opacity" Value="0.2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{ThemeResource MelodayHoverOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource MelodayAccentBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                        <Setter Target="Fill.Opacity" Value="0.2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{ThemeResource MelodayPressedOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource MelodayAccentBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                        <Setter Target="Fill.Opacity" Value="0.2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource MelodayAccentBrush}" />
                                        <Setter Target="Fill.Opacity" Value="0.2" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

