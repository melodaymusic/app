<Page
    x:Class="MelodayMusic.Views.MadeShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:models="using:MelodayMusic.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource MelodayPageHeaderPadding}" />

        <GridView x:Name="Grid" Grid.Row="1" Padding="{StaticResource MelodayGridPadding}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource MelodayTileItemStyle}" controls:ResponsiveGrid.MinItemWidth="190"
                  controls:QueueDrag.IsSource="True"
                  AutomationProperties.AutomationId="MadeShelfGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <controls:CardSlot>
                        <controls:MediaTile Item="{x:Bind}" TileSize="0" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <controls:PageStateView x:Name="State" Grid.Row="1" SkeletonKind="Tiles" SkeletonPadding="{StaticResource MelodayGridPadding}"
                                EmptyText="Meloday hasn't made any of these yet." EmptyIcon="ListMusic" />
    </Grid>
</Page>
