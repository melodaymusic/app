<Page
    x:Class="MelodayMusic.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:helpers="using:MelodayMusic.Helpers"
    xmlns:vm="using:MelodayMusic.ViewModels"
    Background="Transparent">

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="Layout" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource MelodayNowPlayingPadding}" ColumnSpacing="48" RowSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:ArtworkImage x:Name="Cover" Width="{StaticResource MelodayArtNowPlaying}" Height="{StaticResource MelodayArtNowPlaying}" DecodeSize="720"
                                       ArtworkCornerRadius="{StaticResource MelodayRadiusLargeArtwork}" PlaceholderIcon="Music"
                                       SourcePath="{x:Bind Player.ArtworkPath, Mode=OneWay}" VerticalAlignment="Center" />

                <controls:VisualizerView x:Name="Visualizer" CornerRadius="{StaticResource MelodayRadiusLargeArtwork}" VerticalAlignment="Center" Visibility="Collapsed" />

                <Border x:Name="MixCard" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Padding="8,8,16,8" CornerRadius="16"
                        Background="{ThemeResource MelodayOverlayGlassBrush}" BorderBrush="{StaticResource MelodayOnColorEdgeBrush}" BorderThickness="1"
                        Visibility="{x:Bind Player.HasMixCue, Mode=OneWay}" helpers:Anim.Appear="True"
                        AutomationProperties.AutomationId="MixCue" AutomationProperties.Name="{x:Bind Player.MixCueName, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:ArtworkImage Width="48" Height="48" DecodeSize="96" ArtworkCornerRadius="8" PlaceholderIcon="Music"
                                               SourcePath="{x:Bind Player.MixNextThumb, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Player.MixOverline, Mode=OneWay}" Style="{StaticResource MelodayOverlineText}" Foreground="{StaticResource MelodayOnColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind Player.MixNextTitle, Mode=OneWay}" Style="{StaticResource MelodayBodyStrongText}" Foreground="{StaticResource MelodayOnColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind Player.MixStatus, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" Foreground="{StaticResource MelodayOnColorBodyBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{x:Bind Player.MixProgress, Mode=OneWay}"
                                     Foreground="{StaticResource MelodayOnColorPrimaryBrush}" Background="{StaticResource MelodayOnColorFillBrush}"
                                     Visibility="{x:Bind Player.MixStarted, Mode=OneWay}" AutomationProperties.Name="Mix progress" />
                    </Grid>
                </Border>

                <StackPanel x:Name="Info" Grid.Column="1" Width="460" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Player.LiveLabel, Mode=OneWay}" Style="{StaticResource MelodayOverlineText}" Foreground="{ThemeResource MelodayAccentTextBrush}"
                               Visibility="{x:Bind Player.IsLive, Mode=OneWay}" AutomationProperties.AutomationId="NowPlayingLive" />
                    <TextBlock Text="{x:Bind Player.LiveProgrammeLabel, Mode=OneWay}" Style="{StaticResource MelodayTitleText}"
                               TextWrapping="WrapWholeWords" Margin="0,2,0,12" MaxLines="2"
                               Visibility="{x:Bind Player.ShowLiveProgrammeHeading, Mode=OneWay}" AutomationProperties.AutomationId="NowPlayingProgramme" />
                    <Grid ColumnSpacing="14" Margin="0,4,0,12" Visibility="{x:Bind Player.HasFeatured, Mode=OneWay}"
                          helpers:Anim.Appear="True" AutomationProperties.AutomationId="FeaturedArtist">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtworkImage Width="64" Height="64" DecodeSize="128" ArtworkCornerRadius="32" PlaceholderIcon="MicVocal"
                                               SourcePath="{x:Bind Player.FeaturedArtistThumb, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="ARTIST TAKEOVER" Style="{StaticResource MelodayOverlineText}" Foreground="{ThemeResource MelodayTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind Player.FeaturedArtist, Mode=OneWay}" Style="{StaticResource MelodayTitleText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Player.FeaturedProgress, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TitleText" Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource MelodayHeroText}" FontSize="{StaticResource MelodayFontFeature}" LineHeight="{StaticResource MelodayLineFeature}"
                               IsTextSelectionEnabled="True" AutomationProperties.AutomationId="NowPlayingPageTitle" />
                    <HyperlinkButton Command="{x:Bind Player.OpenArtistCommand}" Style="{StaticResource MelodayFeatureSubtitleLinkStyle}">
                        <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                    <HyperlinkButton Command="{x:Bind Player.OpenAlbumCommand}" Style="{StaticResource MelodayLinkButtonStyle}" FontSize="{StaticResource MelodayFontLabel}">
                        <TextBlock Text="{x:Bind Player.AlbumYearText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>

                    <StackPanel Margin="0,24,0,0" Spacing="0">
                        <Slider x:Name="Progress" Minimum="0" StepFrequency="1" IsThumbToolTipEnabled="False"
                                Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{x:Bind Player.CanSeek, Mode=OneWay}" AutomationProperties.Name="Playback position" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Player.StreamDescription, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}"
                                       Foreground="{ThemeResource MelodayTextTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="StreamDescription" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Player.RemainingText, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource MelodayIconToggleStyle}" Width="{StaticResource MelodayButtonL}" Height="{StaticResource MelodayButtonL}"
                                      IsChecked="{x:Bind Player.IsShuffled, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind Player.ShuffleLabel, Mode=OneWay}" AutomationProperties.Name="Shuffle">
                            <controls:LucideIcon Icon="Shuffle" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" />
                        </ToggleButton>
                        <Button Grid.Column="1" Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonXXL}" Height="{StaticResource MelodayButtonXXL}" Command="{x:Bind Player.PreviousCommand}"
                                IsEnabled="{x:Bind Player.HasPrevious, Mode=OneWay}" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                            <controls:LucideIcon Icon="SkipBack" IsFilled="True" Width="{StaticResource MelodayIconXXL}" Height="{StaticResource MelodayIconXXL}" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource MelodayPlayButtonStyle}" Width="{StaticResource MelodayButtonHero}" Height="{StaticResource MelodayButtonHero}" Margin="20,0"
                                Command="{x:Bind Player.PlayPauseCommand}" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}" AutomationProperties.AutomationId="NowPlayingPlayPause">
                            <Grid>
                                <controls:LucideIcon Icon="{x:Bind Player.PlayPauseIcon, Mode=OneWay}" IsFilled="True" Width="{StaticResource MelodayIconHero}" Height="{StaticResource MelodayIconHero}"
                                                     Visibility="{x:Bind helpers:Format.CollapsedIf(Player.IsBuffering), Mode=OneWay}" />
                                <ProgressRing IsActive="{x:Bind Player.IsBuffering, Mode=OneWay}" Width="28" Height="28" Foreground="{ThemeResource MelodayOnPlayButtonBrush}" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonXXL}" Height="{StaticResource MelodayButtonXXL}" Command="{x:Bind Player.NextCommand}"
                                IsEnabled="{x:Bind Player.HasNext, Mode=OneWay}" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                            <controls:LucideIcon Icon="SkipForward" IsFilled="True" Width="{StaticResource MelodayIconXXL}" Height="{StaticResource MelodayIconXXL}" />
                        </Button>
                        <controls:RepeatToggle Grid.Column="4" HorizontalAlignment="Right" Width="{StaticResource MelodayButtonL}" Height="{StaticResource MelodayButtonL}"
                                               IconSize="{StaticResource MelodayIconL}" />
                    </Grid>

                    <Grid Margin="0,16,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource MelodayIconButtonStyle}" Command="{x:Bind Player.ToggleMuteCommand}" ToolTipService.ToolTip="Mute (Ctrl+M)" AutomationProperties.Name="Mute">
                            <controls:LucideIcon Icon="{x:Bind Player.VolumeIcon, Mode=OneWay}" />
                        </Button>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                Value="{x:Bind Player.Volume, Mode=TwoWay}" AutomationProperties.Name="Volume" />
                    </Grid>

                    <Grid Margin="0,8,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:StarRating Item="{x:Bind Player.Track, Mode=OneWay}" StarSize="{StaticResource MelodayStarL}" VerticalAlignment="Center"
                                             AutomationProperties.Name="Track rating" />
                        <controls:MuteButton Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls:VisualizerButton Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}" IconSize="{StaticResource MelodayIconL}" />
                            <controls:CuratorButton Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}" IconSize="{StaticResource MelodayIconL}" />
                            <controls:StationFeedbackButton Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}" IconSize="{StaticResource MelodayIconL}" />
                            <Button Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}" Command="{x:Bind Player.SonicRadioCommand}"
                                    ToolTipService.ToolTip="Sonic radio from this track" AutomationProperties.Name="Sonic Radio">
                                <controls:LucideIcon Icon="Radio" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="LyricsToggle" Style="{StaticResource MelodayIconToggleStyle}" Tag="SidePanelToggle" Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}"
                                          Click="OnLyricsClick" ToolTipService.ToolTip="Lyrics" AutomationProperties.Name="Lyrics">
                                <controls:LucideIcon Icon="MessageSquareQuote" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" />
                            </ToggleButton>
                            <controls:SleepTimerButton Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}" IconSize="{StaticResource MelodayIconL}" />
                            <controls:CastButton Width="{StaticResource MelodayButtonM}" Height="{StaticResource MelodayButtonM}" IconSize="{StaticResource MelodayIconL}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="UpNextPanel" Grid.Row="1" Grid.ColumnSpan="2" Spacing="12" Visibility="{x:Bind Player.HasUpNext, Mode=OneWay}"
                            helpers:Anim.Appear="True">
                    <controls:SectionHeader Title="Up Next" Trailing="{x:Bind Player.UpNextSummary, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind Player.UpNextTop}" Margin="-12,0" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource MelodayTrackItemStyle}" DoubleTapped="OnUpNextDoubleTapped" KeyDown="OnUpNextKeyDown"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True" controls:QueueDrag.IsTarget="True"
                              controls:TrackListBehavior.PlayCommand="{x:Bind Player.JumpToCommand}" controls:TrackListBehavior.RemoveCommand="{x:Bind Player.RemoveCommand}"
                              ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Up next">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueItemViewModel">
                                <controls:TrackRow Track="{x:Bind Track}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <controls:PageStateView x:Name="EmptyPanel" Grid.RowSpan="2" Grid.ColumnSpan="2" IsEmpty="{x:Bind helpers:Format.Not(Player.HasTrack), Mode=OneWay}"
                                        EmptyIcon="Music" EmptyTitle="Nothing Playing" EmptyText="Nothing playing." />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
