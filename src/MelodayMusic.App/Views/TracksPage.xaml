<Page
    x:Class="MelodayMusic.Views.TracksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:models="using:MelodayMusic.Core.Models"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Padding="{StaticResource MelodayPageHeaderPadding}" Title="Tracks" Subtitle="{x:Bind ViewModel.CountText, Mode=OneWay}">
            <controls:ActionWrapPanel Spacing="8">
                <Button Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnShuffleAll" AutomationProperties.AutomationId="ShuffleAllButton">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle All" />
                </Button>
                <controls:SortButton Options="{x:Bind ViewModel.SortOptions}" Selected="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
            </controls:ActionWrapPanel>
        </controls:PageHeader>

        <ListView x:Name="List" Grid.Row="1" Padding="{StaticResource MelodayListPadding}"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="Extended" controls:TrackListBehavior.IsEnabled="True"
                  ItemContainerStyle="{StaticResource MelodayTrackItemStyle}"
                  IncrementalLoadingThreshold="4" DataFetchSize="2"
                  AutomationProperties.Name="Tracks" AutomationProperties.AutomationId="TracksList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <controls:TrackRow Track="{x:Bind}" ShowPlays="True" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:PageStateView SkeletonKind="Tracks" SkeletonPadding="{StaticResource MelodayListPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                EmptyText="No tracks in this library yet." RetryRequested="OnRetry" />
    </Grid>
</Page>
