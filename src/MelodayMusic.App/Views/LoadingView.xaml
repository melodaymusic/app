<UserControl
    x:Class="MelodayMusic.Views.LoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <controls:MelodayMark Width="96" Height="40" Foreground="{ThemeResource MelodayTextPrimaryBrush}" />
            <ProgressRing IsActive="True" Width="28" Height="28" />
            <TextBlock Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
