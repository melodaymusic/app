<Page
    x:Class="MelodayMusic.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:helpers="using:MelodayMusic.Helpers"
    xmlns:vm="using:MelodayMusic.ViewModels"
    RequestedTheme="Dark"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  ViewChanged="OnScrollChanged" AutomationProperties.AutomationId="PageScroller">
        <StackPanel Spacing="{StaticResource MelodaySectionSpacing}" Padding="0,0,0,136">

            <Grid x:Name="Hero">
                <controls:FadedArtwork x:Name="HeroImage" HorizontalAlignment="Right" VerticalAlignment="Top" FadeTop="0" />
                <Border x:Name="HeroScrim" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="0.38" />
                            <GradientStop Color="#66000000" Offset="0.6" />
                            <GradientStop Color="#80000000" Offset="0.76" />
                            <GradientStop Color="#40000000" Offset="0.9" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel x:Name="HeroSkeleton" VerticalAlignment="Bottom" Padding="{StaticResource MelodayGutterPadding}"
                            Spacing="{StaticResource MelodayPanelSpacing}" IsHitTestVisible="False" Visibility="Collapsed" />

                <StackPanel x:Name="HeroText" VerticalAlignment="Bottom" Padding="{StaticResource MelodayGutterPadding}"
                            Spacing="{StaticResource MelodayPanelSpacing}">
                    <StackPanel x:Name="HeroIdentity" HorizontalAlignment="Left" Spacing="{StaticResource MelodayPanelSpacing}">
                        <Grid>
                            <TextBlock x:Name="NameText" Text="{x:Bind ViewModel.Artist.Title, Mode=OneWay}" Style="{StaticResource MelodayHeroText}"
                                       FontSize="{StaticResource MelodayFontHeroLarge}" LineHeight="{StaticResource MelodayLineHeroLarge}" Foreground="{StaticResource MelodayOnColorPrimaryBrush}"
                                       TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                       VerticalAlignment="Bottom" />
                            <controls:ArtistLogo x:Name="LogoImage" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed"
                                                 AutomationProperties.AutomationId="ArtistLogo" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="HeroActions" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Style="{StaticResource MelodayHeroPlayButtonStyle}" Click="OnPlay"
                                AutomationProperties.Name="Play artist" AutomationProperties.AutomationId="PlayArtistButton">
                            <controls:IconLabel Icon="Play" IsFilled="True" Text="Play" />
                        </Button>
                        <Button Style="{StaticResource MelodayGlassButtonStyle}" Click="OnShuffle" AutomationProperties.Name="Shuffle artist">
                            <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                        </Button>
                        <Button x:Name="SonicButton" Style="{StaticResource MelodayGlassRoundButtonStyle}" Click="OnRadio"
                                ToolTipService.ToolTip="Sonic Radio" AutomationProperties.Name="Sonic Radio">
                            <controls:LucideIcon Icon="Radio" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
                        </Button>
                        <Button x:Name="EditImagesButton" Style="{StaticResource MelodayGlassRoundButtonStyle}" Click="OnEditImages"
                                ToolTipService.ToolTip="Edit details" AutomationProperties.Name="Edit artist details"
                                AutomationProperties.AutomationId="EditArtistImagesButton">
                            <controls:LucideIcon Icon="Pencil" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
                        </Button>
                        <Button x:Name="MoreButton" Style="{StaticResource MelodayGlassRoundButtonStyle}" Click="OnMore"
                                ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                            <controls:LucideIcon Icon="Ellipsis" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
                        </Button>
                        <controls:StarRating Item="{x:Bind ViewModel.Artist, Mode=OneWay}" StarSize="{StaticResource MelodayStarM}" OnArtwork="True" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="FactsList" ItemsSource="{x:Bind ViewModel.Facts}" IsTabStop="False" Margin="{StaticResource MelodayGutterPadding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:UniformColumns Columns="4" ColumnSpacing="{StaticResource MelodayPanelSpacing}" RowSpacing="{StaticResource MelodayPanelSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtistFact">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}"
                                                 Foreground="{StaticResource MelodayOnColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource MelodaySecondaryText}" Foreground="{StaticResource MelodayOnColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Value}" Style="{StaticResource MelodayBodyStrongText}" Foreground="{StaticResource MelodayOnColorPrimaryBrush}"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid x:Name="TabsRow" Padding="{StaticResource MelodayGutterPadding}">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource MelodayOnColorHairlineBrush}" />
                <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="24" />
            </Grid>

            <controls:PageStateView SkeletonKind="Rows" SkeletonPadding="{StaticResource MelodayGutterPadding}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry" />

            <Grid x:Name="OverviewSection" Padding="{StaticResource MelodayGutterPadding}" ColumnSpacing="{StaticResource MelodayPanelSpacing}"
                  RowSpacing="{StaticResource MelodayPanelSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SongsColumn" Width="3*" />
                    <ColumnDefinition x:Name="LatestColumn" Width="2*" MaxWidth="520" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="TopSongsPanel" Style="{StaticResource MelodayGlassPanelStyle}"
                        Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.TopSongs.Count), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Title="Top Songs" />
                        <ListView x:Name="TopSongsList" ItemsSource="{x:Bind ViewModel.TopSongs}" SelectionMode="Single"
                                  controls:TrackListBehavior.IsEnabled="True" ItemContainerStyle="{StaticResource MelodayTrackItemStyle}"
                                  Height="{StaticResource MelodayTopSongsHeight}" ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Top Songs">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RankedTrack">
                                    <controls:TrackRow Track="{x:Bind Track}" Rank="{x:Bind Rank}" Mode="Ranked" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border x:Name="LatestPanel" Grid.Column="1" Style="{StaticResource MelodayGlassPanelStyle}"
                        Visibility="{x:Bind helpers:Format.VisibleIfNotNull(ViewModel.LatestRelease), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Title="Latest Release" />
                        <Button x:Name="LatestCover" Style="{StaticResource MelodayTileButtonStyle}" Click="OnOpenLatest" HorizontalAlignment="Left" Margin="-10"
                                AutomationProperties.Name="{x:Bind ViewModel.LatestRelease.Title, Mode=OneWay}">
                            <controls:ArtworkImage x:Name="LatestArt" Width="{StaticResource MelodayArtLatest}" Height="{StaticResource MelodayArtLatest}"
                                                   DecodeSize="400" ArtworkCornerRadius="{StaticResource MelodayRadiusControl}" />
                        </Button>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.LatestRelease.Title, Mode=OneWay}" Style="{StaticResource MelodayHeadlineText}" Foreground="{StaticResource MelodayOnColorPrimaryBrush}"
                                       TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.LatestReleaseMeta, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LatestRelease.Summary, Mode=OneWay}" Style="{StaticResource MelodayParagraphText}"
                                   Foreground="{StaticResource MelodayOnColorBodyBrush}" MaxLines="3" TextTrimming="WordEllipsis"
                                   Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.LatestRelease.Summary), Mode=OneWay}" />
                        <Button Style="{StaticResource MelodayHeroPlayButtonStyle}" Click="OnPlayLatest" HorizontalAlignment="Left"
                                AutomationProperties.Name="Play latest release">
                            <controls:IconLabel Icon="Play" IsFilled="True" Text="Play" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl x:Name="AlbumsSection" ItemsSource="{x:Bind ViewModel.AlbumGroups}" Margin="{StaticResource MelodayGutterPadding}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource MelodaySectionSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumGroup">
                        <controls:MediaRowControl Header="{x:Bind Title}" ItemsSource="{x:Bind Albums}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:MediaRowControl x:Name="PlaylistsSection" Header="More With This Artist"
                                      ItemsSource="{x:Bind ViewModel.FeaturedPlaylists}" Margin="{StaticResource MelodayGutterPadding}"
                                      Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.FeaturedPlaylists.Count), Mode=OneWay}" />

            <controls:MediaRowControl x:Name="SimilarSection" Header="Similar Artists"
                                      ItemsSource="{x:Bind ViewModel.SimilarArtists}" Margin="{StaticResource MelodayGutterPadding}"
                                      Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.SimilarArtists.Count), Mode=OneWay}" />

            <!-- Releases from MusicBrainz, framed apart from the library so it's clear they aren't yours (yet). -->
            <Border x:Name="CatalogueSection" Style="{StaticResource MelodayGlassPanelStyle}" Margin="{StaticResource MelodayGutterPadding}"
                    Visibility="{x:Bind ViewModel.CatalogueVisible, Mode=OneWay}" AutomationProperties.Name="From MusicBrainz">
                <StackPanel Spacing="{StaticResource MelodaySectionSpacing}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:LucideIcon Icon="Globe" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}"
                                             Foreground="{StaticResource MelodayOnColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="FROM MUSICBRAINZ" Style="{StaticResource MelodayOverlineText}" CharacterSpacing="120"
                                   Foreground="{StaticResource MelodayOnColorSecondaryBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="2" Content="musicbrainz.org" NavigateUri="https://musicbrainz.org" Style="{StaticResource MelodayMoreLinkStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <controls:MediaRowControl Header="New Releases" BleedsToEdges="False" ItemsSource="{x:Bind ViewModel.NewReleases}"
                        Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.NewReleases.Count), Mode=OneWay}" />
                    <controls:MediaRowControl Header="Not in Your Library" BleedsToEdges="False" ItemsSource="{x:Bind ViewModel.MissingReleases}"
                        Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.MissingReleases.Count), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CatalogueStatus, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}"
                        Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.CatalogueStatus), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border x:Name="AboutSection" Style="{StaticResource MelodayGlassPanelStyle}" Margin="{StaticResource MelodayGutterPadding}"
                    Visibility="{x:Bind ViewModel.HasAbout, Mode=OneWay}">
                <Grid x:Name="AboutGrid" ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PortraitColumn" Width="Auto" />
                        <ColumnDefinition x:Name="BioColumn" Width="*" MaxWidth="760" />
                        <ColumnDefinition Width="0.001*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                        <controls:SectionHeader Title="{x:Bind AboutHeader(ViewModel.Artist.Title), Mode=OneWay}" />
                        <TextBlock x:Name="SummaryText" Text="{x:Bind ViewModel.Artist.Summary, Mode=OneWay}" Style="{StaticResource MelodayParagraphText}"
                                   Foreground="{StaticResource MelodayOnColorBodyBrush}" MaxLines="8" TextTrimming="WordEllipsis" IsTextSelectionEnabled="True"
                                   IsTextTrimmedChanged="OnSummaryTrimmedChanged" helpers:TextOverflow.Reveal="False" />
                        <HyperlinkButton x:Name="SummaryToggle" Style="{StaticResource MelodayMoreLinkStyle}" Content="Read More" Foreground="{StaticResource MelodayOnColorPrimaryBrush}"
                                         Click="OnToggleSummary" Visibility="Collapsed" />
                    </StackPanel>
                    <Grid x:Name="PortraitHost" VerticalAlignment="Top">
                        <controls:ArtworkImage x:Name="Portrait" Width="{StaticResource MelodayArtArtistPortrait}" Height="{StaticResource MelodayArtArtistPortrait}"
                                               DecodeSize="480" PlaceholderIcon="MicVocal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <controls:RingText x:Name="RankRing" Text="{x:Bind ViewModel.RankText, Mode=OneWay}" Diameter="{StaticResource MelodayArtArtistPortrait}"
                                           AutomationProperties.AutomationId="ArtistRank" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState" />
                <VisualState x:Name="MediumState" />
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="LatestPanel.(Grid.Column)" Value="0" />
                        <Setter Target="LatestPanel.(Grid.Row)" Value="1" />
                        <Setter Target="LatestColumn.Width" Value="0" />
                        <Setter Target="PortraitHost.Visibility" Value="Collapsed" />
                        <Setter Target="PortraitColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>

</Page>
