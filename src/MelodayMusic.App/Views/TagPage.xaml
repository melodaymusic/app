<Page
    x:Class="MelodayMusic.Views.TagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:models="using:MelodayMusic.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Padding="{StaticResource MelodayPageHeaderPadding}" Eyebrow="{x:Bind ViewModel.KindLabel, Mode=OneWay}"
                             Title="{x:Bind ViewModel.Tag.Title, Mode=OneWay}" Subtitle="{x:Bind ViewModel.CountText, Mode=OneWay}">
            <controls:ActionWrapPanel Spacing="8">
                <Button Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnShuffle">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                </Button>
                <controls:SortButton Options="{x:Bind ViewModel.SortOptions}" Selected="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
            </controls:ActionWrapPanel>
        </controls:PageHeader>

        <GridView controls:QueueDrag.IsSource="True" Grid.Row="1" Padding="{StaticResource MelodayGridPadding}" ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource MelodayTileItemStyle}" controls:ResponsiveGrid.MinItemWidth="190" IncrementalLoadingThreshold="3">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Album">
                    <controls:CardSlot>
                        <controls:MediaTile Item="{x:Bind}" TileSize="0" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <controls:PageStateView SkeletonKind="Tiles" SkeletonPadding="{StaticResource MelodayGridPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" EmptyText="No albums found." EmptyIcon="Disc3" />
    </Grid>
</Page>
