<Page
    x:Class="MelodayMusic.Views.TagHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:models="using:MelodayMusic.Core.Models"
    xmlns:vm="using:MelodayMusic.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource MelodayPageHeaderPadding}">
            <controls:ActionWrapPanel Spacing="8">
                <Button Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnShuffle">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                </Button>
                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnAllAlbums">
                    <controls:IconLabel Icon="Disc3" Text="All Albums" />
                </Button>
            </controls:ActionWrapPanel>
        </controls:PageHeader>

        <GridView x:Name="Members" Grid.Row="1" Padding="{StaticResource MelodayGridPadding}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource MelodayTileItemStyle}" controls:ResponsiveGrid.MinItemWidth="300"
                  AutomationProperties.AutomationId="TagHubGrid">
            <GridView.Header>
                <StackPanel>
                    <controls:MediaRowControl x:Name="Highlights" CardStyle="EditorialBoard" Visibility="Collapsed" Margin="12,0,0,28"
                                              AutomationProperties.AutomationId="TagHubHighlights" />
                    <controls:MediaRowControl x:Name="Mixes" CardStyle="ColourBoard" Visibility="Collapsed" Margin="12,0,0,28"
                                              Subheader="Made by Meloday from your library" AutomationProperties.AutomationId="TagHubMixes" />
                </StackPanel>
            </GridView.Header>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:TagItem">
                    <controls:CardSlot>
                        <controls:TagCard Item="{x:Bind}" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
