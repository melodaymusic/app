<Page
    x:Class="MelodayMusic.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:models="using:MelodayMusic.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource MelodayPageHeaderPadding}" Title="Downloads">
            <controls:ActionWrapPanel Spacing="8">
                <Button x:Name="ShuffleButton" Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnShuffle" AutomationProperties.AutomationId="ShuffleDownloadsButton">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                </Button>
            </controls:ActionWrapPanel>
        </controls:PageHeader>

        <ListView x:Name="List" Grid.Row="1" Padding="{StaticResource MelodayListPadding}"
                  SelectionMode="Extended" controls:TrackListBehavior.IsEnabled="True"
                  ItemContainerStyle="{StaticResource MelodayTrackItemStyle}"
                  AutomationProperties.Name="Downloads" AutomationProperties.AutomationId="DownloadsList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <controls:TrackRow Track="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:PageStateView x:Name="State" Grid.Row="1" EmptyIcon="CircleArrowDown" EmptyTitle="No Downloads"
                                EmptyText="No downloaded music." />
    </Grid>
</Page>
