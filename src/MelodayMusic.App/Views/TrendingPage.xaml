<Page x:Class="MelodayMusic.Views.TrendingPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:MelodayMusic.Controls" xmlns:models="using:MelodayMusic.Core.Models" Background="Transparent">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <controls:PageHeader x:Name="Header" Padding="{StaticResource MelodayPageHeaderPadding}" Title="Last.fm Top 100 Tracks">
   <controls:ActionWrapPanel Spacing="8">
    <Button x:Name="PlayAllButton" Content="Play All" Click="OnPlay" IsEnabled="False" Style="{StaticResource MelodayPrimaryButtonStyle}"/>
    <controls:PlexSyncButton x:Name="PlexSync" UpdateDescription="the latest Last.fm chart every six hours while Meloday Music is open"/>
   </controls:ActionWrapPanel>
  </controls:PageHeader>
  <controls:DetailHeader x:Name="ChartHeader" IsReadOnly="True" ScrollSource="{x:Bind Tracks}" PlayRequested="OnChartPlay" ShuffleRequested="OnChartShuffle">
   <controls:DetailHeader.ExtraActions>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <controls:PlexSyncButton x:Name="ChartPlexSync" UpdateDescription="the latest Last.fm chart every six hours while Meloday Music is open"/>
     <controls:PageSearch x:Name="ChartSearch" Placeholder="Search this playlist"/>
    </StackPanel>
   </controls:DetailHeader.ExtraActions>
  </controls:DetailHeader>
  <ListView x:Name="Tracks" Grid.Row="1" Padding="{StaticResource MelodayListPadding}" SelectionMode="Extended"
    controls:TrackListBehavior.IsEnabled="True" ContainerContentChanging="OnTrackContainer" ItemContainerStyle="{StaticResource MelodayTrackItemStyle}" AutomationProperties.Name="Last.fm Top 100 Tracks">
   <ListView.ItemTemplate>
    <DataTemplate x:DataType="models:Track">
     <controls:TrackRow Track="{x:Bind}"/>
    </DataTemplate>
   </ListView.ItemTemplate>
  </ListView>
  <GridView x:Name="Artists" Grid.Row="1" Visibility="Collapsed" Padding="{StaticResource MelodayGridPadding}"
    SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnArtistClick" ItemContainerStyle="{StaticResource MelodayTileItemStyle}"
    controls:ResponsiveGrid.MinItemWidth="190" AutomationProperties.Name="Last.fm Trending Artists">
   <GridView.ItemTemplate>
    <DataTemplate x:DataType="models:Artist">
     <controls:CardSlot>
      <controls:MediaTile Item="{x:Bind}" TileSize="0"/>
     </controls:CardSlot>
    </DataTemplate>
   </GridView.ItemTemplate>
  </GridView>
  <controls:PageStateView x:Name="State" Grid.Row="1" SkeletonKind="Tracks" RetryRequested="OnRetry" EmptyText="No chart matches are available in your library."/>
 </Grid>
</Page>
