<Page
    x:Class="MelodayMusic.Views.LyricStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource MelodayPageHeaderPadding}" Eyebrow="Lyric Studio" Title="">
            <controls:ActionWrapPanel Spacing="8">
                <Button x:Name="SaveButton" Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnSave" IsEnabled="False"
                        AutomationProperties.AutomationId="StudioSaveButton">
                    <controls:IconLabel Icon="Check" Text="Save timing" />
                </Button>
                <Button x:Name="OriginalButton" Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnUseOriginal" Visibility="Collapsed"
                        AutomationProperties.AutomationId="StudioOriginalButton">
                    <controls:IconLabel Icon="ListRestart" Text="Use original timing" />
                </Button>
            </controls:ActionWrapPanel>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="{StaticResource MelodayDetailContentPadding}" Spacing="{StaticResource MelodaySectionSpacing}" MaxWidth="980" HorizontalAlignment="Left">

                <Border x:Name="SetupPanel" Style="{StaticResource MelodayGlassPanelStyle}">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Title="The words" />
                        <TextBox x:Name="LyricsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" MaxHeight="300"
                                 PlaceholderText="Paste the lyrics here" AutomationProperties.AutomationId="StudioLyricsBox"
                                 TextChanged="OnLyricsChanged" />
                        <TextBlock x:Name="SourceNote" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="ModeBox" MinWidth="220" SelectedIndex="0" AutomationProperties.Name="Tap for each"
                                      AutomationProperties.AutomationId="StudioModeBox">
                                <ComboBoxItem Content="Tap for each word" />
                                <ComboBoxItem Content="Tap for each line" />
                            </ComboBox>
                            <Button x:Name="StartButton" Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnStart" IsEnabled="False"
                                    AutomationProperties.AutomationId="StudioStartButton">
                                <controls:IconLabel Icon="Play" IsFilled="True" Text="Start timing" />
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"
                                   Text="Press Space as each word or line begins. Hold for a sustained word." />
                    </StackPanel>
                </Border>

                <Border x:Name="TimingPanel" Style="{StaticResource MelodayGlassPanelStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource MelodaySecondaryText}" AutomationProperties.AutomationId="StudioProgress" />

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="NowWord" Style="{StaticResource MelodayHeroText}" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="StudioNowWord" />
                            <ProgressBar x:Name="HoldBar" Minimum="0" Maximum="1" Value="0" Height="8" Opacity="0" HorizontalAlignment="Left" Width="420"
                                         AutomationProperties.AutomationId="StudioHoldBar" />
                            <TextBlock x:Name="NowHint" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="StudioNowHint" />
                        </StackPanel>

                        <StackPanel x:Name="Context" Spacing="8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TapButton" Style="{StaticResource MelodayPrimaryButtonStyle}" MinWidth="220" Click="OnTap"
                                    AutomationProperties.AutomationId="StudioTapButton">
                                <controls:IconLabel Icon="Timer" Text="Tap" />
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnPlayPause" AutomationProperties.AutomationId="StudioPlayButton">
                                <controls:IconLabel x:Name="PlayLabel" Icon="Pause" Text="Pause" />
                            </Button>
                            <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnUndo" AutomationProperties.AutomationId="StudioUndoButton">
                                <controls:IconLabel Icon="ListRestart" Text="Undo" />
                            </Button>
                            <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnBack" AutomationProperties.AutomationId="StudioBackButton">
                                <controls:IconLabel Icon="SkipBack" Text="Back 5 s" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="StudioStatus" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnStartOver" AutomationProperties.AutomationId="StudioStartOverButton">
                                <controls:IconLabel Icon="RefreshCw" Text="Start over" />
                            </Button>
                            <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnEditWords" AutomationProperties.AutomationId="StudioEditWordsButton">
                                <controls:IconLabel Icon="Pencil" Text="Change the words" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
