<UserControl
    x:Class="MelodayMusic.Views.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls">

    <Grid Padding="12,16,12,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Lyrics" Style="{StaticResource MelodaySectionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button x:Name="TimingButton" Style="{StaticResource MelodayIconButtonStyle}" HorizontalAlignment="Right" Click="OnTimingClick"
                    ToolTipService.ToolTip="Lyrics timing" AutomationProperties.Name="Lyrics timing" AutomationProperties.AutomationId="LyricsTimingButton">
                <controls:LucideIcon Icon="Timer" Width="{StaticResource MelodayIconM}" Height="{StaticResource MelodayIconM}" />
            </Button>
        </Grid>

        <Grid x:Name="Viewport" Grid.Row="1" Background="Transparent" SizeChanged="OnViewportSizeChanged">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="Lines" Padding="12,8,12,0" Spacing="22" />
            </ScrollViewer>
        </Grid>

        <controls:PageStateView x:Name="State" Grid.Row="1" EmptyIcon="MessageSquareQuote" EmptyTitle="No Lyrics"
                                EmptyText="Plex doesn't have lyrics for this song." />

        <TextBlock x:Name="Credit" Grid.Row="2" Style="{StaticResource MelodaySecondaryText}" Foreground="{ThemeResource MelodayTextTertiaryBrush}"
                   Margin="12,4,12,12" Visibility="Collapsed" />
    </Grid>
</UserControl>
