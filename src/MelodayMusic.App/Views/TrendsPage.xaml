<Page
    x:Class="MelodayMusic.Views.TrendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:vm="using:MelodayMusic.ViewModels"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource MelodayPageHeaderPadding}" Title="Trends" Subtitle="{x:Bind ViewModel.Summary, Mode=OneWay}" />
        <controls:ChipTabs Grid.Row="1" Margin="40,0,40,16" AutomationLabel="Trends period" ItemsSource="{x:Bind ViewModel.Periods}"
                           SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" AutomationProperties.AutomationId="TrendsPeriods" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="PageScroller">
            <StackPanel Padding="{StaticResource MelodayListPadding}" Spacing="{StaticResource MelodaySectionSpacing}">

                <StackPanel Margin="12,24" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <controls:LucideIcon Icon="ChartColumn" Width="{StaticResource MelodayIconDisplay}" Height="{StaticResource MelodayIconDisplay}"
                                         Foreground="{ThemeResource MelodayTextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No Listening Yet" Style="{StaticResource MelodayHeadlineText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Play some music and your trends appear here." Style="{StaticResource MelodaySecondaryText}" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Margin="12,0" Padding="24" RowSpacing="20" Background="{ThemeResource MelodayGlassFillBrush}" CornerRadius="{StaticResource MelodayRadiusBoard}"
                      Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}" AutomationProperties.AutomationId="TrendsRecap">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasLead, Mode=OneWay}">
                        <controls:ArtworkImage Width="120" Height="120" DecodeSize="240" ArtworkCornerRadius="60" PlaceholderIcon="MicVocal"
                                               SourcePath="{x:Bind ViewModel.LeadArt, Mode=OneWay}" HorizontalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Top artist" Style="{StaticResource MelodaySecondaryText}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.LeadName, Mode=OneWay}" Style="{StaticResource MelodayBodyStrongText}" HorizontalAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.RecapEyebrow, Mode=OneWay}" Style="{StaticResource MelodayOverlineText}" />
                        <TextBlock Text="{x:Bind ViewModel.RecapTime, Mode=OneWay}" Style="{StaticResource MelodayHeroText}" />
                        <TextBlock Text="listened" Style="{StaticResource MelodaySecondaryText}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasChange, Mode=OneWay}">
                            <controls:LucideIcon Icon="{x:Bind ViewModel.ChangeIcon, Mode=OneWay}" Width="{StaticResource MelodayIconXS}" Height="{StaticResource MelodayIconXS}"
                                                 Foreground="{ThemeResource MelodayAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ChangeText, Mode=OneWay}" Style="{StaticResource MelodayBodyText}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                    <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Recap}" AutomationProperties.Name="Recap">
                        <ItemsRepeater.Layout>
                            <controls:RowGridLayout MinItemWidth="130" ColumnSpacing="16" RowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecapStat">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Value}" Style="{StaticResource MelodayTitleText}" />
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>

                <StackPanel Spacing="12" Margin="12,0" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                    <controls:SectionHeader Title="Your Listening Personality" Subtitle="{x:Bind ViewModel.TraitsNote, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Traits}" AutomationProperties.Name="Listening personality">
                        <ItemsRepeater.Layout>
                            <controls:RowGridLayout MinItemWidth="260" ColumnSpacing="16" RowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TraitCard">
                                <Grid Padding="20" ColumnSpacing="16" Background="{ThemeResource MelodayGlassFillBrush}" CornerRadius="{StaticResource MelodayRadiusBoard}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="{StaticResource MelodayButtonXXL}" Height="{StaticResource MelodayButtonXXL}" VerticalAlignment="Top">
                                        <Ellipse Fill="{ThemeResource MelodayAccentBrush}" />
                                        <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconXXL}" Height="{StaticResource MelodayIconXXL}"
                                                             Foreground="{ThemeResource MelodayOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource MelodayHeadlineText}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <controls:MediaRowControl Margin="12,0" Header="Top Artists" Subheader="{x:Bind ViewModel.TopArtistsNote, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TopArtists}"
                                          CardStyle="Tile" IsChart="True" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}" AutomationProperties.AutomationId="TrendsTopArtists" />
                <controls:MediaRowControl Margin="12,0" Header="Top Albums" Subheader="{x:Bind ViewModel.TopAlbumsNote, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TopAlbums}"
                                          CardStyle="Tile" IsChart="True" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}" AutomationProperties.AutomationId="TrendsTopAlbums" />
                <controls:MediaRowControl Margin="12,0" Header="Top Songs" Subheader="{x:Bind ViewModel.TopSongsNote, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.TopSongs}"
                                          CardStyle="Tile" IsChart="True" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}" AutomationProperties.AutomationId="TrendsTopSongs" />

                <Grid Margin="12,0" ColumnSpacing="24" RowSpacing="24" x:Name="WhenGrid" SizeChanged="OnWhenSizeChanged"
                      Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="HourPanel" Spacing="12">
                        <controls:SectionHeader Title="Time of Day" Subtitle="{x:Bind ViewModel.HourNote, Mode=OneWay}" />
                        <controls:BarChart Bars="{x:Bind ViewModel.HourBars, Mode=OneWay}" LabelEvery="6" AutomationProperties.Name="Listening by hour" />
                    </StackPanel>
                    <StackPanel x:Name="DayPanel" Grid.Column="1" Spacing="12">
                        <controls:SectionHeader Title="Day of the Week" Subtitle="{x:Bind ViewModel.DayNote, Mode=OneWay}" />
                        <controls:BarChart Bars="{x:Bind ViewModel.DayBars, Mode=OneWay}" AutomationProperties.Name="Listening by weekday" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="12" Margin="12,0" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                    <controls:SectionHeader Title="{x:Bind ViewModel.TimelineTitle, Mode=OneWay}" />
                    <controls:BarChart Bars="{x:Bind ViewModel.TimelineBars, Mode=OneWay}" LabelEvery="{x:Bind ViewModel.TimelineLabelEvery, Mode=OneWay}"
                                       AutomationProperties.Name="Listening over the period" />
                </StackPanel>

                <StackPanel Spacing="12" Margin="12,0" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
                    <controls:SectionHeader Title="Highlights" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Highlights}" AutomationProperties.Name="Highlights">
                        <ItemsRepeater.Layout>
                            <controls:RowGridLayout MinItemWidth="220" ColumnSpacing="12" RowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HighlightTile">
                                <Grid Padding="16" ColumnSpacing="12" Background="{ThemeResource MelodayGlassFillBrush}" CornerRadius="{StaticResource MelodayRadiusGroup}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}"
                                                         Foreground="{ThemeResource MelodayAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"
                                                         Visibility="{x:Bind IconVisibility}" />
                                    <controls:ArtworkImage Width="56" Height="56" DecodeSize="112" VerticalAlignment="Top" SourcePath="{x:Bind Art}"
                                                           Visibility="{x:Bind ArtVisibility}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource MelodaySecondaryText}" />
                                        <TextBlock Text="{x:Bind Value}" Style="{StaticResource MelodayHeadlineText}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MelodaySecondaryText}" Foreground="{ThemeResource MelodayTextTertiaryBrush}"
                                                   TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <controls:MediaRowControl Margin="12,0" Header="Fresh Finds" Subheader="{x:Bind ViewModel.FreshNote, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.FreshFinds}"
                                          CardStyle="Tile" Visibility="{x:Bind ViewModel.HasDiscovered, Mode=OneWay}" AutomationProperties.AutomationId="TrendsFreshFinds" />

                <StackPanel Spacing="12" Margin="12,0">
                    <controls:SectionHeader Title="Listening Calendar" Subtitle="{x:Bind ViewModel.CalendarNote, Mode=OneWay}" />
                    <controls:ListeningCalendar Days="{x:Bind ViewModel.CalendarDays, Mode=OneWay}" Colour="{x:Bind ViewModel.CalendarColour}" AutomationProperties.Name="Listening calendar" />
                </StackPanel>

                <TextBlock Margin="12,0" Text="{x:Bind ViewModel.Footnote, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
