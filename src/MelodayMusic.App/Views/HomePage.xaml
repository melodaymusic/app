<Page
    x:Class="MelodayMusic.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:helpers="using:MelodayMusic.Helpers"
    xmlns:vm="using:MelodayMusic.ViewModels"
    xmlns:models="using:MelodayMusic.Core.Models"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="PageScroller">
        <StackPanel Padding="{StaticResource MelodayPagePadding}" Spacing="{StaticResource MelodaySectionSpacing}">
            <controls:PageHeader Title="{x:Bind ViewModel.Greeting, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Right" Spacing="2" AutomationProperties.AutomationId="TodaysListening" AutomationProperties.Name="Today's listening">
                    <TextBlock x:Name="ListeningLabel" Text="Today's listening" Style="{StaticResource MelodayOverlineText}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ListeningTime" Text="{x:Bind ViewModel.TodayListening, Mode=OneWay}" Style="{StaticResource MelodayDisplayText}" HorizontalAlignment="Right" />
                </StackPanel>
            </controls:PageHeader>

            <Grid x:Name="Featured" ColumnSpacing="32" RowSpacing="20" helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.ShowFeatured, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TilesColumn" Width="1.15*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="FeaturedArtButton" Style="{StaticResource MelodayTileButtonStyle}" Padding="0" CornerRadius="{StaticResource MelodayRadiusLargeArtwork}"
                        Click="OnFeaturedClick" AutomationProperties.Name="Open">
                    <controls:ArtworkImage x:Name="FeaturedArt" Width="248" Height="248" DecodeSize="320"
                                           ArtworkCornerRadius="{StaticResource MelodayRadiusLargeArtwork}"
                                           SourcePath="{x:Bind ViewModel.FeaturedCover, Mode=OneWay}" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.FeaturedTitle, Mode=OneWay}" Style="{StaticResource MelodayHeroText}" FontSize="{StaticResource MelodayFontFeature}" LineHeight="{StaticResource MelodayLineFeature}"
                               TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton Style="{StaticResource MelodayFeatureSubtitleLinkStyle}" Click="OnFeaturedArtistClick"
                                     Visibility="{x:Bind ViewModel.FeaturedHasArtist, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.FeaturedSubtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                    <TextBlock Text="{x:Bind ViewModel.FeaturedSubtitle, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.FeaturedHasArtist), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.FeaturedMeta, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Style="{StaticResource MelodayPrimaryButtonStyle}" Click="OnFeaturedPlay" AutomationProperties.AutomationId="FeaturedPlayButton" AutomationProperties.Name="Play">
                            <controls:IconLabel Icon="Play" IsFilled="True" Text="Play" />
                        </Button>
                        <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnFeaturedShuffle">
                            <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                        </Button>
                        <controls:PinButton Item="{x:Bind ViewModel.Featured, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl x:Name="JumpTiles" Grid.Column="2" MaxWidth="560" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsTabStop="False"
                              ItemsSource="{x:Bind ViewModel.JumpBackIn}" AutomationProperties.Name="Played before">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:UniformColumns Columns="2" ColumnSpacing="8" RowSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <Button Style="{StaticResource MelodayTileButtonStyle}" Padding="0" Background="{ThemeResource MelodayGlassFillBrush}"
                                    CornerRadius="{StaticResource MelodayRadiusControl}" Click="OnJumpTileClick" Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Subtitle}">
                                <Grid ColumnSpacing="12" Height="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ArtworkImage Width="56" Height="56" DecodeSize="112" ShowOutline="False" ArtworkCornerRadius="8,0,0,8"
                                                           PlaceholderIcon="{x:Bind helpers:Format.PlaceholderIcon((models:MediaItem))}"
                                                           SourcePath="{x:Bind helpers:Format.NavThumb((models:MediaItem))}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource MelodayBodyStrongText}" VerticalAlignment="Center"
                                               TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <controls:PageStateView SkeletonKind="Rows" IsLoading="{x:Bind ViewModel.ShowSkeleton, Mode=OneWay}"
                                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                    EmptyText="No music in this library."
                                    RetryCommand="{x:Bind ViewModel.LoadCommand}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource MelodaySectionSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaRow">
                        <controls:MediaRowControl Header="{x:Bind Title}" Subheader="{x:Bind Subtitle}" ItemsSource="{x:Bind Items}" SeeAllCommand="{x:Bind SeeAllCommand}" PlayAllCommand="{x:Bind PlayAllCommand}"
                                                  CardStyle="{x:Bind CardStyle}" CanReorder="{x:Bind CanReorder}" ItemsReordered="OnRowReordered" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
