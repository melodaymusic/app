<Page
    x:Class="MelodayMusic.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:models="using:MelodayMusic.Core.Models"
    xmlns:helpers="using:MelodayMusic.Helpers"
    xmlns:services="using:MelodayMusic.Services"
    xmlns:vm="using:MelodayMusic.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="AnalysisRowStyle" TargetType="StackPanel">
            <Setter Property="Background" Value="{ThemeResource MelodayGlassFillBrush}" />
            <Setter Property="Padding" Value="{StaticResource MelodaySettingsRowPadding}" />
            <Setter Property="MinHeight" Value="{StaticResource MelodaySettingsRowHeight}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="SettingsLayoutRoot" Padding="{StaticResource MelodaySettingsPagePadding}" ColumnSpacing="24" SizeChanged="OnSettingsSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <controls:PageHeader Title="Settings" Grid.ColumnSpan="2" />
        <ComboBox x:Name="CompactSectionNav" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,24,0,0"
                  HorizontalAlignment="Stretch" SelectionChanged="OnCompactSectionChanged" AutomationProperties.Name="Settings section">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="controls:ChipTab"><TextBlock Text="{x:Bind Label}" Style="{StaticResource MelodayBodyText}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ListView x:Name="SectionNav" Grid.Row="2" Margin="0,24,0,0" SelectionMode="Single" IsItemClickEnabled="False"
                  ItemContainerStyle="{StaticResource MelodaySettingsNavItemStyle}"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Settings sections" AutomationProperties.AutomationId="SettingsSections">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:ChipTab">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <controls:LucideIcon Icon="{x:Bind Icon}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource MelodayBodyText}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ScrollViewer x:Name="SettingsScroller" Grid.Row="2" Grid.Column="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="PageScroller">
            <StackPanel Spacing="{StaticResource MelodaySpaceGroup}" MaxWidth="1040" HorizontalAlignment="Stretch" Padding="0,0,8,8" Background="Transparent">
<StackPanel x:Name="BackgroundGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Windows" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Music" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Close to tray" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Keep music playing when you close the window. Open Meloday or quit from its icon near the clock." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Close to tray" AutomationProperties.AutomationId="CloseToTrayToggle" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Power" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Open Meloday when you sign in. Your saved queue is restored without starting playback." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Start with Windows" AutomationProperties.AutomationId="StartWithWindowsToggle" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="LogOut" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Quit Meloday" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Stop playback, save your queue and fully close the app." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Quit" Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnQuit" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="GeneralGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Notifications" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Bell" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Song notifications" Style="{StaticResource MelodayBodyText}" />

                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.TrackNotifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Song notifications" AutomationProperties.AutomationId="TrackNotificationsToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="YourListeningGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Your Listening" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ChartColumn" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show trends" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Your top artists, albums and songs, when you listen and your listening personality, in the sidebar." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShowTrends, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Show trends" AutomationProperties.AutomationId="ShowTrendsToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="StorageGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Storage" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ImageOff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Artwork cache" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Clear Cache" Command="{x:Bind ViewModel.ClearCacheCommand}" VerticalAlignment="Center" />
                        </Grid>
<Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="CircleArrowDown" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Downloads" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.DownloadsText, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Remove All" Command="{x:Bind ViewModel.RemoveDownloadsCommand}" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RemoveDownloadsButton" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="AppearanceGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Appearance" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Wind" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Motion" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.MotionNote, Mode=OneWay}" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.MotionNote), Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MotionEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Motion" AutomationProperties.AutomationId="MotionToggle" />
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="ArtistGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Artist Pages" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">

                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Signature" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show artist logos" Style="{StaticResource MelodayBodyText}" />

                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShowArtistLogos, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Show artist logos" AutomationProperties.AutomationId="ArtistLogosToggle" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Palette" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Logo colours" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Original artwork or colours matched to the artist page."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.LogoColourOptions}"
                                      SelectedIndex="{x:Bind ViewModel.LogoColoursIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ShowArtistLogos, Mode=OneWay}"
                                      AutomationProperties.Name="Logo colours" AutomationProperties.AutomationId="LogoColoursBox" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="FolderOpen" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Your own logos" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Import images named after their artists."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.LogoImportStatus, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" Margin="0,4,0,0"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.LogoImportStatus), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsImportingLogos, Mode=OneWay}" Width="18" Height="18" />
                                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Import Logos…" Click="OnImportLogos"
                                        IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsImportingLogos), Mode=OneWay}"
                                        AutomationProperties.Name="Import logos" AutomationProperties.AutomationId="ImportLogos" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="TrendingUp" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Artist rankings" Style="{StaticResource MelodayBodyText}" />

                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox MinWidth="160" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.ArtistRankOptions}"
                                          SelectedIndex="{x:Bind ViewModel.ArtistRankModeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Artist rankings" AutomationProperties.AutomationId="ArtistRankMode" />
                                <NumberBox Width="120" VerticalAlignment="Center" Minimum="1" Maximum="100000" SmallChange="10" LargeChange="100"
                                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.ArtistRankTop, Mode=TwoWay}"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.IsArtistRankTop, Mode=OneWay}"
                                           AutomationProperties.Name="How many artists are ranked" AutomationProperties.AutomationId="ArtistRankTop" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="HomeGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Home" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Sparkles" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Jump back in" Style="{StaticResource MelodayBodyText}" />

                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Layout.ShowJumpBackIn, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Show Jump back in" AutomationProperties.AutomationId="JumpBackInToggle" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="LayoutList" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Sections" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Drag or use the arrows to reorder; switch a section off to hide it. Sections marked with the Meloday wave are curated by Meloday." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Reset" Click="OnResetHome" VerticalAlignment="Center"
                                    AutomationProperties.Name="Reset Home sections" />

                            <ListView x:Name="SectionsList" Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{x:Bind Layout.Sections}"
                                      SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                      DragItemsStarting="OnSectionsDragStarting" DragItemsCompleted="OnSectionsReordered" ScrollViewer.VerticalScrollMode="Disabled"
                                      AutomationProperties.Name="Home sections" AutomationProperties.AutomationId="HomeSections">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="MinHeight" Value="{StaticResource MelodayNavItemHeight}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:HomeSection">
                                        <Grid ColumnSpacing="12" helpers:SettingsLayout.Adaptive="True" Padding="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:LucideIcon Icon="GripVertical" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}"
                                                                 Foreground="{ThemeResource MelodayTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center" Opacity="{x:Bind helpers:Format.DimIfOff(IsShown), Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:MelodayMark Width="22" Height="10"
                                                                      Foreground="{ThemeResource MelodayTextPrimaryBrush}" VerticalAlignment="Center"
                                                                      Visibility="{x:Bind CuratedVisibility}" ToolTipService.ToolTip="Curated by Meloday" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource MelodayBodyText}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonXS}" Height="{StaticResource MelodayButtonXS}"
                                                    Click="OnMoveUp" Tag="{x:Bind}" ToolTipService.ToolTip="Move up" AutomationProperties.Name="{x:Bind MoveUpLabel}">
                                                <controls:LucideIcon Icon="ChevronUp" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}" />
                                            </Button>
                                            <Button Style="{StaticResource MelodayIconButtonStyle}" Width="{StaticResource MelodayButtonXS}" Height="{StaticResource MelodayButtonXS}"
                                                    Click="OnMoveDown" Tag="{x:Bind}" ToolTipService.ToolTip="Move down" AutomationProperties.Name="{x:Bind MoveDownLabel}">
                                                <controls:LucideIcon Icon="ChevronDown" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}" />
                                            </Button>
                                            <ToggleSwitch IsOn="{x:Bind IsShown, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                          AutomationProperties.Name="{x:Bind ShowLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="AccountGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Plex Account" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="User" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.AccountDetail, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Switch Profile" Command="{x:Bind ViewModel.SwitchProfileCommand}" />
                                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Sign Out" Command="{x:Bind ViewModel.SignOutCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="LibraryGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Server and Library" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Server" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Plex Media Server" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.ServerVersion, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Servers}"
                                      SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}" AutomationProperties.Name="Plex server">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlexServer">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Globe" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Connection" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Reconnect" Command="{x:Bind ViewModel.ReconnectCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Lock" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Allow insecure connections" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.InsecureConnectionNote, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.InsecureConnectionOptions}"
                                      SelectedIndex="{x:Bind ViewModel.InsecureConnectionIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Allow insecure connections" AutomationProperties.AutomationId="InsecureConnectionsPolicy" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Library" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Music library" Style="{StaticResource MelodayBodyText}" />

                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Sections}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}" AutomationProperties.Name="Music library">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:MusicSection">
                                        <TextBlock Text="{x:Bind Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="RefreshCw" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Library refresh" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.LibraryCacheText, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
