                                        AutomationProperties.Name="Remove OpenAI key" AutomationProperties.AutomationId="RemoveOpenAiKey" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
                                <controls:ActionWrapPanel Spacing="12" helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.NeedsAiKey, Mode=OneWay}">
                                    <PasswordBox x:Name="OpenAiKeyBox" Width="260" PlaceholderText="Paste your API key" PasswordRevealMode="Peek"
                                                 AutomationProperties.Name="OpenAI API key" AutomationProperties.AutomationId="OpenAiKeyBox" KeyDown="OnOpenAiKeyDown" />
                                    <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Save" Click="OnSaveOpenAiKey"
                                            IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsCheckingAiKey), Mode=OneWay}"
                                            AutomationProperties.AutomationId="SaveOpenAiKey" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingAiKey, Mode=OneWay}" Width="18" Height="18" />
                                </controls:ActionWrapPanel>
                                <TextBlock Text="{x:Bind ViewModel.AiKeyStatus, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.AiKeyStatus), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}" Visibility="{x:Bind ViewModel.MelodayAiTitles, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="X" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Words titles never use" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Separate words with commas." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Width="260" VerticalAlignment="Center" Text="{x:Bind ViewModel.MelodayAvoidWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnAvoidWordsDone" KeyDown="OnAvoidWordsKeyDown"
                                     AutomationProperties.Name="Words titles never use" AutomationProperties.AutomationId="MelodayAvoidWords" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Tags" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Genres to skip" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Separate genres with commas."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Width="260" VerticalAlignment="Center" Text="{x:Bind ViewModel.MelodaySkipGenres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnSkipGenresDone" KeyDown="OnSkipGenresKeyDown"
                                     AutomationProperties.Name="Genres Meloday skips" AutomationProperties.AutomationId="MelodaySkipGenres" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ListMusic" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Keep it as a playlist on Plex" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Replaces the same Plex playlist whenever your Meloday updates."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MelodayPlexPlaylist, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Keep Meloday as a playlist on Plex" AutomationProperties.AutomationId="MelodayPlexToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="LiveRadioGroup" Style="{StaticResource MelodayGroupStyle}"><TextBlock Text="Live radio" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                 <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                  <Grid Style="{StaticResource MelodayGroupRowStyle}">
                   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                   <StackPanel Spacing="4">
                    <TextBlock Text="Canadian Broadcast" Style="{StaticResource MelodayBodyText}"/>
                    <TextBlock Text="Aim for 4–5 suitable Canadian songs per hour. Station fit and cooldowns come first." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"/>
                   </StackPanel>
                   <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CanadianBroadcast, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Canadian Broadcast"/>
                  </Grid>
                 </StackPanel>
                </Border>
                <Border Style="{StaticResource MelodayGroupListStyle}"><StackPanel Style="{StaticResource MelodayGroupRowsStyle}"><Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ThumbsDown" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Station feedback" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.FeedbackSummary, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Reset" Command="{x:Bind ViewModel.ResetFeedbackCommand}" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ResetFeedbackButton" />
                        </Grid></StackPanel></Border></StackPanel>

<StackPanel x:Name="DupesGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Duplicate songs" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Merge" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Preferred versions" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="{x:Bind ViewModel.DupesSummary, Mode=OneWay}" AutomationProperties.AutomationId="DupesSummary" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Dupes}" AutomationProperties.AutomationId="DupeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DupeRow">
                                    <Grid Style="{StaticResource MelodayGroupRowStyle}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                            <controls:ArtworkImage Width="48" Height="48" DecodeSize="96" SourcePath="{x:Bind KeeperThumb}"
                                                                   ArtworkCornerRadius="{StaticResource MelodayRadiusThumb}" PlaceholderIcon="Music" Canvas.ZIndex="1" />
                                            <controls:ArtworkImage Width="48" Height="48" DecodeSize="96" SourcePath="{x:Bind DupeThumb}" Opacity="0.55"
                                                                   ArtworkCornerRadius="{StaticResource MelodayRadiusThumb}" PlaceholderIcon="Music" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource MelodayBodyStrongText}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind KeeperTitle}" /><Run Text=" plays" Foreground="{StaticResource MelodayTextSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind KeeperDetails}" Style="{StaticResource MelodaySecondaryText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MelodaySecondaryText}" TextTrimming="CharacterEllipsis">
                                                <Run Text="in place of " /><Run Text="{x:Bind DupeTitle}" /><Run Text=" · " /><Run Text="{x:Bind DupeDetails}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Unmerge" VerticalAlignment="Center"
                                                Click="OnUnmerge"
                                                AutomationProperties.Name="{x:Bind Unmerge}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="MutingGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Muted music" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="BellOff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="How long to mute" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="Applies to recommendations and radio. Manually selected music still plays."
                                           AutomationProperties.AutomationId="MuteLengthNote" />
                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="{x:Bind ViewModel.MuteLengthSummary, Mode=OneWay}" AutomationProperties.AutomationId="MuteLengthSummary" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox MinWidth="160" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.MuteLengthOptions}"
                                          SelectedIndex="{x:Bind ViewModel.MuteLengthIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="How long to mute" AutomationProperties.AutomationId="MuteLength" />
                                <NumberBox Width="120" VerticalAlignment="Center" Minimum="1" Maximum="365" SmallChange="1" LargeChange="7"
                                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MuteCustomDays, Mode=TwoWay}"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.IsCustomMute, Mode=OneWay}"
                                           AutomationProperties.Name="Days to mute" AutomationProperties.AutomationId="MuteCustomDays" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Muted now" Style="{StaticResource MelodayGroupHeaderText}" Margin="0,16,0,0" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="BellOff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="{x:Bind ViewModel.MutedSummary, Mode=OneWay}" AutomationProperties.AutomationId="MutedSummary" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Muted}" AutomationProperties.AutomationId="MutedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MuteRow">
                                    <Grid Style="{StaticResource MelodayGroupRowStyle}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:LucideIcon Icon="{x:Bind Icon}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource MelodayBodyStrongText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource MelodaySecondaryText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Remaining}" Style="{StaticResource MelodaySecondaryText}" Foreground="{ThemeResource MelodayTextTertiaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Unmute" VerticalAlignment="Center"
                                                Click="OnUnmute" AutomationProperties.Name="{x:Bind Unmute}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="AnalysisGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="Meloday Engine" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Sparkles" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Let the Meloday Engine learn your library" Style="{StaticResource MelodayBodyText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.LearnLibraryNote, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.LearnLibrary, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Let the Meloday Engine learn your library" AutomationProperties.AutomationId="LearnLibraryToggle" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Gauge" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Pace" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.AnalysisPaceNote, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.AnalysisPaceOptions}" SelectedIndex="{x:Bind ViewModel.AnalysisPaceIndex, Mode=TwoWay}" MinWidth="180" VerticalAlignment="Center" AutomationProperties.Name="Analysis pace" />
                        </Grid>
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="10">
                            <TextBlock Text="Songs learned" Style="{StaticResource MelodayBodyText}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.EnginePercent, Mode=OneWay}" AutomationProperties.Name="Songs the Meloday Engine has learned" />
                            <TextBlock Text="{x:Bind ViewModel.EngineCoverage, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="It listens to three short samples of each song, entirely on this PC. Learning a big library takes a while the first time; after that only new songs are learned." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Transition analysis" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.AnalysisProgress, Mode=OneWay}" Style="{StaticResource MelodayBodyText}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.AnalysisPercent, Mode=OneWay}" AutomationProperties.Name="Tracks fully analysed" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisCoverage, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisStatus, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="4">
                            <TextBlock Text="When it runs" Style="{StaticResource MelodayBodyText}" />
                            <TextBlock Text="While Meloday is open, including in the tray. Pauses during buffering, energy saver and metered connections. With learning turned off, only songs you play are checked." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="Progress is saved automatically. Opening and ending samples complete transition analysis." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="What Meloday has learned" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="4">
                            <TextBlock Text="Tempo" Style="{StaticResource MelodayBodyText}" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisTempo, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="4">
                            <TextBlock Text="Musical key" Style="{StaticResource MelodayBodyText}" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisKeys, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="4">
                            <TextBlock Text="Rhythm and energy" Style="{StaticResource MelodayBodyText}" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisRhythm, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="Sample-based estimates. Energy measures changes within a song." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Moods in Plex" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <StackPanel Style="{StaticResource AnalysisRowStyle}" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tag moods from the Meloday Engine" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Adds the moods ME hears clearly to your songs in Plex, so Plexamp and other Plex apps can use them. Existing moods are kept, and the field is locked so Plex doesn't overwrite them. Meloday records what it adds, so you can remove it all later. Nothing is written until you ask. To try a few albums first, right-click an album and choose Tag Moods in Plex." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.MoodTagStatus, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <controls:ActionWrapPanel Spacing="8">
                                <Button Content="Tag Whole Library…" Style="{StaticResource MelodaySecondaryButtonStyle}" Command="{x:Bind ViewModel.TagLibraryMoodsCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanTagMoods, Mode=OneWay}" AutomationProperties.AutomationId="TagLibraryMoods" />
                                <Button Content="Remove All Meloday Moods…" Style="{StaticResource MelodaySecondaryButtonStyle}" Command="{x:Bind ViewModel.UndoLibraryMoodsCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanUndoMoods, Mode=OneWay}" AutomationProperties.AutomationId="UndoLibraryMoods" />
                                <Button Content="Stop" Style="{StaticResource MelodaySecondaryButtonStyle}" Command="{x:Bind ViewModel.StopMoodTaggingCommand}"
                                        Visibility="{x:Bind ViewModel.IsMoodTagging, Mode=OneWay}" />
                            </controls:ActionWrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

<StackPanel x:Name="AboutGroup" Style="{StaticResource MelodayGroupStyle}">
                <TextBlock Text="About" Style="{StaticResource MelodayGroupHeaderText}" />
                <Border Style="{StaticResource MelodayGroupListStyle}">
                    <StackPanel Style="{StaticResource MelodayGroupRowsStyle}">
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="24" Height="24" VerticalAlignment="Center">
                                <Image.Source>
                                    <BitmapImage UriSource="ms-appx:///Assets/MelodayMusic-app.png" DecodePixelWidth="24" DecodePixelType="Logical" />
                                </Image.Source>
                            </Image>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Meloday Music" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource MelodaySecondaryText}" />
                                <TextBlock Text="Meloday Music was built using AI tools."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Genre Essentials covers: based on Apple Music's genre artwork, redesigned in the Meloday palette."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Typeface: Nunito by Vernon Adams, under the SIL Open Font License 1.1." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Icons: Lucide, Copyright Lucide Icons and Contributors, under the" />
                                    <Hyperlink NavigateUri="https://lucide.dev/license">ISC License</Hyperlink><Run Text="." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Cover shapes: Shape Icons by" />
                                    <Hyperlink NavigateUri="https://www.svgbackgrounds.com">SVGBackgrounds.com</Hyperlink><Run Text=" and Shape Icons by" />
                                    <Hyperlink NavigateUri="https://shapes.gallery">shapes.gallery</Hyperlink><Run Text="." />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Open Log Folder" Command="{x:Bind ViewModel.OpenLogsCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Sparkles" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Support Meloday" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Meloday Music is made by one person and is free. If it's become part of your day, you can help keep it going with a coffee."
                                           Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Ko-fi" Click="OnSupport" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="ko-fi.com/dvdbsh" AutomationProperties.Name="Support Meloday on Ko-fi" />
                        </Grid>
                        <Grid Style="{StaticResource MelodayGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Lock" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Privacy and diagnostics" Style="{StaticResource MelodayBodyText}" />
                                <TextBlock Text="Credentials are encrypted with your Windows account. Local caches, queue and radio history contain music metadata and are not encrypted." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Diagnostics stay on this PC, hide credentials and listening names, and expire after seven days. Review logs before sharing them; errors can still include server addresses or file paths." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="Plex receives library and playback requests. Optional Last.fm scrobbling, LRCLIB lyrics, fanart.tv logos and OpenAI titles send the data described beside their settings. Public Last.fm charts use its website, which may load cookies and third-party resources." Style="{StaticResource MelodaySecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MelodaySecondaryButtonStyle}" Content="Clear Logs" Command="{x:Bind ViewModel.ClearLogsCommand}" VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="ClearLogsButton" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
