<UserControl
    x:Class="MelodayMusic.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:views="using:MelodayMusic.Views"
    xmlns:local="using:MelodayMusic.Views"
    xmlns:helpers="using:MelodayMusic.Helpers"
    xmlns:models="using:MelodayMusic.Core.Models">

    <UserControl.Resources>
        <DataTemplate x:Key="WideNavTemplate" x:DataType="local:NavItem">
            <Grid ColumnSpacing="12" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Visibility="{x:Bind helpers:Format.CollapsedIf(HasPicture), Mode=OneWay}">
                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" VerticalAlignment="Center"
                                         Foreground="{ThemeResource MelodayTextPrimaryBrush}"
                                         Visibility="{x:Bind helpers:Format.CollapsedIf(IsSelected), Mode=OneWay}" />
                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" VerticalAlignment="Center" Foreground="{ThemeResource MelodayAccentBrush}"
                                         Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                </Grid>
                <PersonPicture Width="26" Height="26" Margin="-3,0" VerticalAlignment="Center" ProfilePicture="{x:Bind Picture, Mode=OneWay}"
                               DisplayName="{x:Bind PictureName}" Visibility="{x:Bind HasPicture, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource MelodayBodyText}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactNavTemplate" x:DataType="local:NavItem">
            <Grid Height="40" HorizontalAlignment="Center" ToolTipService.ToolTip="{x:Bind Label}">
                <Grid Visibility="{x:Bind helpers:Format.CollapsedIf(HasPicture), Mode=OneWay}">
                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" VerticalAlignment="Center"
                                         Foreground="{ThemeResource MelodayTextPrimaryBrush}"
                                         Visibility="{x:Bind helpers:Format.CollapsedIf(IsSelected), Mode=OneWay}" />
                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" VerticalAlignment="Center" Foreground="{ThemeResource MelodayAccentBrush}"
                                         Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                </Grid>
                <PersonPicture Width="26" Height="26" VerticalAlignment="Center" ProfilePicture="{x:Bind Picture, Mode=OneWay}"
                               DisplayName="{x:Bind PictureName}" Visibility="{x:Bind HasPicture, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactPinnedTemplate" x:DataType="models:MediaItem">
            <Grid Height="40" HorizontalAlignment="Center" ToolTipService.ToolTip="{x:Bind Title}">
                <controls:ArtworkImage Width="{StaticResource MelodayArtNav}" Height="{StaticResource MelodayArtNav}" DecodeSize="48"
                                       ArtworkCornerRadius="{x:Bind helpers:Format.NavArtRadius((models:MediaItem))}"
                                       PlaceholderIcon="{x:Bind helpers:Format.PlaceholderIcon((models:MediaItem))}"
                                       SourcePath="{x:Bind helpers:Format.NavThumb((models:MediaItem))}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PinnedNavTemplate" x:DataType="models:MediaItem">
            <Grid ColumnSpacing="12" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ArtworkImage Width="{StaticResource MelodayArtNav}" Height="{StaticResource MelodayArtNav}" DecodeSize="48"
                                       ArtworkCornerRadius="{x:Bind helpers:Format.NavArtRadius((models:MediaItem))}"
                                       PlaceholderIcon="{x:Bind helpers:Format.PlaceholderIcon((models:MediaItem))}"
                                       SourcePath="{x:Bind helpers:Format.NavThumb((models:MediaItem))}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource MelodayBodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="RailGlass" Canvas.ZIndex="1" Margin="16,50,8,16" Background="{ThemeResource MelodayPlayerAcrylicBrush}"
                BorderBrush="{ThemeResource MelodayGlassRimBrush}" BorderThickness="1" CornerRadius="{StaticResource MelodayRadiusGlass}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" IsTabStop="False" SizeChanged="OnRailScrollSizeChanged">
        <Grid x:Name="Rail" Padding="8,12,8,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="LibraryHeader" Padding="12,4,0,14" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Shell.LibraryTitle, Mode=OneWay}" Style="{StaticResource MelodayBodyStrongText}" />
                <TextBlock Text="{x:Bind Shell.ServerName, Mode=OneWay}" Style="{StaticResource MelodaySecondaryText}" />
            </StackPanel>
            <ListView x:Name="NavList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavClick"
                      ItemContainerStyle="{StaticResource MelodayNavItemStyle}" ItemTemplate="{StaticResource WideNavTemplate}"
                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Navigation" TabIndex="1">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
            <Button x:Name="LibrarySectionHeader" Grid.Row="2" Style="{StaticResource MelodayButtonBase}" Background="Transparent"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0,10,0" Margin="0,12,0,2" Height="28"
                    CornerRadius="{StaticResource MelodayRadiusControl}" Click="OnLibraryHeaderClick"
                    AutomationProperties.Name="Library" AutomationProperties.AutomationId="LibraryHeader">
                <Grid x:Name="LibraryHeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LibraryLabel" Text="Library" Style="{StaticResource MelodayOverlineText}" VerticalAlignment="Center" />
                    <controls:LucideIcon Grid.Column="1" Icon="ChevronDown" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}"
                                         Foreground="{ThemeResource MelodayTextSecondaryBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <controls:LucideIcon.RenderTransform>
                            <RotateTransform x:Name="LibraryChevronRotation" />
                        </controls:LucideIcon.RenderTransform>
                    </controls:LucideIcon>
                </Grid>
            </Button>
            <ListView x:Name="LibraryList" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavClick"
                      ItemContainerStyle="{StaticResource MelodayNavItemStyle}" ItemTemplate="{StaticResource WideNavTemplate}"
                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Library">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
            <Button x:Name="PinnedHeader" Grid.Row="4" Style="{StaticResource MelodayButtonBase}" Background="Transparent"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0,10,0" Margin="0,8,0,1"
                    Height="{StaticResource MelodayNavItemHeight}" CornerRadius="{StaticResource MelodayRadiusControl}"
                    Foreground="{ThemeResource MelodayTextPrimaryBrush}" FontWeight="Medium" Click="OnPinnedHeaderClick"
                    Visibility="{x:Bind Home.HasPinned, Mode=OneWay}"
                    AutomationProperties.Name="Pinned" AutomationProperties.AutomationId="PinnedHeader">
                <Grid x:Name="PinnedHeaderGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:LucideIcon Icon="Pin" Width="{StaticResource MelodayIconL}" Height="{StaticResource MelodayIconL}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PinnedLabel" Grid.Column="1" Text="Pinned" Style="{StaticResource MelodayBodyText}" VerticalAlignment="Center" />
                    <controls:LucideIcon x:Name="PinnedChevron" Grid.Column="2" Icon="ChevronDown" Width="{StaticResource MelodayIconS}" Height="{StaticResource MelodayIconS}"
                                         Foreground="{ThemeResource MelodayTextSecondaryBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <controls:LucideIcon.RenderTransform>
                            <RotateTransform x:Name="PinnedChevronRotation" />
                        </controls:LucideIcon.RenderTransform>
                    </controls:LucideIcon>
                </Grid>
            </Button>
            <ListView x:Name="PinnedList" Grid.Row="5" helpers:Anim.Appear="True" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPinnedNavClick"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="OnPinnedReordered" ContextRequested="OnPinnedContextRequested"
                      ItemsSource="{x:Bind Home.Pinned}" ItemContainerStyle="{StaticResource MelodayNavItemStyle}"
                      ItemTemplate="{StaticResource PinnedNavTemplate}" AutomationProperties.Name="Pinned items">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
        </Grid>
        </ScrollViewer>
            <ListView x:Name="FooterList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavClick" Margin="8,8,8,10"
                      ItemContainerStyle="{StaticResource MelodayNavItemStyle}" ItemTemplate="{StaticResource WideNavTemplate}"
                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Settings navigation">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
        </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Column="1">
            <Grid x:Name="ContentSurface" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TopBar" Height="{StaticResource MelodayTopBarHeight}" VerticalAlignment="Top" Margin="{StaticResource MelodayTitleBarInset}"
                      Padding="28,6,28,0" ColumnSpacing="12" Canvas.ZIndex="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource MelodayIconButtonStyle}" Click="OnBackClick" IsEnabled="False" VerticalAlignment="Top"
                            Width="{StaticResource MelodayControlHeight}" Height="{StaticResource MelodayControlHeight}"
                            Background="{ThemeResource MelodayGlassBrush}" BorderBrush="{ThemeResource MelodayGlassEdgeBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                        <controls:LucideIcon Icon="ArrowLeft" />
                    </Button>
                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource MelodayIconButtonStyle}" Click="OnSearchButtonClick" VerticalAlignment="Top"
                            Width="{StaticResource MelodayControlHeight}" Height="{StaticResource MelodayControlHeight}"
                            Background="{ThemeResource MelodayGlassBrush}" BorderBrush="{ThemeResource MelodayGlassEdgeBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search" AutomationProperties.AutomationId="SearchButton">
                        <controls:LucideIcon Icon="Search" />
                    </Button>
                    <AutoSuggestBox x:Name="SearchBox" helpers:EditorChrome.Neutral="True" FontFamily="{StaticResource MelodayFont}" FontSize="{StaticResource MelodayFontBody}" FontWeight="Medium" Grid.Column="1" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0" CornerRadius="{StaticResource MelodayRadiusPill}"
                                    Width="{StaticResource MelodayControlHeight}" LostFocus="OnSearchLostFocus"
                                    PlaceholderText="Search your library" VerticalAlignment="Top"
                                    QueryIcon="Find" TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted"
                                    ToolTipService.ToolTip="Search (Ctrl+F)"
                                    AutomationProperties.Name="Search" AutomationProperties.AutomationId="SearchBox">
                        <AutoSuggestBox.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Dark">
                                        <AcrylicBrush x:Key="TextControlBackground" TintColor="#16161B" TintOpacity="0.38" TintLuminosityOpacity="0.5" FallbackColor="#1C1B21" />
                                        <AcrylicBrush x:Key="TextControlBackgroundPointerOver" TintColor="#16161B" TintOpacity="0.3" TintLuminosityOpacity="0.45" FallbackColor="#22212A" />
                                        <AcrylicBrush x:Key="TextControlBackgroundFocused" TintColor="#16161B" TintOpacity="0.5" TintLuminosityOpacity="0.6" FallbackColor="#1C1B21" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#F4F2EE" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#B3AFA8" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#C9C5BE" />
                                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="#B3AFA8" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="MelodayTextPrimaryBrush" />
                                <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                <StaticResource x:Key="ControlCornerRadius" ResourceKey="MelodayRadiusPill" />
                                <StaticResource x:Key="TextControlThemeMinHeight" ResourceKey="MelodayControlHeight" />
                                <StaticResource x:Key="OverlayCornerRadius" ResourceKey="MelodayRadiusBoard" />
                                <StaticResource x:Key="TextControlThemePadding" ResourceKey="MelodaySearchFieldPadding" />
                            </ResourceDictionary>
                        </AutoSuggestBox.Resources>
                    </AutoSuggestBox>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.RowSpan="2" IsTabStop="False" CacheSize="12" />

                <views:PlayerBar x:Name="PlayerBar" Grid.Row="1" Canvas.ZIndex="2" VerticalAlignment="Bottom" Margin="32,0,32,16" />

                <InfoBar Grid.Row="1" Canvas.ZIndex="3" Margin="32,0,32,118" MaxWidth="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         IsOpen="{x:Bind Notifications.IsOpen, Mode=TwoWay}"
                         Title="{x:Bind Notifications.Title, Mode=OneWay}"
                         Message="{x:Bind Notifications.Message, Mode=OneWay}"
                         Severity="{x:Bind Notifications.Severity, Mode=OneWay}"
                         Background="{ThemeResource MelodayGlassBrush}" CornerRadius="{StaticResource MelodayRadiusControl}" />
            </Grid>

            <Border x:Name="QueueGlass" Width="344" HorizontalAlignment="Right" Margin="8,50,16,16" Visibility="Collapsed" Canvas.ZIndex="4"
                    Background="{ThemeResource MelodayGlassBrush}" BorderBrush="{ThemeResource MelodayGlassEdgeBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource MelodayRadiusGlass}">
                <Grid>
                    <views:QueuePanel x:Name="QueuePanel" />
                    <views:LyricsPanel x:Name="LyricsPanel" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <views:VisualizerStage x:Name="Stage" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="50" />

    </Grid>
</UserControl>
