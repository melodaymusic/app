<Page
    x:Class="MelodayMusic.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MelodayMusic.Controls"
    xmlns:vm="using:MelodayMusic.ViewModels"
    xmlns:models="using:MelodayMusic.Core.Models"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Padding="{StaticResource MelodayPageHeaderPadding}" Title="Playlists" Subtitle="{x:Bind ViewModel.CountText, Mode=OneWay}">
            <controls:ActionWrapPanel Spacing="8">
                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnNewPlaylist" AutomationProperties.AutomationId="NewPlaylistButton">
                    <controls:IconLabel Icon="Plus" Text="New Playlist" />
                </Button>
                <Button Style="{StaticResource MelodaySecondaryButtonStyle}" Click="OnNewSmartPlaylist" AutomationProperties.AutomationId="NewSmartPlaylistButton">
                    <controls:IconLabel Icon="Sparkles" Text="New Smart Playlist" />
                </Button>
                <controls:LayoutToggle x:Name="Layout" PageKey="playlists" />
                <controls:SortButton Options="{x:Bind ViewModel.SortOptions}" Selected="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
            </controls:ActionWrapPanel>
        </controls:PageHeader>

        <GridView controls:QueueDrag.IsSource="True" x:Name="Grid" Grid.Row="1" Padding="{StaticResource MelodayGridPadding}"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource MelodayTileItemStyle}"
                  controls:ResponsiveGrid.MinItemWidth="190"
                  IncrementalLoadingThreshold="3" DataFetchSize="2"
                  AutomationProperties.Name="Playlists" AutomationProperties.AutomationId="PlaylistsGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Playlist">
                    <controls:CardSlot>
                        <controls:MediaTile Item="{x:Bind}" TileSize="0" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ListView x:Name="ItemList" Grid.Row="1" Visibility="Collapsed" Padding="{StaticResource MelodayListPadding}"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" controls:QueueDrag.IsSource="True"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource MelodayTrackItemStyle}"
                  IncrementalLoadingThreshold="3" DataFetchSize="2"
                  AutomationProperties.Name="Playlists list" AutomationProperties.AutomationId="PlaylistsList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Playlist">
                    <controls:MediaListRow Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:PageStateView SkeletonKind="Tiles" SkeletonPadding="{StaticResource MelodayGridPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                EmptyText="No playlists in this library." EmptyIcon="ListMusic" RetryRequested="OnRetry" />
    </Grid>
</Page>
