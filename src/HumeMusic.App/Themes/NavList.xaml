<!-- Navigation-style lists (sidebar, category selector) are controls, so they keep a quiet hover fill. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Concentric with the glass sidebar: panel radius 20 minus its 8px inset. -->
    <CornerRadius x:Key="ListViewItemCornerRadius">12</CornerRadius>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#18FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0F000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#08000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#14000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#1A000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#12000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
