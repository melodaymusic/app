<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HumeMusic.Helpers">

    <!--
        Meloday Music design system (docs/design-system.md has the full reference).

        Type      Manrope (bundled, SIL Open Font License). Minimum 14px for anything read. Medium is the
                  reading weight, SemiBold for emphasis and controls, Bold for section headings,
                  ExtraBold for page and hero titles.
        Spacing   2 (a line and its caption) / 4 / 8 / 12 / 16 / 20 / 24 / 32 / 40 / 48 (between sections).
        Radii     Concentric: a rounded surface inside another with padding p has radius outer - p.
                  4 thumbnails, 8 artwork and controls, 12 large artwork, rows and grouped lists,
                  16 boards and panels, 20 glass surfaces. Buttons are capsules (radius = height / 2).
        Motion    Helpers/Motion.cs: Quick 120 (hover, press), Standard 200 (show, hide, state),
                  Emphasized 320 (panels, page content), Ambient 700 (backdrop colour).
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Brand accent (warm amber) replaces the system accent so every control is consistent. -->
            <Color x:Key="SystemAccentColor">#D98A1C</Color>
            <Color x:Key="SystemAccentColorLight1">#E69B35</Color>
            <Color x:Key="SystemAccentColorLight2">#F2AE4E</Color>
            <Color x:Key="SystemAccentColorLight3">#F8C77D</Color>
            <Color x:Key="SystemAccentColorDark1">#A5620A</Color>
            <Color x:Key="SystemAccentColorDark2">#85500A</Color>
            <Color x:Key="SystemAccentColorDark3">#663C05</Color>

            <SolidColorBrush x:Key="HumeAccentBrush" Color="#F2AE4E" />
            <SolidColorBrush x:Key="HumeAccentTextBrush" Color="#F2AE4E" />
            <SolidColorBrush x:Key="HumeOnAccentBrush" Color="#16130F" />
            <SolidColorBrush x:Key="HumeWindowBrush" Color="#121114" />
            <SolidColorBrush x:Key="HumeContentBrush" Color="#18171B" />
            <SolidColorBrush x:Key="HumeSubtleFillBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="HumeHoverOverlayBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="HumePressedOverlayBrush" Color="#0BFFFFFF" />
            <SolidColorBrush x:Key="HumeDividerBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="HumeTextPrimaryBrush" Color="#F4F2EE" />
            <SolidColorBrush x:Key="HumeTextSecondaryBrush" Color="#B3AFA8" />
            <SolidColorBrush x:Key="HumeTextTertiaryBrush" Color="#8C8881" />
            <SolidColorBrush x:Key="HumeChipSelectedBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="HumePlaceholderBrush" Color="#29282E" />
            <SolidColorBrush x:Key="HumePlaceholderIconBrush" Color="#5C5963" />
            <SolidColorBrush x:Key="HumePlayButtonBrush" Color="#F4F2EE" />
            <SolidColorBrush x:Key="HumeOnPlayButtonBrush" Color="#141316" />
            <SolidColorBrush x:Key="HumeHairlineBrush" Color="#1FFFFFFF" />
            <!-- In-app acrylic: content scrolling under the floating player shows through, softly blurred. -->
            <AcrylicBrush x:Key="HumePlayerAcrylicBrush" TintColor="#1E1D23" TintOpacity="0.3" TintLuminosityOpacity="0.5" FallbackColor="#26252B" />
            <!-- Frosted glass: the ambient colours behind show through, blurred. -->
            <AcrylicBrush x:Key="HumeGlassBrush" TintColor="#16161B" TintOpacity="0.2" TintLuminosityOpacity="0.38" FallbackColor="#1C1B21" />
            <!-- Controls floating on artwork (card play buttons, row arrows): dark glass in either theme, so their white glyphs read. -->
            <AcrylicBrush x:Key="HumeOverlayGlassBrush" TintColor="#141316" TintOpacity="0.28" TintLuminosityOpacity="0.45" FallbackColor="#B3141316" />
            <SolidColorBrush x:Key="HumeGlassEdgeBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="HumeGlassFillBrush" Color="#14FFFFFF" />
            <!-- Dims the now-playing UltraBlur behind every page so content always reads first. -->
            <SolidColorBrush x:Key="HumeAmbientDimBrush" Color="#A8101013" />
            <SolidColorBrush x:Key="HumeArtworkOutlineBrush" Color="#14FFFFFF" />
            <!-- Media lists: no generic hover/pressed rectangles; media components draw their own hover. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#12FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#C77912</Color>
            <Color x:Key="SystemAccentColorLight1">#D98A1C</Color>
            <Color x:Key="SystemAccentColorLight2">#E69B35</Color>
            <Color x:Key="SystemAccentColorLight3">#F2AE4E</Color>
            <Color x:Key="SystemAccentColorDark1">#A15C07</Color>
            <Color x:Key="SystemAccentColorDark2">#854B06</Color>
            <Color x:Key="SystemAccentColorDark3">#663A05</Color>

            <SolidColorBrush x:Key="HumeAccentBrush" Color="#A15C07" />
            <SolidColorBrush x:Key="HumeAccentTextBrush" Color="#8A4F06" />
            <SolidColorBrush x:Key="HumeOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HumeWindowBrush" Color="#F1EFEC" />
            <SolidColorBrush x:Key="HumeContentBrush" Color="#FBFAF8" />
            <SolidColorBrush x:Key="HumeSubtleFillBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="HumeHoverOverlayBrush" Color="#12000000" />
            <SolidColorBrush x:Key="HumePressedOverlayBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="HumeDividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="HumeTextPrimaryBrush" Color="#1B1A1D" />
            <SolidColorBrush x:Key="HumeTextSecondaryBrush" Color="#5E5A55" />
            <SolidColorBrush x:Key="HumeTextTertiaryBrush" Color="#77736D" />
            <SolidColorBrush x:Key="HumeChipSelectedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="HumePlaceholderBrush" Color="#E6E3DE" />
            <SolidColorBrush x:Key="HumePlaceholderIconBrush" Color="#A6A19A" />
            <SolidColorBrush x:Key="HumePlayButtonBrush" Color="#1B1A1D" />
            <SolidColorBrush x:Key="HumeOnPlayButtonBrush" Color="#FBFAF8" />
            <SolidColorBrush x:Key="HumeHairlineBrush" Color="#1A000000" />
            <AcrylicBrush x:Key="HumePlayerAcrylicBrush" TintColor="#FFFFFF" TintOpacity="0.4" TintLuminosityOpacity="0.62" FallbackColor="#FAF9F7" />
            <AcrylicBrush x:Key="HumeGlassBrush" TintColor="#FFFFFF" TintOpacity="0.3" TintLuminosityOpacity="0.55" FallbackColor="#F7F6F4" />
            <AcrylicBrush x:Key="HumeOverlayGlassBrush" TintColor="#141316" TintOpacity="0.28" TintLuminosityOpacity="0.45" FallbackColor="#B3141316" />
            <SolidColorBrush x:Key="HumeGlassEdgeBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="HumeGlassFillBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="HumeAmbientDimBrush" Color="#C7F3F1EE" />
            <SolidColorBrush x:Key="HumeArtworkOutlineBrush" Color="#12000000" />
            <!-- Media lists: no generic hover/pressed rectangles; media components draw their own hover. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#0F000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#0F000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#0F000000" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#0F000000" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#0F000000" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#0F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="HumeAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HumeAccentTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HumeOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="HumeWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeSubtleFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="HumeHoverOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="HumePressedOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="HumeDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumeTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumeTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumeTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumeChipSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HumePlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumePlaceholderIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumePlayButtonBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="HumeOnPlayButtonBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="HumeHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumePlayerAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeOverlayGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeGlassEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HumeGlassFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeAmbientDimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HumeArtworkOutlineBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================================================ Typography -->
    <FontFamily x:Key="HumeFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
    <!-- Every WinUI control (menus, flyouts, tooltips, inputs) uses Manrope too. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>

    <!-- ============================================================ On colour
         Text and controls laid over artwork or a coloured page (artist pages, boards, tag cards): always
         light, whatever the theme, at these fixed strengths. -->
    <SolidColorBrush x:Key="HumeOnColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorBodyBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorSecondaryBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorTertiaryBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorFillBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorPanelBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorHairlineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="HumeOnColorEdgeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="HumeArtworkShadeBrush" Color="#80000000" />

    <!-- ============================================================ Radii -->
    <CornerRadius x:Key="HumeRadiusThumb">4</CornerRadius>
    <CornerRadius x:Key="HumeRadiusControl">8</CornerRadius>
    <CornerRadius x:Key="HumeRadiusArtwork">8</CornerRadius>
    <CornerRadius x:Key="HumeRadiusLargeArtwork">12</CornerRadius>
    <!-- Card containers: artwork 8 + the container's padding 10. -->
    <CornerRadius x:Key="HumeRadiusTileHost">18</CornerRadius>
    <CornerRadius x:Key="HumeRadiusRow">12</CornerRadius>
    <!-- Grouped (inset) lists, as in Settings: rows share one rounded group. -->
    <CornerRadius x:Key="HumeRadiusGroup">12</CornerRadius>
    <CornerRadius x:Key="HumeRadiusSurface">16,0,0,0</CornerRadius>
    <!-- WinUI's list item templates read these instead of the item's own CornerRadius, so they set the
         shape of every list/grid item's hover, selection and focus: rows 12, tiles 18. -->
    <CornerRadius x:Key="ListViewItemCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="GridViewItemCornerRadius">18</CornerRadius>
    <!-- Floating glass panels (sidebar, queue); items inside use radius - padding. -->
    <CornerRadius x:Key="HumeRadiusGlass">20</CornerRadius>
    <!-- Editorial cards (squareboard, billboard, colour board); their containers = 16 + the padding 10. -->
    <CornerRadius x:Key="HumeRadiusBoard">16</CornerRadius>
    <CornerRadius x:Key="HumeRadiusBoardTop">16,16,0,0</CornerRadius>
    <CornerRadius x:Key="HumeRadiusBoardBottom">0,0,16,16</CornerRadius>
    <CornerRadius x:Key="HumeRadiusBoardHost">26</CornerRadius>

    <!-- WinUI controls (ComboBox, TextBox, flyouts, InfoBar...) follow the same radius scale. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <!-- Selection is shown with a quiet fill, not a coloured edge bar. -->
    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>

    <!-- Spacing and sizes are scaled tokens published by Services/UiScale.cs. -->

    <!-- ============================================================ Text styles -->
    <Style x:Key="HumeTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HumeFont}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
        <!-- Manrope's Regular is light on glass and colour: Medium is the base weight for reading text. -->
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Hero titles on artist / album / playlist / now playing. -->
    <Style x:Key="HumeHeroText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontHero}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="{StaticResource HumeLineHero}" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <!-- Page titles (Home, Albums, ...). -->
    <Style x:Key="HumeDisplayText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontDisplay}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="{StaticResource HumeLineDisplay}" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="MaxLines" Value="2" />
    </Style>
    <Style x:Key="HumeTitleText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
    </Style>
    <Style x:Key="HumeSectionText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontSection}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
    </Style>
    <!-- A line of lyrics: large and bold, as Apple Music sets them; the line being sung is bright, the rest recede. -->
    <Style x:Key="HumeLyricText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontSection}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <!-- A title inside a card or panel (Latest Release's album name). -->
    <Style x:Key="HumeHeadlineText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="HumeBodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="HumeBodyText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBody}" />
    </Style>
    <Style x:Key="HumeSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextSecondaryBrush}" />
    </Style>
    <Style x:Key="HumeParagraphText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBody}" />
        <Setter Property="LineHeight" Value="{StaticResource HumeLineParagraph}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <!-- Small eyebrow above titles ("Album", "Now playing"). -->
    <Style x:Key="HumeOverlineText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextSecondaryBrush}" />
    </Style>

    <!-- ============================================================ Buttons -->
    <!--
        One template for every Hume button. State changes use a translucent overlay on top of the
        button's own background, so hover / pressed read correctly on any fill (accent, subtle,
        transparent, the solid play button) and the content colour never collides with the fill.
        Disabled dims the whole control. Keyboard focus uses the system focus visual, which follows
        CornerRadius.
    -->
    <ControlTemplate x:Key="HumeButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Border x:Name="Overlay" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" helpers:Anim.Fade="True" />
            <ContentPresenter x:Name="Presenter" helpers:Anim.Fade="True"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource HumeHoverOverlayBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Background" Value="{ThemeResource HumePressedOverlayBrush}" />
                            <Setter Target="Presenter.Opacity" Value="0.8" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.38" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="HumeButtonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource HumeButtonTemplate}" />
        <Setter Property="FontFamily" Value="{StaticResource HumeFont}" />
        <Setter Property="FontSize" Value="{StaticResource HumeFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>

    <!-- Transparent circular icon button (transport, row actions, toolbar). -->
    <Style x:Key="HumeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource HumeButtonM}" />
        <Setter Property="Height" Value="{StaticResource HumeButtonM}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- The play / pause button: solid, high-contrast circle; the glyph uses the contrasting colour. -->
    <Style x:Key="HumePlayButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{ThemeResource HumePlayButtonBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeOnPlayButtonBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource HumeButtonXL}" />
        <Setter Property="Height" Value="{StaticResource HumeButtonXL}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>


    <!-- Capsule buttons with a label (and usually an icon): all 40 high with the same padding.
         Primary (accent) is the page's main action; secondary (subtle fill) the rest. -->
    <Thickness x:Key="HumeCapsulePadding">16,0,18,0</Thickness>
    <Style x:Key="HumePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{ThemeResource HumeAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource HumeCapsulePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
    </Style>
    <Style x:Key="HumeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{ThemeResource HumeSubtleFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource HumeCapsulePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
    </Style>
    <!-- Deleting (confirmations only): white on red, so it is never mistaken for anything else. -->
    <SolidColorBrush x:Key="HumeDangerBrush" Color="#E5484D" />
    <Style x:Key="HumeDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{StaticResource HumeDangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource HumeCapsulePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
    </Style>
    <!-- Round icon-only companion to the capsule buttons (pin, add, more), the same height. -->
    <Style x:Key="HumeRoundActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{ThemeResource HumeSubtleFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- Track row play glyph: no fill or hover box, just the glyph (it replaces the number / dims the art). -->
    <Style x:Key="HumeRowPlayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Artist hero actions: sit on a coloured page, so they are fixed light-on-colour, not theme-driven. -->
    <Style x:Key="HumeHeroPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{ThemeResource HumeAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource HumeOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource HumeCapsulePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
    </Style>
    <Style x:Key="HumeGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{StaticResource HumeOnColorFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource HumeCapsulePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
    </Style>
    <Style x:Key="HumeGlassRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeGlassButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource HumeControlHeight}" />
    </Style>

    <!-- Section tabs: text only; the current one is white with an underline. -->
    <Style x:Key="HumeTabButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <!-- Every button is a capsule (Apple's buttons); the tab's hover shape too. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource HumeFontBodyLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{StaticResource HumeControlHeight}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
    </Style>

    <!-- Translucent panel on a coloured page (Top Songs, Latest Release, About). -->
    <Style x:Key="HumeGlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HumeOnColorPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HumeOnColorPanelBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusBoard}" />
        <Setter Property="Padding" Value="{StaticResource HumePanelPadding}" />
    </Style>

    <!-- Text laid over artwork on boards: always light, over a dark scrim. -->
    <Style x:Key="HumeBoardEyebrowText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBoardEyebrow}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorBodyBrush}" />
    </Style>
    <Style x:Key="HumeBoardTitleText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBoardTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorPrimaryBrush}" />
    </Style>
    <Style x:Key="HumeBoardSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBoardSubtitle}" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorBodyBrush}" />
    </Style>
    <Style x:Key="HumeBoardDetailText" TargetType="TextBlock" BasedOn="{StaticResource HumeTextBase}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontBoardDetail}" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorTertiaryBrush}" />
    </Style>

    <!-- Small round control floating on artwork (tile hover play / more). -->
    <Style x:Key="HumeOverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="{ThemeResource HumeOverlayGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HumeOnColorEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource HumeOnColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource HumeButtonS}" />
        <Setter Property="Height" Value="{StaticResource HumeButtonS}" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- Row arrows, as Apple Music has them: a dark upright capsule at the row's edge, shown while the row is hovered. -->
    <!-- Its size and capsule radius follow the cards (MediaRowControl.PlaceArrows). -->
    <Style x:Key="HumeRowArrowButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeOverlayButtonStyle}">
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- Pop-up menus (combo boxes) are buttons too: capsules, like every other button. Text fields stay rounded rectangles, as on the Mac. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusPill}" />
        <Setter Property="Padding" Value="14,5,0,7" />
    </Style>

    <!-- Clickable artwork tile host (used where tiles are laid out by an ItemsRepeater). -->
    <Style x:Key="HumeTileButtonStyle" TargetType="Button" BasedOn="{StaticResource HumeButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource HumeTilePadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusTileHost}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>

    <!-- Icon toggle (shuffle / repeat / queue): accent coloured with a dot when on. -->
    <Style x:Key="HumeIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource HumeButtonM}" />
        <Setter Property="Height" Value="{StaticResource HumeButtonM}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="Overlay" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" helpers:Anim.Fade="True" />
                        <ContentPresenter x:Name="Presenter" helpers:Anim.Fade="True"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                        <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{ThemeResource HumeAccentBrush}" helpers:Anim.Fade="True"
                                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!-- Every unchecked state hides the dot itself: a setter merely lapsing doesn't
                                     always carry the fade back, and the dot could stay lit. -->
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Overlay.Background" Value="{ThemeResource HumeHoverOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Overlay.Background" Value="{ThemeResource HumePressedOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Dot.Opacity" Value="0" />
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HumeAccentBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{ThemeResource HumeHoverOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HumeAccentBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Background" Value="{ThemeResource HumePressedOverlayBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HumeAccentBrush}" />
                                        <Setter Target="Dot.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.38" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource HumeAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="IndeterminatePointerOver" />
                                <VisualState x:Name="IndeterminatePressed" />
                                <VisualState x:Name="IndeterminateDisabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The line under a hero or feature title (an album's artist, the playing track's artist): accent, SemiBold. -->
    <Style x:Key="HumeHeroSubtitleLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource HumeLinkButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HumeAccentTextBrush}" />
    </Style>
    <Style x:Key="HumeFeatureSubtitleLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource HumeHeroSubtitleLinkStyle}">
        <Setter Property="FontSize" Value="{StaticResource HumeFontSubtitle}" />
    </Style>
    <!-- "More" / "Read More" under clipped text. -->
    <Style x:Key="HumeMoreLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource HumeLinkButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextPrimaryBrush}" />
    </Style>

    <!-- ============================================================ Grouped lists
         Apple's inset grouped list (Settings): a heading, then rows sharing one rounded group, each row
         on its own fill with a hairline gap between. The group clips its rows to its corners. -->
    <Style x:Key="HumeGroupStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="HumeGroupHeaderText" TargetType="TextBlock" BasedOn="{StaticResource HumeBodyStrongText}">
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style x:Key="HumeGroupListStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusGroup}" />
    </Style>
    <Style x:Key="HumeGroupRowsStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="2" />
    </Style>
    <Style x:Key="HumeGroupRowStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource HumeGlassFillBrush}" />
        <Setter Property="Padding" Value="{StaticResource HumeSettingsRowPadding}" />
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="MinHeight" Value="{StaticResource HumeSettingsRowHeight}" />
    </Style>

    <!-- Inline text link (artist names, "See all"). -->
    <Style x:Key="HumeLinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource HumeTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource HumeFont}" />
        <Setter Property="FontSize" Value="{StaticResource HumeFontBody}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FocusVisualMargin" Value="-2" />
    </Style>
</ResourceDictionary>
