<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        List item containers. Radii follow the concentric rule from Design.xaml:
        card container 18 = artwork 8 + padding 10; board container 26 = board 16 + padding 10;
        track row 12 = thumbnail 4 + padding 8.
    -->

    <!-- Artwork tiles in grids and rows. -->
    <Style x:Key="HumeTileItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Margin" Value="{StaticResource HumeTileMargin}" />
        <!-- No padding: grid items clip content to inside it, so the card's padding is in its CardSlot. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusTileHost}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>
    <Style x:Key="HumeRowTileItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Margin" Value="{StaticResource HumeRowTileMargin}" />
        <Setter Property="Padding" Value="{StaticResource HumeRowCardPadding}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusTileHost}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>

    <!-- Editorial boards in rows. -->
    <Style x:Key="HumeRowBoardItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Margin" Value="{StaticResource HumeRowBoardMargin}" />
        <Setter Property="Padding" Value="{StaticResource HumeRowCardPadding}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusBoardHost}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>
    <!-- Rows of tracks. -->
    <Style x:Key="HumeTrackItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource HumeTrackRowHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusRow}" />
        <Setter Property="FocusVisualMargin" Value="0" />
    </Style>


    <!-- Navigation rail entries and simple selectable lists. -->
    <Style x:Key="HumeNavItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="{StaticResource HumeNavItemHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusControl}" />
        <Setter Property="FontFamily" Value="{StaticResource HumeFont}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Browse category selector (segmented). -->
    <Style x:Key="HumeChipItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinHeight" Value="{StaticResource HumeNavItemHeight}" />
        <Setter Property="Height" Value="{StaticResource HumeNavItemHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HumeRadiusChip}" />
    </Style>
</ResourceDictionary>
