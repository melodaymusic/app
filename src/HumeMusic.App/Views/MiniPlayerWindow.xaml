<Window
    x:Class="HumeMusic.Views.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <!-- The mini player: the artwork fills the window, with the song and its controls on a shade at the
         foot, like Apple Music's. Always dark: it sits on artwork. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#FF101014">
        <controls:ArtworkImage x:Name="Art" DecodeSize="480" PlaceholderIcon="Music" ArtworkCornerRadius="0"
                               SourcePath="{x:Bind Player.ArtworkPath, Mode=OneWay}" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#66000000" />
                    <GradientStop Offset="0.18" Color="#00000000" />
                    <GradientStop Offset="0.45" Color="#00000000" />
                    <GradientStop Offset="1" Color="#E6000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Title bar: drag anywhere along the top; back to the full window on the left. -->
        <Grid x:Name="TitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" Padding="8,0,0,0">
            <Button x:Name="ExpandButton" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonS}" Height="{StaticResource HumeButtonS}"
                    HorizontalAlignment="Left" Click="OnExpand" ToolTipService.ToolTip="Back to the full window" AutomationProperties.Name="Back to the full window">
                <controls:LucideIcon Icon="Maximize2" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" />
            </Button>
        </Grid>

        <StackPanel VerticalAlignment="Bottom" Padding="16,0,16,12" Spacing="2">
            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource HumeBodyStrongText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextTrimming="CharacterEllipsis" />
            <Slider x:Name="Progress" Minimum="0" StepFrequency="1" IsThumbToolTipEnabled="False" Margin="0,4,0,0"
                    Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=TwoWay}"
                    IsEnabled="{x:Bind Player.CanSeek, Mode=OneWay}" AutomationProperties.Name="Playback position" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Style="{StaticResource HumeIconToggleStyle}" IsChecked="{x:Bind Player.IsShuffled, Mode=TwoWay}"
                              ToolTipService.ToolTip="{x:Bind Player.ShuffleLabel, Mode=OneWay}" AutomationProperties.Name="Shuffle">
                    <controls:LucideIcon Icon="Shuffle" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
                </ToggleButton>
                <Button Grid.Column="1" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonL}" Height="{StaticResource HumeButtonL}"
                        Command="{x:Bind Player.PreviousCommand}" IsEnabled="{x:Bind Player.HasPrevious, Mode=OneWay}" AutomationProperties.Name="Previous">
                    <controls:LucideIcon Icon="SkipBack" IsFilled="True" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HumePlayButtonStyle}" Width="{StaticResource HumeButtonXL}" Height="{StaticResource HumeButtonXL}" Margin="12,0"
                        Command="{x:Bind Player.PlayPauseCommand}" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}" AutomationProperties.AutomationId="MiniPlayPause">
                    <controls:LucideIcon Icon="{x:Bind Player.PlayPauseIcon, Mode=OneWay}" IsFilled="True" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonL}" Height="{StaticResource HumeButtonL}"
                        Command="{x:Bind Player.NextCommand}" IsEnabled="{x:Bind Player.HasNext, Mode=OneWay}" AutomationProperties.Name="Next">
                    <controls:LucideIcon Icon="SkipForward" IsFilled="True" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                </Button>
                <controls:RepeatToggle Grid.Column="4" HorizontalAlignment="Right" IconSize="{StaticResource HumeIconM}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
