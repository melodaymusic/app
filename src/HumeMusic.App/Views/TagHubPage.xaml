<Page
    x:Class="HumeMusic.Views.TagHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:models="using:HumeMusic.Core.Models"
    xmlns:vm="using:HumeMusic.ViewModels"
    Background="Transparent">

    <!-- A family of tags from Browse (Pop, Chill & Calm...): its genres, styles or moods as cards, and
         everything in the family at once through All Albums and Shuffle. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource HumePageHeaderPadding}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource HumePrimaryButtonStyle}" Click="OnShuffle">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                </Button>
                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnAllAlbums">
                    <controls:IconLabel Icon="Disc3" Text="All Albums" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <GridView x:Name="Members" Grid.Row="1" Padding="{StaticResource HumeGridPadding}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource HumeTileItemStyle}" controls:ResponsiveGrid.MinItemWidth="300"
                  AutomationProperties.AutomationId="TagHubGrid">
            <!-- Billboards for this corner of the library, when there's something true to say. -->
            <GridView.Header>
                <controls:MediaRowControl x:Name="Highlights" CardStyle="EditorialBoard" Visibility="Collapsed" Margin="12,0,0,28"
                                          AutomationProperties.AutomationId="TagHubHighlights" />
            </GridView.Header>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:TagItem">
                    <controls:CardSlot>
                        <controls:TagCard Item="{x:Bind}" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
