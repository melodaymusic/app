<UserControl
    x:Class="HumeMusic.Views.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:vm="using:HumeMusic.ViewModels">

    <UserControl.Resources>
        <!-- Queue rows are ordinary track rows (as on album and playlist pages); the list supplies play = jump and remove. -->
        <DataTemplate x:Key="QueueRowTemplate" x:DataType="vm:QueueItemViewModel">
            <controls:TrackRow Track="{x:Bind Track}" Opacity="{x:Bind RowOpacity}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="12,16,12,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Queue" Style="{StaticResource HumeSectionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Grid.Column="1" Style="{StaticResource HumeIconButtonStyle}" ToolTipService.ToolTip="Save queue as a playlist"
                    AutomationProperties.Name="Save queue as a playlist" Click="OnSaveQueue" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}">
                <controls:LucideIcon Icon="SavePlus" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource HumeIconButtonStyle}" ToolTipService.ToolTip="Clear up next"
                    AutomationProperties.Name="Clear up next" Command="{x:Bind Player.ClearUpNextCommand}"
                    IsEnabled="{x:Bind Player.HasUpNext, Mode=OneWay}">
                <controls:LucideIcon Icon="ListX" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
            </Button>
        </Grid>

        <!-- One virtualized list: now playing in the header, up next as (reorderable) items, history in the footer. -->
        <ListView x:Name="UpNextList" Grid.Row="1" ItemsSource="{x:Bind Player.UpNext}" ItemTemplate="{StaticResource QueueRowTemplate}"
                  ItemContainerStyle="{StaticResource HumeTrackItemStyle}" Padding="0,0,0,16"
                  SelectionMode="Single" IsItemClickEnabled="False" CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                  controls:QueueDrag.IsTarget="True"
                  controls:TrackListBehavior.PlayCommand="{x:Bind Player.JumpToCommand}" controls:TrackListBehavior.RemoveCommand="{x:Bind Player.RemoveCommand}"
                  DoubleTapped="OnRowDoubleTapped" KeyDown="OnRowKeyDown"
                  AutomationProperties.Name="Up next" AutomationProperties.AutomationId="UpNextList">
            <ListView.Header>
                <StackPanel Spacing="8" Padding="12,4,12,8">
                    <TextBlock Text="Now Playing" Style="{StaticResource HumeOverlineText}" />
                    <Grid ColumnSpacing="12" Visibility="{x:Bind Player.HasTrack, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtworkImage Width="{StaticResource HumeArtQueue}" Height="{StaticResource HumeArtQueue}" DecodeSize="72" ArtworkCornerRadius="{StaticResource HumeRadiusArtwork}" PlaceholderIcon="Music"
                                               SourcePath="{x:Bind Player.ArtworkPath, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource HumeBodyStrongText}" Foreground="{ThemeResource HumeAccentTextBrush}" />
                            <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Nothing is playing" Style="{StaticResource HumeSecondaryText}"
                               helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.CollapsedIf(Player.HasTrack), Mode=OneWay}" />
                    <Grid Margin="0,20,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Up Next" Style="{StaticResource HumeOverlineText}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Player.UpNextSummary, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                    </Grid>
                </StackPanel>
            </ListView.Header>
            <ListView.Footer>
                <Expander Header="Recently Played" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,16,8,0"
                          helpers:Anim.Appear="True" Visibility="{x:Bind Player.HasHistory, Mode=OneWay}">
                    <ListView ItemsSource="{x:Bind Player.History}" ItemTemplate="{StaticResource QueueRowTemplate}"
                              ItemContainerStyle="{StaticResource HumeTrackItemStyle}" SelectionMode="Single"
                              controls:TrackListBehavior.PlayCommand="{x:Bind Player.JumpToCommand}"
                              DoubleTapped="OnRowDoubleTapped" KeyDown="OnRowKeyDown"
                              ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Recently Played" />
                </Expander>
            </ListView.Footer>
        </ListView>
    </Grid>
</UserControl>
