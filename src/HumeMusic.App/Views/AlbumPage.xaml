<Page
    x:Class="HumeMusic.Views.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:vm="using:HumeMusic.ViewModels"
    Background="Transparent">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DetailHeader x:Name="Header" Item="{x:Bind ViewModel.Album, Mode=OneWay}" Artwork="{x:Bind ViewModel.Album.Thumb, Mode=OneWay}"
                               Subtitle="{x:Bind ViewModel.Album.ArtistTitle, Mode=OneWay}" Meta="{x:Bind ViewModel.MetaText, Mode=OneWay}"
                               Description="{x:Bind ViewModel.Album.Summary, Mode=OneWay}" PlaceholderIcon="Disc3"
                               ScrollSource="{x:Bind Scroller}" PlayRequested="OnPlay" ShuffleRequested="OnShuffle" />

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="PageScroller">
            <StackPanel Spacing="{StaticResource HumeSectionSpacing}" Padding="{StaticResource HumeDetailContentPadding}">
                <controls:PageStateView SkeletonKind="Tracks" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                        ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry"
                                        IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" EmptyText="This album has no tracks." />

                <!-- Track listing and release details -->
                <StackPanel Spacing="20">
                    <ListView x:Name="TrackList" ItemsSource="{x:Bind ViewModel.Tracks}" Margin="-12,0,-12,0"
                              SelectionMode="Extended" controls:TrackListBehavior.IsEnabled="True"
                              ItemContainerStyle="{StaticResource HumeTrackItemStyle}"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              AutomationProperties.Name="Tracks" AutomationProperties.AutomationId="AlbumTrackList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlbumTrackRow">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DiscHeader}" Style="{StaticResource HumeOverlineText}" Margin="0,20,0,6"
                                               Visibility="{x:Bind HasDiscHeader}" />
                                    <controls:TrackRow Track="{x:Bind Track}" Mode="Album" ShowTrackArtist="{x:Bind ShowTrackArtist}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Spacing="2" helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.FooterText), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ReleaseText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}"
                                   helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.ReleaseText), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.FooterText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                        <TextBlock Text="{x:Bind ViewModel.FormatText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" Foreground="{ThemeResource HumeTextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <controls:MediaRowControl Header="{x:Bind MoreByHeader(ViewModel.Album.ArtistTitle), Mode=OneWay}" ItemsSource="{x:Bind ViewModel.MoreByArtist}"
                                          helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.MoreByArtist.Count), Mode=OneWay}" />
                <controls:MediaRowControl Header="Sonically similar" Subheader="Albums that sound like this one, from Plex sonic analysis"
                                          ItemsSource="{x:Bind ViewModel.SimilarAlbums}"
                                          helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.SimilarAlbums.Count), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
