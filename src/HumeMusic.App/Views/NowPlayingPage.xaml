<Page
    x:Class="HumeMusic.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:vm="using:HumeMusic.ViewModels"
    Background="Transparent">

    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <!-- The window's ambient backdrop shows this track's Plex UltraBlur at full strength behind the page. -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="Layout" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{StaticResource HumeNowPlayingPadding}" ColumnSpacing="48" RowSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:ArtworkImage x:Name="Cover" Width="{StaticResource HumeArtNowPlaying}" Height="{StaticResource HumeArtNowPlaying}" DecodeSize="720"
                                       ArtworkCornerRadius="{StaticResource HumeRadiusLargeArtwork}" PlaceholderIcon="Music"
                                       SourcePath="{x:Bind Player.ArtworkPath, Mode=OneWay}" VerticalAlignment="Center" />

                <!-- The visualizer stands in the artwork's place, the same size, when one is chosen (the button beside the rating). -->
                <controls:VisualizerView x:Name="Visualizer" CornerRadius="{StaticResource HumeRadiusLargeArtwork}" VerticalAlignment="Center" Visibility="Collapsed" />

                <StackPanel x:Name="Info" Grid.Column="1" Width="460" VerticalAlignment="Center" Spacing="4">
                    <!-- Live radio says so; Headliners also features the artist whose block is on. -->
                    <TextBlock Text="{x:Bind Player.LiveLabel, Mode=OneWay}" Style="{StaticResource HumeOverlineText}" Foreground="{ThemeResource HumeAccentTextBrush}"
                               Visibility="{x:Bind Player.IsLive, Mode=OneWay}" AutomationProperties.AutomationId="NowPlayingLive" />
                    <Grid ColumnSpacing="14" Margin="0,4,0,12" Visibility="{x:Bind Player.HasFeatured, Mode=OneWay}"
                          helpers:Anim.Appear="True" AutomationProperties.AutomationId="FeaturedArtist">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtworkImage Width="64" Height="64" DecodeSize="128" ArtworkCornerRadius="32" PlaceholderIcon="MicVocal"
                                               SourcePath="{x:Bind Player.FeaturedArtistThumb, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="FEATURED ARTIST" Style="{StaticResource HumeOverlineText}" Foreground="{ThemeResource HumeTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind Player.FeaturedArtist, Mode=OneWay}" Style="{StaticResource HumeTitleText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Player.FeaturedProgress, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TitleText" Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource HumeHeroText}" FontSize="{StaticResource HumeFontFeature}" LineHeight="{StaticResource HumeLineFeature}"
                               IsTextSelectionEnabled="True" AutomationProperties.AutomationId="NowPlayingPageTitle" />
                    <HyperlinkButton Command="{x:Bind Player.OpenArtistCommand}" Style="{StaticResource HumeFeatureSubtitleLinkStyle}">
                        <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                    <HyperlinkButton Command="{x:Bind Player.OpenAlbumCommand}" Style="{StaticResource HumeLinkButtonStyle}" FontSize="{StaticResource HumeFontLabel}">
                        <TextBlock Text="{x:Bind Player.AlbumYearText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>

                    <!-- Progress -->
                    <StackPanel Margin="0,24,0,0" Spacing="0">
                        <Slider x:Name="Progress" Minimum="0" StepFrequency="1" IsThumbToolTipEnabled="False"
                                Maximum="{x:Bind Player.DurationSeconds, Mode=OneWay}" Value="{x:Bind Player.PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{x:Bind Player.CanSeek, Mode=OneWay}" AutomationProperties.Name="Playback position" />
                        <!-- The times, and what the stream is (format and bitrate) between them, where there is room for all of it. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Player.StreamDescription, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}"
                                       Foreground="{ThemeResource HumeTextTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="StreamDescription" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Player.RemainingText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" Typography.NumeralAlignment="Tabular" />
                        </Grid>
                    </StackPanel>

                    <!-- Transport -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource HumeIconToggleStyle}" Width="{StaticResource HumeButtonL}" Height="{StaticResource HumeButtonL}"
                                      IsChecked="{x:Bind Player.IsShuffled, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind Player.ShuffleLabel, Mode=OneWay}" AutomationProperties.Name="Shuffle">
                            <controls:LucideIcon Icon="Shuffle" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                        </ToggleButton>
                        <Button Grid.Column="1" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonXXL}" Height="{StaticResource HumeButtonXXL}" Command="{x:Bind Player.PreviousCommand}"
                                IsEnabled="{x:Bind Player.HasPrevious, Mode=OneWay}" ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                            <controls:LucideIcon Icon="SkipBack" IsFilled="True" Width="{StaticResource HumeIconXXL}" Height="{StaticResource HumeIconXXL}" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource HumePlayButtonStyle}" Width="{StaticResource HumeButtonHero}" Height="{StaticResource HumeButtonHero}" Margin="20,0"
                                Command="{x:Bind Player.PlayPauseCommand}" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}" AutomationProperties.AutomationId="NowPlayingPlayPause">
                            <Grid>
                                <controls:LucideIcon Icon="{x:Bind Player.PlayPauseIcon, Mode=OneWay}" IsFilled="True" Width="{StaticResource HumeIconHero}" Height="{StaticResource HumeIconHero}"
                                                     Visibility="{x:Bind helpers:Format.CollapsedIf(Player.IsBuffering), Mode=OneWay}" />
                                <ProgressRing IsActive="{x:Bind Player.IsBuffering, Mode=OneWay}" Width="28" Height="28" Foreground="{ThemeResource HumeOnPlayButtonBrush}" />
                            </Grid>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonXXL}" Height="{StaticResource HumeButtonXXL}" Command="{x:Bind Player.NextCommand}"
                                IsEnabled="{x:Bind Player.HasNext, Mode=OneWay}" ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                            <controls:LucideIcon Icon="SkipForward" IsFilled="True" Width="{StaticResource HumeIconXXL}" Height="{StaticResource HumeIconXXL}" />
                        </Button>
                        <!-- Repeat: three states (off, all, one), shown like the shuffle toggle opposite. -->
                        <controls:RepeatToggle Grid.Column="4" HorizontalAlignment="Right" Width="{StaticResource HumeButtonL}" Height="{StaticResource HumeButtonL}"
                                               IconSize="{StaticResource HumeIconL}" />
                    </Grid>

                    <!-- Volume -->
                    <Grid Margin="0,16,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource HumeIconButtonStyle}" Command="{x:Bind Player.ToggleMuteCommand}" ToolTipService.ToolTip="Mute (Ctrl+M)" AutomationProperties.Name="Mute">
                            <controls:LucideIcon Icon="{x:Bind Player.VolumeIcon, Mode=OneWay}" />
                        </Button>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                Value="{x:Bind Player.Volume, Mode=TwoWay}" AutomationProperties.Name="Volume" />
                    </Grid>

                    <!-- The rating, and Mute: keeping this song or its artist out of Meloday for a while. -->
                    <Grid Margin="0,8,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:StarRating Item="{x:Bind Player.Track, Mode=OneWay}" StarSize="{StaticResource HumeStarL}" VerticalAlignment="Center"
                                             AutomationProperties.Name="Track rating" />
                        <controls:MuteButton Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <!-- What can be done with this song and the music around it: on the left what it is shown as and what plays from it, on the right the side panel, the sleep timer and where it plays. -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <controls:VisualizerButton Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}" IconSize="{StaticResource HumeIconL}" />
                            <controls:CuratorButton Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}" IconSize="{StaticResource HumeIconL}" />
                            <controls:StationFeedbackButton Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}" IconSize="{StaticResource HumeIconL}" />
                            <Button Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}" Command="{x:Bind Player.SonicRadioCommand}"
                                    ToolTipService.ToolTip="Sonic radio from this track" AutomationProperties.Name="Sonic Radio">
                                <controls:LucideIcon Icon="Radio" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="LyricsToggle" Style="{StaticResource HumeIconToggleStyle}" Tag="SidePanelToggle" Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}"
                                          Click="OnLyricsClick" ToolTipService.ToolTip="Lyrics" AutomationProperties.Name="Lyrics">
                                <controls:LucideIcon Icon="MessageSquareQuote" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                            </ToggleButton>
                            <controls:SleepTimerButton Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}" IconSize="{StaticResource HumeIconL}" />
                            <controls:CastButton Width="{StaticResource HumeButtonM}" Height="{StaticResource HumeButtonM}" IconSize="{StaticResource HumeIconL}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Up next preview -->
                <StackPanel x:Name="UpNextPanel" Grid.Row="1" Grid.ColumnSpan="2" Spacing="12" Visibility="{x:Bind Player.HasUpNext, Mode=OneWay}"
                            helpers:Anim.Appear="True">
                    <controls:SectionHeader Title="Up Next" Trailing="{x:Bind Player.UpNextSummary, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind Player.UpNextTop}" Margin="-12,0" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource HumeTrackItemStyle}" DoubleTapped="OnUpNextDoubleTapped" KeyDown="OnUpNextKeyDown"
                              CanReorderItems="True" CanDragItems="True" AllowDrop="True" controls:QueueDrag.IsTarget="True"
                              controls:TrackListBehavior.PlayCommand="{x:Bind Player.JumpToCommand}" controls:TrackListBehavior.RemoveCommand="{x:Bind Player.RemoveCommand}"
                              ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Up next">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueItemViewModel">
                                <controls:TrackRow Track="{x:Bind Track}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Nothing playing -->
                <controls:PageStateView x:Name="EmptyPanel" Grid.RowSpan="2" Grid.ColumnSpan="2" IsEmpty="{x:Bind helpers:Format.Not(Player.HasTrack), Mode=OneWay}"
                                        EmptyIcon="Music" EmptyTitle="Nothing Playing" EmptyText="Pick an album, artist or playlist to start listening." />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
