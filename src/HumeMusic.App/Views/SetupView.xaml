<UserControl
    x:Class="HumeMusic.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:models="using:HumeMusic.Core.Models">

    <Grid Background="{ThemeResource HumeContentBrush}" CornerRadius="{StaticResource HumeRadiusSurface}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="520" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource HumeTitleText}" TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource HumeParagraphText}" />
                </StackPanel>

                <ListView ItemsSource="{x:Bind ViewModel.Servers}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnServerClick"
                          helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.ShowServers), Mode=OneWay}"
                          ItemContainerStyle="{StaticResource HumeNavItemStyle}">
                    <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlexServer">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:LucideIcon Icon="Server" Width="{StaticResource HumeIconXL}" Height="{StaticResource HumeIconXL}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource HumeBodyStrongText}" />
                                    <TextBlock Text="{x:Bind OwnerName}" Style="{StaticResource HumeSecondaryText}"
                                               Visibility="{x:Bind helpers:Format.VisibleIfText(OwnerName)}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView ItemsSource="{x:Bind ViewModel.Sections}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSectionClick"
                          helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.ShowSections), Mode=OneWay}"
                          ItemContainerStyle="{StaticResource HumeNavItemStyle}">
                    <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MusicSection">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:LucideIcon Icon="Library" Width="{StaticResource HumeIconXL}" Height="{StaticResource HumeIconXL}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource HumeBodyStrongText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource HumePrimaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand}"
                            helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.ShowRetry), Mode=OneWay}">
                        <controls:IconLabel Icon="RefreshCw" Text="Try Again" />
                    </Button>
                    <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Sign Out" Command="{x:Bind ViewModel.SignOutCommand}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
