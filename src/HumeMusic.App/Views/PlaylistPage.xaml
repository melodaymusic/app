<Page
    x:Class="HumeMusic.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:models="using:HumeMusic.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The playlist's backdrop from the Plex server, when it has one: it fills the top of the page and dissolves down into it, under a shade so the text reads. -->
        <controls:BackdropLayer Grid.RowSpan="2" ScrollSource="{x:Bind TrackList}" SourcePath="{x:Bind ViewModel.Backdrop, Mode=OneWay}" />

        <controls:DetailHeader x:Name="Header" Item="{x:Bind ViewModel.Playlist, Mode=OneWay}" Artwork="{x:Bind ViewModel.Playlist.DisplayThumb, Mode=OneWay}"
                               Meta="{x:Bind ViewModel.MetaText, Mode=OneWay}" Description="{x:Bind ViewModel.Playlist.Summary, Mode=OneWay}"
                               PlaceholderIcon="ListMusic" ScrollSource="{x:Bind TrackList}" PlayRequested="OnPlay" ShuffleRequested="OnShuffle">
            <!-- Search this playlist (a circle that opens into a field), and view it in another order. -->
            <controls:DetailHeader.ExtraActions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:PageSearch x:Name="Search" Placeholder="Search this playlist" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                    <controls:SortButton Options="{x:Bind ViewModel.SortOptions}" Selected="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
                </StackPanel>
            </controls:DetailHeader.ExtraActions>
        </controls:DetailHeader>

        <!-- Tracks in a normal playlist can be dragged into a new order; smart playlists are ordered by Plex. -->
        <ListView x:Name="TrackList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Shown, Mode=OneWay}" Padding="{StaticResource HumeListPadding}"
                  CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                  AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}" DragItemsCompleted="OnTracksReordered"
                  controls:TrackListBehavior.RemoveCommand="{x:Bind ViewModel.RemoveCommand, Mode=OneWay}"
                  SelectionMode="Extended" controls:TrackListBehavior.IsEnabled="True"
                  ItemContainerStyle="{StaticResource HumeTrackItemStyle}" IncrementalLoadingThreshold="4"
                  AutomationProperties.Name="Playlist tracks" AutomationProperties.AutomationId="PlaylistTrackList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <controls:TrackRow Track="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Style="{StaticResource HumeSecondaryText}"
                   Text="Nothing in this playlist matches your search." Visibility="{x:Bind ViewModel.NoMatches, Mode=OneWay}" />

        <controls:PageStateView SkeletonKind="Tracks" SkeletonPadding="{StaticResource HumeListPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" EmptyText="This playlist is empty." EmptyIcon="ListMusic" />
    </Grid>
</Page>
