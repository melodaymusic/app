<Page
    x:Class="HumeMusic.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:vm="using:HumeMusic.ViewModels"
    xmlns:models="using:HumeMusic.Core.Models"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Padding="{StaticResource HumePageHeaderPadding}" Title="Playlists" Subtitle="{x:Bind ViewModel.CountText, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnNewPlaylist" AutomationProperties.AutomationId="NewPlaylistButton">
                    <controls:IconLabel Icon="Plus" Text="New Playlist" />
                </Button>
                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnNewSmartPlaylist" AutomationProperties.AutomationId="NewSmartPlaylistButton">
                    <controls:IconLabel Icon="Sparkles" Text="New Smart Playlist" />
                </Button>
                <controls:SortButton Options="{x:Bind ViewModel.SortOptions}" Selected="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
            </StackPanel>
        </controls:PageHeader>

        <GridView controls:QueueDrag.IsSource="True" x:Name="Grid" Grid.Row="1" Padding="{StaticResource HumeGridPadding}"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource HumeTileItemStyle}"
                  controls:ResponsiveGrid.MinItemWidth="190"
                  IncrementalLoadingThreshold="3" DataFetchSize="2"
                  AutomationProperties.Name="Playlists" AutomationProperties.AutomationId="PlaylistsGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Playlist">
                    <controls:CardSlot>
                        <controls:MediaTile Item="{x:Bind}" TileSize="0" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <controls:PageStateView SkeletonKind="Tiles" SkeletonPadding="{StaticResource HumeGridPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                EmptyText="You have no music playlists. Playlists you create in Plex appear here." EmptyIcon="ListMusic" RetryRequested="OnRetry" />
    </Grid>
</Page>
