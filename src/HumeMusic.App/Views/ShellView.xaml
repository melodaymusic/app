<UserControl
    x:Class="HumeMusic.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:views="using:HumeMusic.Views"
    xmlns:local="using:HumeMusic.Views"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:models="using:HumeMusic.Core.Models">

    <UserControl.Resources>
        <!-- Sidebar entries: the selected item's icon takes the accent colour, as in Apple Music. -->
        <DataTemplate x:Key="WideNavTemplate" x:DataType="local:NavItem">
            <Grid ColumnSpacing="12" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Visibility="{x:Bind helpers:Format.CollapsedIf(HasPicture), Mode=OneWay}">
                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" VerticalAlignment="Center"
                                         Foreground="{ThemeResource HumeTextPrimaryBrush}"
                                         Visibility="{x:Bind helpers:Format.CollapsedIf(IsSelected), Mode=OneWay}" />
                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" VerticalAlignment="Center" Foreground="{ThemeResource HumeAccentBrush}"
                                         Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                </Grid>
                <PersonPicture Width="26" Height="26" Margin="-3,0" VerticalAlignment="Center" ProfilePicture="{x:Bind Picture, Mode=OneWay}"
                               DisplayName="{x:Bind PictureName}" Visibility="{x:Bind HasPicture, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PinnedNavTemplate" x:DataType="models:MediaItem">
            <Grid ColumnSpacing="12" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:ArtworkImage Width="{StaticResource HumeArtNav}" Height="{StaticResource HumeArtNav}" DecodeSize="48"
                                       ArtworkCornerRadius="{x:Bind helpers:Format.NavArtRadius((models:MediaItem))}"
                                       PlaceholderIcon="{x:Bind helpers:Format.PlaceholderIcon((models:MediaItem))}"
                                       SourcePath="{x:Bind helpers:Format.NavThumb((models:MediaItem))}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail: a floating frosted-glass panel over the ambient backdrop, grouped like the
             Apple Music sidebar, with the library's playlists listed. It sits above the page, so rows
             scrolled to the left slide under it. -->
        <Border x:Name="RailGlass" Canvas.ZIndex="1" Margin="16,50,8,16" Background="{ThemeResource HumeGlassBrush}"
                BorderBrush="{ThemeResource HumeGlassEdgeBrush}" BorderThickness="1" CornerRadius="{StaticResource HumeRadiusGlass}">
        <!-- In a short window the rail scrolls instead of clipping; in a tall one it fills the panel, with
             Settings at the bottom (the grid is as tall as the panel at least: see OnRailScrollSizeChanged). -->
        <ScrollViewer x:Name="RailScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" IsTabStop="False" SizeChanged="OnRailScrollSizeChanged">
        <Grid x:Name="Rail" Padding="8,12,8,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The library. -->
            <StackPanel x:Name="LibraryHeader" Padding="12,4,0,14" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Shell.LibraryTitle, Mode=OneWay}" Style="{StaticResource HumeBodyStrongText}" />
                <TextBlock Text="{x:Bind Shell.ServerName, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
            </StackPanel>
            <ListView x:Name="NavList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavClick"
                      ItemContainerStyle="{StaticResource HumeNavItemStyle}" ItemTemplate="{StaticResource WideNavTemplate}"
                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Navigation" TabIndex="1">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
            <TextBlock x:Name="LibraryLabel" Grid.Row="2" Text="Library" Style="{StaticResource HumeOverlineText}" Margin="12,18,0,6" />
            <ListView x:Name="LibraryList" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavClick"
                      ItemContainerStyle="{StaticResource HumeNavItemStyle}" ItemTemplate="{StaticResource WideNavTemplate}"
                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Library">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
            <!-- Pinned: the listener's pins, one click away; the section opens and closes (remembered). -->
            <Button x:Name="PinnedHeader" Grid.Row="4" Style="{StaticResource HumeButtonBase}" Background="Transparent"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0,10,0" Margin="0,8,0,1"
                    Height="{StaticResource HumeNavItemHeight}" CornerRadius="{StaticResource HumeRadiusControl}"
                    Foreground="{ThemeResource HumeTextPrimaryBrush}" FontWeight="Medium" Click="OnPinnedHeaderClick"
                    Visibility="{x:Bind Home.HasPinned, Mode=OneWay}"
                    AutomationProperties.Name="Pinned" AutomationProperties.AutomationId="PinnedHeader">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:LucideIcon Icon="Pin" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Pinned" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center" />
                    <controls:LucideIcon x:Name="PinnedChevron" Grid.Column="2" Icon="ChevronDown" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}"
                                         Foreground="{ThemeResource HumeTextSecondaryBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <controls:LucideIcon.RenderTransform>
                            <RotateTransform x:Name="PinnedChevronRotation" />
                        </controls:LucideIcon.RenderTransform>
                    </controls:LucideIcon>
                </Grid>
            </Button>
            <!-- Pins can be dragged into any order (and moved earlier or later from their menu). -->
            <ListView x:Name="PinnedList" Grid.Row="5" helpers:Anim.Appear="True" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPinnedNavClick"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="OnPinnedReordered" ContextRequested="OnPinnedContextRequested"
                      ItemsSource="{x:Bind Home.Pinned}" ItemContainerStyle="{StaticResource HumeNavItemStyle}"
                      ItemTemplate="{StaticResource PinnedNavTemplate}" AutomationProperties.Name="Pinned items">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
            <ListView x:Name="FooterList" Grid.Row="6" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnNavClick" Margin="0,8,0,0"
                      ItemContainerStyle="{StaticResource HumeNavItemStyle}" ItemTemplate="{StaticResource WideNavTemplate}"
                      ScrollViewer.VerticalScrollMode="Disabled" AutomationProperties.Name="Settings navigation">
                <ListView.Resources><ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" /></ListView.Resources>
            </ListView>
        </Grid>
        </ScrollViewer>
        </Border>

        <!-- Content area: the page, and the queue, a second frosted panel mirroring the sidebar. The app
             opens and closes the queue itself (see ShellView.ApplyQueue): beside the page in a very wide
             window, otherwise floating over it and stopping above the player bar. -->
        <Grid x:Name="ContentHost" Grid.Column="1">
            <!-- Pages sit directly on the ambient backdrop; only panels are glass. -->
            <Grid x:Name="ContentSurface" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar: back + the app's single, persistent search field, on a light frosted strip that
                     pages scroll beneath (drawn after the frame so it sits on top). -->
                <Grid x:Name="TopBar" Height="{StaticResource HumeTopBarHeight}" VerticalAlignment="Top" Margin="{StaticResource HumeTitleBarInset}"
                      Padding="28,6,28,0" ColumnSpacing="12" Canvas.ZIndex="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The search bar floats over the page with no bar behind it: both controls are glass, so
                         content scrolls beneath them cleanly. -->
                    <!-- Top-aligned so the controls line up with the top of the sidebar panel. -->
                    <Button x:Name="BackButton" Style="{StaticResource HumeIconButtonStyle}" Click="OnBackClick" IsEnabled="False" VerticalAlignment="Top"
                            Width="{StaticResource HumeControlHeight}" Height="{StaticResource HumeControlHeight}"
                            Background="{ThemeResource HumeGlassBrush}" BorderBrush="{ThemeResource HumeGlassEdgeBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                        <controls:LucideIcon Icon="ArrowLeft" />
                    </Button>
                    <!-- Search rests as a glass circle; clicking it opens the field with a short animation and
                         puts the cursor in it straight away. It closes again when left empty. -->
                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource HumeIconButtonStyle}" Click="OnSearchButtonClick" VerticalAlignment="Top"
                            Width="{StaticResource HumeControlHeight}" Height="{StaticResource HumeControlHeight}"
                            Background="{ThemeResource HumeGlassBrush}" BorderBrush="{ThemeResource HumeGlassEdgeBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search" AutomationProperties.AutomationId="SearchButton">
                        <controls:LucideIcon Icon="Search" />
                    </Button>
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" HorizontalAlignment="Left" Visibility="Collapsed" Opacity="0" CornerRadius="{StaticResource HumeRadiusPill}"
                                    Width="{StaticResource HumeControlHeight}" LostFocus="OnSearchLostFocus"
                                    PlaceholderText="Search your library" VerticalAlignment="Top"
                                    QueryIcon="Find" TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted"
                                    ToolTipService.ToolTip="Search (Ctrl+F)"
                                    AutomationProperties.Name="Search" AutomationProperties.AutomationId="SearchBox">
                        <AutoSuggestBox.Resources>
                            <ResourceDictionary>
                                <!-- Frosted glass field, matching the sidebar and player. Defined per theme here (not as
                                     aliases) so it follows the forced-dark artist and Now Playing pages. -->
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Dark">
                                        <AcrylicBrush x:Key="TextControlBackground" TintColor="#16161B" TintOpacity="0.38" TintLuminosityOpacity="0.5" FallbackColor="#1C1B21" />
                                        <AcrylicBrush x:Key="TextControlBackgroundPointerOver" TintColor="#16161B" TintOpacity="0.3" TintLuminosityOpacity="0.45" FallbackColor="#22212A" />
                                        <AcrylicBrush x:Key="TextControlBackgroundFocused" TintColor="#16161B" TintOpacity="0.5" TintLuminosityOpacity="0.6" FallbackColor="#1C1B21" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#F4F2EE" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#B3AFA8" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#C9C5BE" />
                                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="#B3AFA8" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <AcrylicBrush x:Key="TextControlBackground" TintColor="#FFFFFF" TintOpacity="0.45" TintLuminosityOpacity="0.7" FallbackColor="#F7F6F4" />
                                        <AcrylicBrush x:Key="TextControlBackgroundPointerOver" TintColor="#FFFFFF" TintOpacity="0.55" TintLuminosityOpacity="0.75" FallbackColor="#FFFFFF" />
                                        <AcrylicBrush x:Key="TextControlBackgroundFocused" TintColor="#FFFFFF" TintOpacity="0.65" TintLuminosityOpacity="0.8" FallbackColor="#FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#80FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#99FFFFFF" />
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#1B1A1D" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5E5A55" />
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#4A4642" />
                                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="#5E5A55" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="HumeAccentBrush" />
                                <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                <StaticResource x:Key="ControlCornerRadius" ResourceKey="HumeRadiusPill" />
                                <StaticResource x:Key="TextControlThemeMinHeight" ResourceKey="HumeControlHeight" />
                                <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
                                <Thickness x:Key="TextControlThemePadding">16,9,8,9</Thickness>
                            </ResourceDictionary>
                        </AutoSuggestBox.Resources>
                    </AutoSuggestBox>
                </Grid>

                <!-- The four pages visited last stay ready; older ones are let go and reopen from what is kept on disk. -->
                <Frame x:Name="ContentFrame" Grid.RowSpan="2" IsTabStop="False" CacheSize="12" />

                <!-- Floating player: content scrolls underneath it. -->
                <views:PlayerBar x:Name="PlayerBar" Grid.Row="1" Canvas.ZIndex="2" VerticalAlignment="Bottom" Margin="32,0,32,16" />

                <!-- Notifications float over content rather than pushing the page down. -->
                <InfoBar Grid.Row="1" Canvas.ZIndex="3" Margin="32,0,32,118" MaxWidth="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         IsOpen="{x:Bind Notifications.IsOpen, Mode=TwoWay}"
                         Title="{x:Bind Notifications.Title, Mode=OneWay}"
                         Message="{x:Bind Notifications.Message, Mode=OneWay}"
                         Severity="{x:Bind Notifications.Severity, Mode=OneWay}"
                         Background="{ThemeResource HumeGlassBrush}" CornerRadius="{StaticResource HumeRadiusControl}" />
            </Grid>

            <Border x:Name="QueueGlass" Width="344" HorizontalAlignment="Right" Margin="8,50,16,16" Visibility="Collapsed" Canvas.ZIndex="4"
                    Background="{ThemeResource HumeGlassBrush}" BorderBrush="{ThemeResource HumeGlassEdgeBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource HumeRadiusGlass}">
                <Grid>
                    <views:QueuePanel x:Name="QueuePanel" />
                    <views:LyricsPanel x:Name="LyricsPanel" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- The full-screen stage (the visualizer filling the window), above everything while it is on. -->
        <views:VisualizerStage x:Name="Stage" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="50" />

    </Grid>
</UserControl>
