<Page
    x:Class="HumeMusic.Views.RadioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:vm="using:HumeMusic.ViewModels"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="PageScroller">
        <StackPanel Padding="{StaticResource HumePagePadding}" Spacing="{StaticResource HumeSectionSpacing}">
            <!-- The mix builders: build a mix from artists or albums of your choosing. -->
            <controls:PageHeader Title="Radio" Subtitle="{x:Bind ViewModel.Description, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnArtistMixBuilder" AutomationProperties.AutomationId="ArtistMixBuilderButton">
                        <controls:IconLabel Icon="Users" Text="Artist Mix Builder" />
                    </Button>
                    <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnAlbumMixBuilder" AutomationProperties.AutomationId="AlbumMixBuilderButton">
                        <controls:IconLabel Icon="Disc3" Text="Album Mix Builder" />
                    </Button>
                    <!-- Plex Pass: a journey between two tracks by sonic steps. -->
                    <Button x:Name="SonicAdventureButton" Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnSonicAdventure"
                            AutomationProperties.AutomationId="SonicAdventureButton">
                        <controls:IconLabel Icon="Route" Text="Sonic Adventure" />
                    </Button>
                </StackPanel>
            </controls:PageHeader>

            <controls:PageStateView SkeletonKind="Rows" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                    EmptyText="There are no stations for this library yet." EmptyIcon="Radio" RetryRequested="OnRetry" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource HumeSectionSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaRow">
                        <controls:MediaRowControl Header="{x:Bind Title}" Subheader="{x:Bind Subtitle}" ItemsSource="{x:Bind Items}" SeeAllCommand="{x:Bind SeeAllCommand}"
                                                  CardStyle="{x:Bind CardStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
