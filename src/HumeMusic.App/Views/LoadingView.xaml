<UserControl
    x:Class="HumeMusic.Views.LoadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <!-- The Meloday wave on its own, in the theme's text colour. -->
            <controls:MelodayMark Width="96" Height="40" Foreground="{ThemeResource HumeTextPrimaryBrush}" />
            <ProgressRing IsActive="True" Width="28" Height="28" />
            <TextBlock Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
