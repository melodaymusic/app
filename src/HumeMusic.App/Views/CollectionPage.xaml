<Page
    x:Class="HumeMusic.Views.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:models="using:HumeMusic.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The collection's backdrop from the Plex server, when it has one. -->
        <controls:BackdropLayer Grid.RowSpan="2" ScrollSource="{x:Bind ItemsGrid}" SourcePath="{x:Bind ViewModel.Collection.Art, Mode=OneWay}" />

        <controls:DetailHeader x:Name="Header" Item="{x:Bind ViewModel.Collection, Mode=OneWay}" Artwork="{x:Bind ViewModel.Collection.Thumb, Mode=OneWay}"
                               Meta="{x:Bind CollectionMeta(ViewModel.Collection), Mode=OneWay}" Description="{x:Bind ViewModel.Collection.Summary, Mode=OneWay}"
                               PlaceholderIcon="Layers" ScrollSource="{x:Bind ItemsGrid}" PlayRequested="OnPlay" ShuffleRequested="OnShuffle" />

        <!-- Items in a normal collection can be dragged into a new order; smart collections are ordered by Plex. -->
        <GridView controls:QueueDrag.IsSource="True" x:Name="ItemsGrid" Grid.Row="1" Padding="{StaticResource HumeGridPadding}"
                  CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                  AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}" DragItemsCompleted="OnItemsReordered" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource HumeTileItemStyle}" controls:ResponsiveGrid.MinItemWidth="190">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <controls:CardSlot>
                        <controls:MediaTile Item="{x:Bind}" TileSize="0" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <controls:PageStateView SkeletonKind="Tiles" SkeletonPadding="{StaticResource HumeGridPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" EmptyText="This collection is empty." EmptyIcon="Layers" />
    </Grid>
</Page>
