<UserControl
    x:Class="HumeMusic.Views.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls">

    <Grid Padding="12,16,12,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Lyrics" Style="{StaticResource HumeSectionText}" VerticalAlignment="Center" Margin="12,0,0,0" />

        <!-- Synced lyrics float, as Apple Music's do: each line glides to its place on a spring, those
             nearest the line being sung first, and lines away from it recede. Plain
             lyrics scroll as text. -->
        <Grid x:Name="Viewport" Grid.Row="1" Background="Transparent" SizeChanged="OnViewportSizeChanged">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="Lines" Padding="12,8,12,0" Spacing="22" />
            </ScrollViewer>
        </Grid>

        <controls:PageStateView x:Name="State" Grid.Row="1" EmptyIcon="MessageSquareQuote" EmptyTitle="No Lyrics"
                                EmptyText="Plex doesn't have lyrics for this song." />

        <!-- Where the lyrics came from. -->
        <TextBlock x:Name="Credit" Grid.Row="2" Style="{StaticResource HumeSecondaryText}" Foreground="{ThemeResource HumeTextTertiaryBrush}"
                   Margin="12,4,12,12" Visibility="Collapsed" />
    </Grid>
</UserControl>
