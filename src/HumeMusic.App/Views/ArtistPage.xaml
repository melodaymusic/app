<Page
    x:Class="HumeMusic.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:vm="using:HumeMusic.ViewModels"
    RequestedTheme="Dark"
    Background="Transparent">

    <!-- The page sits on the artist's Plex UltraBlur (see AmbientService.PagePalette), so it is always light-on-colour. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  ViewChanged="OnScrollChanged" AutomationProperties.AutomationId="PageScroller">
        <StackPanel Spacing="{StaticResource HumeSectionSpacing}" Padding="0,0,0,136">

            <!-- Hero: the artist image on the right dissolves into the UltraBlur backdrop. Everything else
                 sits at the bottom of it (name or logo, actions, then Plex's facts across the full width),
                 leaving the image the open space above. While the artist loads, a skeleton of the same
                 shape stands in, and the whole header appears at once when it's ready. -->
            <Grid x:Name="Hero">
                <controls:FadedArtwork x:Name="HeroImage" HorizontalAlignment="Right" VerticalAlignment="Top" FadeTop="0" />

                <StackPanel x:Name="HeroSkeleton" VerticalAlignment="Bottom" Padding="{StaticResource HumeGutterPadding}"
                            Spacing="{StaticResource HumePanelSpacing}" IsHitTestVisible="False" Visibility="Collapsed" />

                <StackPanel x:Name="HeroText" VerticalAlignment="Bottom" Padding="{StaticResource HumeGutterPadding}"
                            Spacing="{StaticResource HumePanelSpacing}">
                    <StackPanel x:Name="HeroIdentity" HorizontalAlignment="Left" Spacing="{StaticResource HumePanelSpacing}">
                        <!-- The artist's name, or their logo (fanart.tv or the listener's own). -->
                        <Grid>
                            <TextBlock x:Name="NameText" Text="{x:Bind ViewModel.Artist.Title, Mode=OneWay}" Style="{StaticResource HumeHeroText}"
                                       FontSize="{StaticResource HumeFontHeroLarge}" LineHeight="{StaticResource HumeLineHeroLarge}" Foreground="{StaticResource HumeOnColorPrimaryBrush}"
                                       TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                       VerticalAlignment="Bottom" />
                            <controls:ArtistLogo x:Name="LogoImage" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed"
                                                 AutomationProperties.AutomationId="ArtistLogo" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource HumeHeroPlayButtonStyle}" Click="OnPlay"
                                    AutomationProperties.Name="Play artist" AutomationProperties.AutomationId="PlayArtistButton">
                                <controls:IconLabel Icon="Play" IsFilled="True" Text="Play" />
                            </Button>
                            <Button Style="{StaticResource HumeGlassButtonStyle}" Click="OnShuffle" AutomationProperties.Name="Shuffle artist">
                                <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                            </Button>
                            <!-- Radio from the artist: Plex's sonic radio with Plex Pass, Meloday's own without. -->
                            <Button x:Name="SonicButton" Style="{StaticResource HumeGlassRoundButtonStyle}" Click="OnRadio"
                                    ToolTipService.ToolTip="Sonic Radio" AutomationProperties.Name="Sonic Radio">
                                <controls:LucideIcon Icon="Radio" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
                            </Button>
                            <!-- The artist's images: photo, backdrop and logo. -->
                            <Button x:Name="EditImagesButton" Style="{StaticResource HumeGlassRoundButtonStyle}" Click="OnEditImages"
                                    ToolTipService.ToolTip="Change photo, backdrop or logo" AutomationProperties.Name="Change artist images"
                                    AutomationProperties.AutomationId="EditArtistImagesButton">
                                <controls:LucideIcon Icon="Pencil" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
                            </Button>
                            <Button x:Name="MoreButton" Style="{StaticResource HumeGlassRoundButtonStyle}" Click="OnMore"
                                    ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                                <controls:LucideIcon Icon="Ellipsis" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
                            </Button>
                            <controls:StarRating Item="{x:Bind ViewModel.Artist, Mode=OneWay}" StarSize="{StaticResource HumeStarM}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Facts from Plex, four to a row across the header; anything Plex doesn't know is simply absent. -->
                    <ItemsControl x:Name="FactsList" ItemsSource="{x:Bind ViewModel.Facts}" IsTabStop="False" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:UniformColumns Columns="4" ColumnSpacing="{StaticResource HumePanelSpacing}" RowSpacing="{StaticResource HumePanelSpacing}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArtistFact">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}"
                                                         Foreground="{StaticResource HumeOnColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource HumeSecondaryText}" Foreground="{StaticResource HumeOnColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Value}" Style="{StaticResource HumeBodyStrongText}" Foreground="{StaticResource HumeOnColorPrimaryBrush}"
                                                   TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Section tabs: jump to a section; the current section is highlighted while scrolling. -->
            <Grid Padding="{StaticResource HumeGutterPadding}">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource HumeOnColorHairlineBrush}" />
                <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="24" />
            </Grid>

            <controls:PageStateView SkeletonKind="Rows" SkeletonPadding="{StaticResource HumeGutterPadding}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry" />

            <!-- Overview: Top Songs beside the latest release. -->
            <Grid x:Name="OverviewSection" Padding="{StaticResource HumeGutterPadding}" ColumnSpacing="{StaticResource HumePanelSpacing}"
                  RowSpacing="{StaticResource HumePanelSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SongsColumn" Width="3*" />
                    <ColumnDefinition x:Name="LatestColumn" Width="2*" MaxWidth="520" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="TopSongsPanel" Style="{StaticResource HumeGlassPanelStyle}"
                        Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.TopSongs.Count), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Title="Top Songs" />
                        <ListView x:Name="TopSongsList" ItemsSource="{x:Bind ViewModel.TopSongs}" SelectionMode="Single"
                                  controls:TrackListBehavior.IsEnabled="True" ItemContainerStyle="{StaticResource HumeTrackItemStyle}"
                                  Height="{StaticResource HumeTopSongsHeight}" ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Top Songs">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RankedTrack">
                                    <controls:TrackRow Track="{x:Bind Track}" Rank="{x:Bind Rank}" Mode="Ranked" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border x:Name="LatestPanel" Grid.Column="1" Style="{StaticResource HumeGlassPanelStyle}"
                        Visibility="{x:Bind helpers:Format.VisibleIfNotNull(ViewModel.LatestRelease), Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Title="Latest Release" />
                        <Button x:Name="LatestCover" Style="{StaticResource HumeTileButtonStyle}" Click="OnOpenLatest" HorizontalAlignment="Left" Margin="-10"
                                AutomationProperties.Name="{x:Bind ViewModel.LatestRelease.Title, Mode=OneWay}">
                            <controls:ArtworkImage x:Name="LatestArt" Width="{StaticResource HumeArtLatest}" Height="{StaticResource HumeArtLatest}"
                                                   DecodeSize="400" ArtworkCornerRadius="{StaticResource HumeRadiusControl}" />
                        </Button>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.LatestRelease.Title, Mode=OneWay}" Style="{StaticResource HumeHeadlineText}" Foreground="{StaticResource HumeOnColorPrimaryBrush}"
                                       TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.LatestReleaseMeta, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LatestRelease.Summary, Mode=OneWay}" Style="{StaticResource HumeParagraphText}"
                                   Foreground="{StaticResource HumeOnColorBodyBrush}" MaxLines="3" TextTrimming="WordEllipsis"
                                   Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.LatestRelease.Summary), Mode=OneWay}" />
                        <Button Style="{StaticResource HumeHeroPlayButtonStyle}" Click="OnPlayLatest" HorizontalAlignment="Left"
                                AutomationProperties.Name="Play latest release">
                            <controls:IconLabel Icon="Play" IsFilled="True" Text="Play" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Discography: Albums, Singles & EPs, Live, Compilations... -->
            <ItemsControl x:Name="AlbumsSection" ItemsSource="{x:Bind ViewModel.AlbumGroups}" Margin="{StaticResource HumeGutterPadding}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource HumeSectionSpacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumGroup">
                        <controls:MediaRowControl Header="{x:Bind Title}" ItemsSource="{x:Bind Albums}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:MediaRowControl x:Name="SimilarSection" Header="Similar Artists"
                                      ItemsSource="{x:Bind ViewModel.SimilarArtists}" Margin="{StaticResource HumeGutterPadding}"
                                      Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.SimilarArtists.Count), Mode=OneWay}" />

            <!-- The listener's playlists the artist is on, most of their songs first. -->
            <controls:MediaRowControl x:Name="PlaylistsSection" Header="Featured in Your Playlists"
                                      ItemsSource="{x:Bind ViewModel.FeaturedPlaylists}" Margin="{StaticResource HumeGutterPadding}"
                                      Visibility="{x:Bind helpers:Format.VisibleIfAny(ViewModel.FeaturedPlaylists.Count), Mode=OneWay}" />

            <!-- About: the biography beside the artist's portrait and their place in the library. -->
            <Border x:Name="AboutSection" Style="{StaticResource HumeGlassPanelStyle}" Margin="{StaticResource HumeGutterPadding}"
                    Visibility="{x:Bind ViewModel.HasAbout, Mode=OneWay}">
                <Grid x:Name="AboutGrid" ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BioColumn" Width="*" />
                        <ColumnDefinition x:Name="PortraitColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
                        <controls:SectionHeader Title="{x:Bind AboutHeader(ViewModel.Artist.Title), Mode=OneWay}" />
                        <TextBlock x:Name="SummaryText" Text="{x:Bind ViewModel.Artist.Summary, Mode=OneWay}" Style="{StaticResource HumeParagraphText}"
                                   Foreground="{StaticResource HumeOnColorBodyBrush}" MaxLines="8" TextTrimming="WordEllipsis" IsTextSelectionEnabled="True"
                                   IsTextTrimmedChanged="OnSummaryTrimmedChanged" />
                        <HyperlinkButton x:Name="SummaryToggle" Style="{StaticResource HumeMoreLinkStyle}" Content="Read More" Foreground="{StaticResource HumeOnColorPrimaryBrush}"
                                         Click="OnToggleSummary" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                        <controls:ArtworkImage x:Name="Portrait" Width="{StaticResource HumeArtArtistPortrait}" Height="{StaticResource HumeArtArtistPortrait}"
                                               DecodeSize="480" ArtworkCornerRadius="{StaticResource HumeRadiusControl}" PlaceholderIcon="MicVocal" />
                        <!-- The artist's place in the listener's own library, by plays (Settings chooses how far down it goes). -->
                        <TextBlock Text="{x:Bind ViewModel.RankText, Mode=OneWay}" Style="{StaticResource HumeBodyStrongText}" Foreground="{StaticResource HumeOnColorPrimaryBrush}"
                                   Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.RankText), Mode=OneWay}"
                                   AutomationProperties.AutomationId="ArtistRank" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- States follow the page's own width (see LayoutHero), so they respect the sidebar and the interface size. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState" />
                <VisualState x:Name="MediumState" />
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <!-- Stack: latest release below the songs, no portrait. -->
                        <Setter Target="LatestPanel.(Grid.Column)" Value="0" />
                        <Setter Target="LatestPanel.(Grid.Row)" Value="1" />
                        <Setter Target="LatestColumn.Width" Value="0" />
                        <Setter Target="Portrait.Visibility" Value="Collapsed" />
                        <Setter Target="PortraitColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>

</Page>
