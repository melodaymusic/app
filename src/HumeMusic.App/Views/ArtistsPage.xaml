<Page
    x:Class="HumeMusic.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:vm="using:HumeMusic.ViewModels"
    xmlns:models="using:HumeMusic.Core.Models"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Padding="{StaticResource HumePageHeaderPadding}" Title="Artists" Subtitle="{x:Bind ViewModel.CountText, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:LayoutToggle x:Name="Layout" PageKey="artists" />
                <controls:SortButton Options="{x:Bind ViewModel.SortOptions}" Selected="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
            </StackPanel>
        </controls:PageHeader>

        <GridView controls:QueueDrag.IsSource="True" x:Name="Grid" Grid.Row="1" Padding="{StaticResource HumeGridPadding}"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource HumeTileItemStyle}" controls:ResponsiveGrid.MinItemWidth="190"
                  IncrementalLoadingThreshold="3" DataFetchSize="2"
                  AutomationProperties.Name="Artists" AutomationProperties.AutomationId="ArtistsGrid">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Artist">
                    <controls:CardSlot>
                        <controls:MediaTile Item="{x:Bind}" TileSize="0" />
                    </controls:CardSlot>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- The same items as rows: a list view of the page (the toggle in the header chooses). -->
        <ListView x:Name="ItemList" Grid.Row="1" Visibility="Collapsed" Padding="{StaticResource HumeListPadding}"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" controls:QueueDrag.IsSource="True"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemContainerStyle="{StaticResource HumeTrackItemStyle}"
                  IncrementalLoadingThreshold="3" DataFetchSize="2"
                  AutomationProperties.Name="Artists list" AutomationProperties.AutomationId="ArtistsList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Artist">
                    <controls:MediaListRow Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:PageStateView SkeletonKind="Tiles" SkeletonRound="True" SkeletonPadding="{StaticResource HumeGridPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                EmptyText="No artists in this library yet." EmptyIcon="MicVocal" RetryRequested="OnRetry" />
    </Grid>
</Page>
