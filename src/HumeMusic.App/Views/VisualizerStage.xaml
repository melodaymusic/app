<UserControl
    x:Class="HumeMusic.Views.VisualizerStage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    IsTabStop="True"
    Visibility="Collapsed">

    <!--
        The full-screen stage: the visualizer fills the window, on the same backdrop as the rest of the interface (the
        window's own ambient colour; the interface itself is hidden while the stage is on). The controls (the song, the picture's menu, play/stop, leave) appear on movement and fade away after a few
        seconds of stillness, leaving only the picture.
    -->
    <Grid x:Name="Root" PointerMoved="OnActivity" PointerPressed="OnActivity" KeyDown="OnKeyDown">
        <controls:VisualizerView x:Name="View" />

        <Grid x:Name="Chrome" Opacity="0" IsHitTestVisible="False">
            <Border VerticalAlignment="Top" Height="170" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#99000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border VerticalAlignment="Bottom" Height="170" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#99000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="56,44,56,0" Spacing="2" IsHitTestVisible="False">
                <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource HumeTitleText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Player.Artist, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Spacing="14">
                <controls:VisualizerButton Width="{StaticResource HumeButtonL}" Height="{StaticResource HumeButtonL}" IconSize="{StaticResource HumeIconL}" />
                <Button Style="{StaticResource HumePlayButtonStyle}" Width="{StaticResource HumeButtonXXL}" Height="{StaticResource HumeButtonXXL}"
                        Command="{x:Bind Player.PlayPauseCommand}" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Player.PlayPauseLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind Player.PlayPauseLabel, Mode=OneWay}"
                        AutomationProperties.AutomationId="StagePlayPause">
                    <controls:LucideIcon Icon="{x:Bind Player.PlayPauseIcon, Mode=OneWay}" IsFilled="True" Width="{StaticResource HumeIconXXL}" Height="{StaticResource HumeIconXXL}" />
                </Button>
                <Button Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonL}" Height="{StaticResource HumeButtonL}" Click="OnExit"
                        ToolTipService.ToolTip="Leave full screen (Esc)" AutomationProperties.Name="Leave full screen" AutomationProperties.AutomationId="StageExit">
                    <controls:LucideIcon Icon="Minimize2" Width="{StaticResource HumeIconL}" Height="{StaticResource HumeIconL}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
