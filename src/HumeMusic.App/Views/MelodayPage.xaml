<Page
    x:Class="HumeMusic.Views.MelodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:models="using:HumeMusic.Core.Models"
    Background="Transparent">

    <!-- Meloday: the mix for this part of the day, laid out like a playlist. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:DetailHeader x:Name="Header" Item="{x:Bind ViewModel.Item, Mode=OneWay}" Artwork="{x:Bind ViewModel.Cover, Mode=OneWay}"
                               Meta="{x:Bind ViewModel.Meta, Mode=OneWay}" Description="{x:Bind ViewModel.Description, Mode=OneWay}"
                               PlaceholderIcon="AudioWaveform" ScrollSource="{x:Bind TrackList}" PlayRequested="OnPlay" ShuffleRequested="OnShuffle"
                               StatusText="{x:Bind ViewModel.PlexStatus, Mode=OneWay}">
            <!-- Keep it on the Plex server: one playlist, updated with each new Meloday. -->
            <controls:DetailHeader.ExtraActions>
                <controls:PlexSyncButton IsOn="{x:Bind ViewModel.KeepOnPlex, Mode=TwoWay}" />
            </controls:DetailHeader.ExtraActions>
            <!-- The cover, live: the part of the day's sun breathing behind the mix's name. -->
            <controls:DetailHeader.LiveCover>
                <controls:MelodayArt Period="{x:Bind ViewModel.Period, Mode=OneWay}" Title="{x:Bind ViewModel.CoverTitle, Mode=OneWay}" />
            </controls:DetailHeader.LiveCover>
        </controls:DetailHeader>

        <ListView x:Name="TrackList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tracks}" Padding="{StaticResource HumeListPadding}"
                  SelectionMode="Extended" controls:TrackListBehavior.IsEnabled="True"
                  ItemContainerStyle="{StaticResource HumeTrackItemStyle}"
                  AutomationProperties.Name="Meloday tracks" AutomationProperties.AutomationId="MelodayTrackList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <controls:TrackRow Track="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:PageStateView SkeletonKind="Tracks" SkeletonPadding="{StaticResource HumeListPadding}" Grid.Row="1" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" RetryRequested="OnRetry"
                                IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" EmptyText="There isn't enough listening history for a Meloday yet." EmptyIcon="AudioWaveform" />
    </Grid>
</Page>
