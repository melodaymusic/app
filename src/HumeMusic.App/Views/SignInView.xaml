<UserControl
    x:Class="HumeMusic.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers">

    <Grid Background="{ThemeResource HumeContentBrush}" CornerRadius="{StaticResource HumeRadiusSurface}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="440" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <Image Source="ms-appx:///Assets/MelodayMusic-app.png" Width="88" Height="88" HorizontalAlignment="Left" />
                <StackPanel Spacing="8">
                    <TextBlock Text="Welcome to Meloday Music" Style="{StaticResource HumeTitleText}" TextWrapping="WrapWholeWords" />
                    <TextBlock Style="{StaticResource HumeParagraphText}"
                               Text="Sign in with your Plex account to play and explore the music on your Plex Media Server. You'll approve Meloday Music in your browser — your password never passes through this app." />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource HumeParagraphText}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.StatusMessage), Mode=OneWay}" />

                <!-- Idle -->
                <Button Style="{StaticResource HumePrimaryButtonStyle}" HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.IsWaiting), Mode=OneWay}"
                        AutomationProperties.AutomationId="SignInButton">
                    <controls:IconLabel Icon="User" Text="Sign In with Plex" />
                </Button>

                <!-- Waiting for approval -->
                <StackPanel Spacing="16" helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIf(ViewModel.IsWaiting), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" Width="20" Height="20" />
                        <TextBlock Text="Waiting for you to approve Meloday Music in your browser…" Style="{StaticResource HumeBodyText}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Open the Plex Page Again" Command="{x:Bind ViewModel.OpenBrowserAgainCommand}" />
                        <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                    </StackPanel>
                </StackPanel>

                <InfoBar Severity="Error" IsClosable="False" IsOpen="True"
                         helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.ErrorMessage), Mode=OneWay}"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
