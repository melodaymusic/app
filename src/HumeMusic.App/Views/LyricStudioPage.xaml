<Page
    x:Class="HumeMusic.Views.LyricStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource HumePageHeaderPadding}" Eyebrow="Lyric Studio" Title="">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Style="{StaticResource HumePrimaryButtonStyle}" Click="OnSave" IsEnabled="False"
                        AutomationProperties.AutomationId="StudioSaveButton">
                    <controls:IconLabel Icon="Check" Text="Save timing" />
                </Button>
                <Button x:Name="OriginalButton" Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnUseOriginal" Visibility="Collapsed"
                        AutomationProperties.AutomationId="StudioOriginalButton">
                    <controls:IconLabel Icon="ListRestart" Text="Use original timing" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="{StaticResource HumeDetailContentPadding}" Spacing="{StaticResource HumeSectionSpacing}" MaxWidth="980" HorizontalAlignment="Left">

                <!-- The words, and how they are tapped. -->
                <Border x:Name="SetupPanel" Style="{StaticResource HumeGlassPanelStyle}">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Title="The words" Subtitle="One line to a line. Change them if they are wrong, or paste them if the song has none." />
                        <TextBox x:Name="LyricsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" MaxHeight="300"
                                 PlaceholderText="Paste the lyrics here" AutomationProperties.AutomationId="StudioLyricsBox"
                                 TextChanged="OnLyricsChanged" />
                        <TextBlock x:Name="SourceNote" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="ModeBox" MinWidth="220" SelectedIndex="0" AutomationProperties.Name="Tap for each"
                                      AutomationProperties.AutomationId="StudioModeBox">
                                <ComboBoxItem Content="Tap for each word" />
                                <ComboBoxItem Content="Tap for each line" />
                            </ComboBox>
                            <Button x:Name="StartButton" Style="{StaticResource HumePrimaryButtonStyle}" Click="OnStart" IsEnabled="False"
                                    AutomationProperties.AutomationId="StudioStartButton">
                                <controls:IconLabel Icon="Play" IsFilled="True" Text="Start timing" />
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                   Text="The song plays from the start. Press the space bar as each word begins, and keep it down through a word that is held on a long note. Words are the most exact; lines are quicker (press once as each line begins, and the words in it are spaced for you)." />
                    </StackPanel>
                </Border>

                <!-- Timing: the song plays, and each tap marks the next word. -->
                <Border x:Name="TimingPanel" Style="{StaticResource HumeGlassPanelStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource HumeSecondaryText}" AutomationProperties.AutomationId="StudioProgress" />

                        <!-- The word to press for, or the one being held: it fills as the space bar is held down. -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="NowWord" Style="{StaticResource HumeHeroText}" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="StudioNowWord" />
                            <ProgressBar x:Name="HoldBar" Minimum="0" Maximum="1" Value="0" Height="8" Opacity="0" HorizontalAlignment="Left" Width="420"
                                         AutomationProperties.AutomationId="StudioHoldBar" />
                            <TextBlock x:Name="NowHint" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="StudioNowHint" />
                        </StackPanel>

                        <StackPanel x:Name="Context" Spacing="8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TapButton" Style="{StaticResource HumePrimaryButtonStyle}" MinWidth="220" Click="OnTap"
                                    AutomationProperties.AutomationId="StudioTapButton">
                                <controls:IconLabel Icon="Timer" Text="Tap" />
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnPlayPause" AutomationProperties.AutomationId="StudioPlayButton">
                                <controls:IconLabel x:Name="PlayLabel" Icon="Pause" Text="Pause" />
                            </Button>
                            <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnUndo" AutomationProperties.AutomationId="StudioUndoButton">
                                <controls:IconLabel Icon="ListRestart" Text="Undo" />
                            </Button>
                            <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnBack" AutomationProperties.AutomationId="StudioBackButton">
                                <controls:IconLabel Icon="SkipBack" Text="Back 5 s" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" AutomationProperties.AutomationId="StudioStatus" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnStartOver" AutomationProperties.AutomationId="StudioStartOverButton">
                                <controls:IconLabel Icon="RefreshCw" Text="Start over" />
                            </Button>
                            <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnEditWords" AutomationProperties.AutomationId="StudioEditWordsButton">
                                <controls:IconLabel Icon="Pencil" Text="Change the words" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
