<Page
    x:Class="HumeMusic.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:models="using:HumeMusic.Core.Models"
    xmlns:helpers="using:HumeMusic.Helpers"
    xmlns:services="using:HumeMusic.Services"
    xmlns:vm="using:HumeMusic.ViewModels"
    Background="Transparent">

    <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="PageScroller">
        <StackPanel Padding="{StaticResource HumePagePadding}" Spacing="32">
            <controls:PageHeader Title="Settings" />

            <!-- One section of settings at a time. -->
            <controls:ChipTabs x:Name="SectionTabs" AutomationLabel="Settings sections" Margin="0,-16,0,0" />

            <!-- Appearance & storage -->
            <StackPanel x:Name="AppearanceGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Appearance and Storage" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Palette" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Theme" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2" MinWidth="220" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                      SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="Theme" />
                        </Grid>
                        <!-- Motion: every moving thing in the app (station artwork, the intro, fades, slides, hovers). -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Wind" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Motion" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.MotionNote, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MotionEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Motion" AutomationProperties.AutomationId="MotionToggle" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ImageOff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Artwork cache" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Clear Cache" Command="{x:Bind ViewModel.ClearCacheCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <!-- Downloads: songs kept on this computer for offline listening. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="CircleArrowDown" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Downloads" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.DownloadsText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Remove All" Command="{x:Bind ViewModel.RemoveDownloadsCommand}" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RemoveDownloadsButton" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Home: the listener's own arrangement of Home, independent of Plex's hub order. -->
            <StackPanel x:Name="HomeGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Home" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Sparkles" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Jump back in" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="The last thing you played, large at the top of Home, with the eight before it beside it" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Layout.ShowJumpBackIn, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Show Jump back in" AutomationProperties.AutomationId="JumpBackInToggle" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="LayoutList" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Sections" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Drag or use the arrows to reorder; switch a section off to hide it" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Reset" Click="OnResetHome" VerticalAlignment="Center"
                                    AutomationProperties.Name="Reset Home sections" />

                            <ListView x:Name="SectionsList" Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{x:Bind Layout.Sections}"
                                      SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                      DragItemsCompleted="OnSectionsReordered" ScrollViewer.VerticalScrollMode="Disabled"
                                      AutomationProperties.Name="Home sections" AutomationProperties.AutomationId="HomeSections">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="MinHeight" Value="{StaticResource HumeNavItemHeight}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:HomeSection">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:LucideIcon Icon="GripVertical" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}"
                                                                 Foreground="{ThemeResource HumeTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center"
                                                           Opacity="{x:Bind helpers:Format.DimIfOff(IsShown), Mode=OneWay}" />

                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonXS}" Height="{StaticResource HumeButtonXS}"
                                                    Click="OnMoveUp" Tag="{x:Bind}" ToolTipService.ToolTip="Move up" AutomationProperties.Name="{x:Bind MoveUpLabel}">
                                                <controls:LucideIcon Icon="ChevronUp" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" />
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonXS}" Height="{StaticResource HumeButtonXS}"
                                                    Click="OnMoveDown" Tag="{x:Bind}" ToolTipService.ToolTip="Move down" AutomationProperties.Name="{x:Bind MoveDownLabel}">
                                                <controls:LucideIcon Icon="ChevronDown" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" />
                                            </Button>
                                            <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsShown, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                          AutomationProperties.Name="{x:Bind ShowLabel}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Account -->
            <StackPanel x:Name="AccountGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Plex Account" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="User" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.AccountDetail, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Sign Out" Command="{x:Bind ViewModel.SignOutCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- What Plex Pass unlocks in Meloday Music: locked or unlocked for this account, and what plays instead. -->
            <StackPanel x:Name="PlexPassGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Plex Pass" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:PlexPassBadge VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.PlexPassStatus, Mode=OneWay}" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="These are part of Plex Pass. Where Meloday Music can do the same without it, it does."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <HyperlinkButton Grid.Column="2" Content="About Plex Pass" NavigateUri="https://www.plex.tv/plex-pass/" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PlexPassFeatures, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="What Plex Pass unlocks">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlexPassFeature">
                                    <Grid Style="{StaticResource HumeGroupRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Top">
                                            <controls:LucideIcon Icon="LockOpen" Foreground="{ThemeResource HumeAccentBrush}"
                                                                 Visibility="{x:Bind helpers:Format.VisibleIf(Unlocked)}" />
                                            <controls:LucideIcon Icon="Lock" Foreground="{ThemeResource HumeTextTertiaryBrush}"
                                                                 Visibility="{x:Bind helpers:Format.CollapsedIf(Unlocked)}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource HumeBodyText}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind State}" Style="{StaticResource HumeSecondaryText}" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Sound Check and AutoMix lean on the server's loudness analysis, a different thing. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Info" Foreground="{ThemeResource HumeTextTertiaryBrush}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                       Text="Sound Check and AutoMix's timing use the loudness analysis your Plex server runs (turned on in its Library settings). Without it, songs play at their own level and AutoMix is a plain crossfade." />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Server & library -->
            <StackPanel x:Name="LibraryGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Server and Library" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Server" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Plex Media Server" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.ServerVersion, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="220" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Servers}"
                                      SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}" AutomationProperties.Name="Plex server">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlexServer">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Globe" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Connection" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Reconnect" Command="{x:Bind ViewModel.ReconnectCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Library" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Music library" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="The Plex library Meloday Music shows" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="220" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Sections}"
                                      SelectedItem="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}" AutomationProperties.Name="Music library">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:MusicSection">
                                        <TextBlock Text="{x:Bind Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- Keeping in step with the library: Meloday Music keeps what Plex sends so pages open at once,
                             and checks it whenever Plex says the library changed. These are for doing it by hand. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="RefreshCw" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Keep In Step With Your Library" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.LibraryCacheText, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Scan for New Music" Command="{x:Bind ViewModel.ScanLibraryCommand}"
                                        ToolTipService.ToolTip="Ask Plex to look through your music folders for music added, changed or removed"
                                        AutomationProperties.AutomationId="ScanLibraryButton" />
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Refresh Library" Command="{x:Bind ViewModel.RefreshLibraryCommand}"
                                        ToolTipService.ToolTip="Load everything from Plex again"
                                        AutomationProperties.AutomationId="RefreshLibraryButton" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Playback -->
            <StackPanel x:Name="PlaybackGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Playback" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Gauge" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Streaming quality" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Original quality plays your files as they are and falls back to Plex transcoding when Windows can't decode a format." Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="220" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.QualityOptions}"
                                      SelectedIndex="{x:Bind ViewModel.QualityIndex, Mode=TwoWay}" AutomationProperties.Name="Streaming quality" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="AudioWaveform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Transcoding bitrate" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="MP3 bitrate (kbps) used whenever Plex transcodes" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="120" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.BitrateOptions}"
                                      SelectedItem="{x:Bind ViewModel.Bitrate, Mode=TwoWay}" AutomationProperties.Name="Transcoding bitrate" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="History" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Report listening to Plex" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Updates play counts, history and Now Playing on your Plex server" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ReportPlayback, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Report listening to Plex" />
                        </Grid>
                        <!-- Last.fm: scrobbling with the listener's own API account. Plex can scrobble for them instead. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:LucideIcon Icon="AudioLines" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Last.fm" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Connect your own Last.fm API account to scrobble what you play and to see what's trending. Each is its own switch." />
                                    <Hyperlink NavigateUri="https://www.last.fm/api/account/create">Create one</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="Already scrobbling through Plex? If your Plex account is linked to Last.fm, leave this blank and make sure Report listening to Plex (above) is on: Plex scrobbles for you, and connecting here too would count every song twice." />
                            </StackPanel>
                            <!-- Connected: who is scrobbling, and a way to stop. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                        helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.LastFmConnected, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.LastFmUser, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Disconnect" Command="{x:Bind ViewModel.DisconnectLastFmCommand}"
                                        AutomationProperties.AutomationId="DisconnectLastFm" />
                            </StackPanel>
                            <!-- Connected: what Last.fm may do, each its own switch and off until turned on. -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="12" Margin="0,12,0,0"
                                        helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.LastFmConnected, Mode=OneWay}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Scrobble what I play" Style="{StaticResource HumeBodyText}" />
                                        <TextBlock Text="Send each song to Last.fm once you've played half of it. Nothing is sent while this is off." Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LastFmScrobble, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Scrobble what I play" AutomationProperties.AutomationId="LastFmScrobbleToggle" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Show what's trending" Style="{StaticResource HumeBodyText}" />
                                        <TextBlock Text="Show the songs on Last.fm's chart that are in your library on Home. Only the chart is read; nothing about you is sent." Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LastFmTrending, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Show what's trending" AutomationProperties.AutomationId="LastFmTrendingToggle" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8" Margin="0,8,0,0"
                                        helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.LastFmConnected), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PasswordBox x:Name="LastFmKeyBox" Width="240" PlaceholderText="API key" PasswordRevealMode="Peek"
                                                 AutomationProperties.Name="Last.fm API key" AutomationProperties.AutomationId="LastFmKeyBox" />
                                    <PasswordBox x:Name="LastFmSecretBox" Width="240" PlaceholderText="Shared secret" PasswordRevealMode="Peek"
                                                 AutomationProperties.Name="Last.fm shared secret" AutomationProperties.AutomationId="LastFmSecretBox" />
                                    <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="{x:Bind ViewModel.LastFmButtonText, Mode=OneWay}" Click="OnConnectLastFm"
                                            AutomationProperties.AutomationId="ConnectLastFm" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.LastFmStatus, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.LastFmStatus), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ListRestart" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Restore queue on launch" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Pick up where you left off when Meloday Music starts" Style="{StaticResource HumeSecondaryText}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.RestoreQueue, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Restore queue on launch" />
                        </Grid>
                        <!-- Transitions: none, a crossfade of a set length, or AutoMix (shaped to each pair of songs). -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Blend" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Transitions" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.TransitionNote, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.TransitionOptions}"
                                      SelectedIndex="{x:Bind ViewModel.TransitionIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Transitions" AutomationProperties.AutomationId="TransitionsBox" />
                        </Grid>
                        <!-- Crossfade length (crossfade only; AutoMix sizes each transition itself). -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}" Visibility="{x:Bind ViewModel.IsCrossfade, Mode=OneWay}" helpers:Anim.Appear="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Timer" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Crossfade length" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Slider Width="160" VerticalAlignment="Center" Minimum="{x:Bind ViewModel.CrossfadeMinimum}" Maximum="{x:Bind ViewModel.CrossfadeMaximum}"
                                        StepFrequency="1" SmallChange="1" LargeChange="2" Value="{x:Bind ViewModel.CrossfadeSeconds, Mode=TwoWay}" IsThumbToolTipEnabled="False"
                                        AutomationProperties.Name="Crossfade length" AutomationProperties.AutomationId="CrossfadeSlider" />
                                <TextBlock Text="{x:Bind ViewModel.CrossfadeText, Mode=OneWay}" Style="{StaticResource HumeBodyStrongText}" MinWidth="36"
                                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                        <!-- Sound Check: every song at the same loudness (Plex's gain analysis). -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Volume2" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Sound Check" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Play every song at the same volume, using Plex's loudness analysis" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.SoundCheck, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Sound Check" AutomationProperties.AutomationId="SoundCheckToggle" />
                        </Grid>
                        <!-- Live radio feedback: songs taken off a station with "not for this station". -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ThumbsDown" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Live Station Feedback" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.FeedbackSummary, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Reset" Command="{x:Bind ViewModel.ResetFeedbackCommand}" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ResetFeedbackButton" />
                        </Grid>
                        <!-- Remote control: Plex apps on this network can find and control this player. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Smartphone" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Control From Your Phone" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Plex and Plexamp on this network can play to Meloday Music and work its controls. Choose this computer as the player in the app." Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.RemoteControl, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Control from your phone" AutomationProperties.AutomationId="RemoteControlToggle" />
                        </Grid>
                        <!-- Song notifications: a quiet notification as each song starts, while the app is in the background. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Bell" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Song Notifications" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="A quiet notification as each song starts, while Meloday Music is in the background" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.TrackNotifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Song notifications" AutomationProperties.AutomationId="TrackNotificationsToggle" />
                        </Grid>
                        <!-- Lyrics from LRCLIB when Plex has none. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="MessageSquareQuote" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Lyrics From LRCLIB" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="When Plex has no lyrics for a song, or only unsynced ones, look them up on LRCLIB, the open lyrics database. Only the song's title, artist, album and length are sent."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.LyricsFallback, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Lyrics from LRCLIB" AutomationProperties.AutomationId="LyricsFallbackToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Meloday: a mix for each part of the day. AI titles are optional, with the listener's own OpenAI key. -->
            <StackPanel x:Name="MelodayGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Meloday" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Sparkles" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AI titles" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Name each Meloday with OpenAI (gpt-4.1-mini) in the style of a daylist, instead of Meloday's own wording. Needs your OpenAI key."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MelodayAiTitles, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="AI titles" AutomationProperties.AutomationId="MelodayAiToggle" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:LucideIcon Icon="KeyRound" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="OpenAI API key" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Used only to name your Meloday. Your key is stored encrypted on this PC and sent only to OpenAI." />
                                    <Hyperlink NavigateUri="https://platform.openai.com/api-keys">Get a key</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <!-- Saved: the key is never shown again, only that one is kept. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                        helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.HasAiKey, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <controls:LucideIcon Icon="Check" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" Foreground="{ThemeResource HumeTextSecondaryBrush}" />
                                    <TextBlock Text="Key saved" Style="{StaticResource HumeSecondaryText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Remove" Command="{x:Bind ViewModel.RemoveAiKeyCommand}"
                                        AutomationProperties.Name="Remove OpenAI key" AutomationProperties.AutomationId="RemoveOpenAiKey" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12" helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.NeedsAiKey, Mode=OneWay}">
                                    <PasswordBox x:Name="OpenAiKeyBox" Width="320" PlaceholderText="Paste your API key" PasswordRevealMode="Peek"
                                                 AutomationProperties.Name="OpenAI API key" AutomationProperties.AutomationId="OpenAiKeyBox" KeyDown="OnOpenAiKeyDown" />
                                    <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Save" Click="OnSaveOpenAiKey"
                                            IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsCheckingAiKey), Mode=OneWay}"
                                            AutomationProperties.AutomationId="SaveOpenAiKey" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingAiKey, Mode=OneWay}" Width="18" Height="18" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.AiKeyStatus, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.AiKeyStatus), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="X" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Words titles never use" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="For AI titles; separate them with commas" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Width="260" VerticalAlignment="Center" Text="{x:Bind ViewModel.MelodayAvoidWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnAvoidWordsDone" KeyDown="OnAvoidWordsKeyDown"
                                     AutomationProperties.Name="Words titles never use" AutomationProperties.AutomationId="MelodayAvoidWords" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Tags" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Genres to skip" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Meloday leaves out music in these genres (any genre containing the word); separate them with commas"
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Width="260" VerticalAlignment="Center" Text="{x:Bind ViewModel.MelodaySkipGenres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnSkipGenresDone" KeyDown="OnSkipGenresKeyDown"
                                     AutomationProperties.Name="Genres Meloday skips" AutomationProperties.AutomationId="MelodaySkipGenres" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="ListMusic" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Keep it as a playlist on Plex" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Also keep your current Meloday as a playlist on your Plex server, for other apps. It's replaced with each new Meloday."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.MelodayPlexPlaylist, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Keep Meloday as a playlist on Plex" AutomationProperties.AutomationId="MelodayPlexToggle" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Dupes: songs said to be the same song; the one that plays stands in for the other in every Meloday. -->
            <StackPanel x:Name="DupesGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Dupes" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Merge" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Songs that are the same song" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="{x:Bind ViewModel.DupesSummary, Mode=OneWay}" AutomationProperties.AutomationId="DupesSummary" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" Margin="16,4,16,12"
                                   Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.HasDupes), Mode=OneWay}"
                                   Text="On a Meloday, press the merge button on a song's row when it is the same song as another, and choose which one plays. It then appears here." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Dupes}" AutomationProperties.AutomationId="DupeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DupeRow">
                                    <Grid Style="{StaticResource HumeGroupRowStyle}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The song that plays, and (dimmer) the one it stands in for. -->
                                        <StackPanel Orientation="Horizontal" Spacing="-14" VerticalAlignment="Center">
                                            <controls:ArtworkImage Width="48" Height="48" DecodeSize="96" SourcePath="{x:Bind KeeperThumb}"
                                                                   ArtworkCornerRadius="{StaticResource HumeRadiusThumb}" PlaceholderIcon="Music" Canvas.ZIndex="1" />
                                            <controls:ArtworkImage Width="48" Height="48" DecodeSize="96" SourcePath="{x:Bind DupeThumb}" Opacity="0.55"
                                                                   ArtworkCornerRadius="{StaticResource HumeRadiusThumb}" PlaceholderIcon="Music" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Style="{StaticResource HumeBodyStrongText}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind KeeperTitle}" /><Run Text=" plays" Foreground="{StaticResource HumeTextSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind KeeperDetails}" Style="{StaticResource HumeSecondaryText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource HumeSecondaryText}" TextTrimming="CharacterEllipsis">
                                                <Run Text="in place of " /><Run Text="{x:Bind DupeTitle}" /><Run Text=" · " /><Run Text="{x:Bind DupeDetails}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Unmerge" VerticalAlignment="Center"
                                                Click="OnUnmerge"
                                                AutomationProperties.Name="{x:Bind Unmerge}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Muting: songs and artists kept out of Meloday for a while (without rating them down), and for how long. -->
            <StackPanel x:Name="MutingGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Muting" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="BellOff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="How long to mute" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="A muted song or artist stays out of Meloday, mixes, live stations and radios for this long, then comes back. Songs you choose yourself still play."
                                           AutomationProperties.AutomationId="MuteLengthNote" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox MinWidth="160" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.MuteLengthOptions}"
                                          SelectedIndex="{x:Bind ViewModel.MuteLengthIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="How long to mute" AutomationProperties.AutomationId="MuteLength" />
                                <NumberBox Width="120" VerticalAlignment="Center" Minimum="1" Maximum="365" SmallChange="1" LargeChange="7"
                                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MuteCustomDays, Mode=TwoWay}"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.IsCustomMute, Mode=OneWay}"
                                           AutomationProperties.Name="Days to mute" AutomationProperties.AutomationId="MuteCustomDays" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" Margin="16,0,16,12"
                                   Text="{x:Bind ViewModel.MuteLengthSummary, Mode=OneWay}" AutomationProperties.AutomationId="MuteLengthSummary" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Muted now" Style="{StaticResource HumeGroupHeaderText}" Margin="0,16,0,0" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="BellOff" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Songs and artists kept out of Meloday" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           Text="{x:Bind ViewModel.MutedSummary, Mode=OneWay}" AutomationProperties.AutomationId="MutedSummary" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" Margin="16,4,16,12"
                                   Visibility="{x:Bind helpers:Format.CollapsedIf(ViewModel.HasMuted), Mode=OneWay}"
                                   Text="On Now Playing, press Mute to keep the song that is playing, or its artist, out of Meloday for a while. It then appears here, until its time is up or you unmute it." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Muted}" AutomationProperties.AutomationId="MutedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MuteRow">
                                    <Grid Style="{StaticResource HumeGroupRowStyle}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:LucideIcon Icon="{x:Bind Icon}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource HumeBodyStrongText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource HumeSecondaryText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Remaining}" Style="{StaticResource HumeSecondaryText}" Foreground="{ThemeResource HumeTextTertiaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Unmute" VerticalAlignment="Center"
                                                Click="OnUnmute" AutomationProperties.Name="{x:Bind Unmute}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Artist pages: fanart.tv logos in place of artist names (with the listener's own API key), and library ranks. -->
            <StackPanel x:Name="ArtistGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="Artist Pages" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:LucideIcon Icon="KeyRound" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="fanart.tv API key" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Artist logos come from fanart.tv. Your personal key is stored encrypted on this PC." />
                                    <Hyperlink NavigateUri="https://fanart.tv/get-an-api-key/">Get a free key</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <!-- Saved: the key is never shown again, only that one is kept. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                        helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.HasLogoKey, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <controls:LucideIcon Icon="Check" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" Foreground="{ThemeResource HumeTextSecondaryBrush}" />
                                    <TextBlock Text="Key saved" Style="{StaticResource HumeSecondaryText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Remove" Command="{x:Bind ViewModel.RemoveLogoKeyCommand}"
                                        AutomationProperties.Name="Remove fanart.tv key" AutomationProperties.AutomationId="RemoveFanartKey" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12" helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.NeedsLogoKey, Mode=OneWay}">
                                    <PasswordBox x:Name="FanartKeyBox" Width="320" PlaceholderText="Paste your API key" PasswordRevealMode="Peek"
                                                 AutomationProperties.Name="fanart.tv API key" AutomationProperties.AutomationId="FanartKeyBox" KeyDown="OnFanartKeyDown" />
                                    <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Save" Click="OnSaveFanartKey"
                                            IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsCheckingLogoKey), Mode=OneWay}"
                                            AutomationProperties.AutomationId="SaveFanartKey" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingLogoKey, Mode=OneWay}" Width="18" Height="18" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.LogoKeyStatus, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.LogoKeyStatus), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Signature" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Show artist logos" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Use the artist's logo instead of their name on artist pages. Change an artist's logo from the … menu on their page."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.ShowArtistLogos, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0"
                                          AutomationProperties.Name="Show artist logos" AutomationProperties.AutomationId="ArtistLogosToggle" />
                        </Grid>
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="Palette" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Logo colours" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Colour Drop paints each logo in its artist page's colour, like the buttons. Original shows logos as they were made."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.LogoColourOptions}"
                                      SelectedIndex="{x:Bind ViewModel.LogoColoursIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ShowArtistLogos, Mode=OneWay}"
                                      AutomationProperties.Name="Logo colours" AutomationProperties.AutomationId="LogoColoursBox" />
                        </Grid>
                        <!-- The listener's own logo files, many artists at once: copied into the app, never uploaded or shipped. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="FolderOpen" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Your own logos" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Choose a folder with a folder or image for each artist, named after them. Logos are copied into Meloday Music and matched to artists by name."
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind ViewModel.LogoImportStatus, Mode=OneWay}" Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" Margin="0,4,0,0"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind helpers:Format.VisibleIfText(ViewModel.LogoImportStatus), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsImportingLogos, Mode=OneWay}" Width="18" Height="18" />
                                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Content="Import Logos…" Click="OnImportLogos"
                                        IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsImportingLogos), Mode=OneWay}"
                                        AutomationProperties.Name="Import logos" AutomationProperties.AutomationId="ImportLogos" />
                            </StackPanel>
                        </Grid>
                        <!-- "#3 in your library" under the artist's photo: for the top N artists by plays, every artist, or none. -->
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:LucideIcon Icon="TrendingUp" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Artist rankings" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="Show an artist's place in your library by plays, like &#x201C;#3 in your library&#x201D;, in the About section of their page"
                                           Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox MinWidth="160" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.ArtistRankOptions}"
                                          SelectedIndex="{x:Bind ViewModel.ArtistRankModeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Artist rankings" AutomationProperties.AutomationId="ArtistRankMode" />
                                <NumberBox Width="120" VerticalAlignment="Center" Minimum="1" Maximum="100000" SmallChange="10" LargeChange="100"
                                           SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.ArtistRankTop, Mode=TwoWay}"
                                           helpers:Anim.Appear="True" Visibility="{x:Bind ViewModel.IsArtistRankTop, Mode=OneWay}"
                                           AutomationProperties.Name="How many artists are ranked" AutomationProperties.AutomationId="ArtistRankTop" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- About -->
            <StackPanel x:Name="AboutGroup" Style="{StaticResource HumeGroupStyle}">
                <TextBlock Text="About" Style="{StaticResource HumeGroupHeaderText}" />
                <Border Style="{StaticResource HumeGroupListStyle}">
                    <StackPanel Style="{StaticResource HumeGroupRowsStyle}">
                        <Grid Style="{StaticResource HumeGroupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Width="24" Height="24" VerticalAlignment="Center">
                                <Image.Source>
                                    <BitmapImage UriSource="ms-appx:///Assets/MelodayMusic-app.png" DecodePixelWidth="24" DecodePixelType="Logical" />
                                </Image.Source>
                            </Image>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Meloday Music" Style="{StaticResource HumeBodyText}" />
                                <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource HumeSecondaryText}" />
                                <!-- Credits for the bundled typeface and icons; their licences ship in Assets (THIRD-PARTY-NOTICES.txt). -->
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Typeface: Manrope, Copyright 2018 The Manrope Project Authors, under the" />
                                    <Hyperlink NavigateUri="https://openfontlicense.org">SIL Open Font License 1.1</Hyperlink><Run Text="." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource HumeSecondaryText}" TextWrapping="WrapWholeWords">
                                    <Run Text="Icons: Lucide, Copyright Lucide Icons and Contributors, under the" />
                                    <Hyperlink NavigateUri="https://lucide.dev/license">ISC License</Hyperlink><Run Text="." />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource HumeSecondaryButtonStyle}" Content="Open Log Folder" Command="{x:Bind ViewModel.OpenLogsCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
