<Page
    x:Class="HumeMusic.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:models="using:HumeMusic.Core.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="Header" Padding="{StaticResource HumePageHeaderPadding}" Title="Downloads">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ShuffleButton" Style="{StaticResource HumePrimaryButtonStyle}" Click="OnShuffle" AutomationProperties.AutomationId="ShuffleDownloadsButton">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!-- Downloaded songs, newest first; a row's remove button removes its download. -->
        <ListView x:Name="List" Grid.Row="1" Padding="{StaticResource HumeListPadding}"
                  SelectionMode="Extended" controls:TrackListBehavior.IsEnabled="True"
                  ItemContainerStyle="{StaticResource HumeTrackItemStyle}"
                  AutomationProperties.Name="Downloads" AutomationProperties.AutomationId="DownloadsList">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <controls:TrackRow Track="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:PageStateView x:Name="State" Grid.Row="1" EmptyIcon="CircleArrowDown" EmptyTitle="No Downloads"
                                EmptyText="Choose Download from any song, album or playlist's … menu to keep it on this computer and play it offline." />
    </Grid>
</Page>
