<UserControl
    x:Class="HumeMusic.Controls.PageStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    IsTabStop="False">

    <!--
        The one loading, error and empty state for every page and section, in Apple's "content
        unavailable" pattern: an icon, a short title, a line of explanation and at most one action.
        Each state fades in as it appears and out as the content replaces it.
    -->
    <Grid>
        <!-- Loading: the page's own shapes, pulsing (a spinner only where no skeleton fits). -->
        <controls:SkeletonView x:Name="Skeleton" Visibility="Collapsed" VerticalAlignment="Top" helpers:Anim.Appear="True" />
        <ProgressRing x:Name="Spinner" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48" />

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48"
                    helpers:Anim.Appear="True">
            <controls:LucideIcon Icon="WifiOff" Width="{StaticResource HumeIconDisplay}" Height="{StaticResource HumeIconDisplay}" Foreground="{ThemeResource HumeTextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Couldn't Load" Style="{StaticResource HumeSectionText}" HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource HumeParagraphText}" TextAlignment="Center" />
            <Button x:Name="RetryButton" Style="{StaticResource HumeSecondaryButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnRetryClick">
                <controls:IconLabel Icon="RefreshCw" Text="Try Again" />
            </Button>
        </StackPanel>

        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="12" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,48"
                    helpers:Anim.Appear="True">
            <controls:LucideIcon x:Name="EmptyIconGlyph" Icon="Music" Width="{StaticResource HumeIconDisplay}" Height="{StaticResource HumeIconDisplay}" Foreground="{ThemeResource HumeTextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitleBlock" Style="{StaticResource HumeSectionText}" HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyTextBlock" Style="{StaticResource HumeParagraphText}" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
