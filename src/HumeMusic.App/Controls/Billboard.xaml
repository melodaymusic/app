<UserControl
    x:Class="HumeMusic.Controls.Billboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    IsTabStop="False">

    <!-- Billboard: 16:9 artist backdrop with a badge and the story laid over it. As an editorial board
         the story's heading sits above the backdrop instead, and the album's cover in its corner. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    <!-- Hover plate: grows from the centre behind the card (see CardHover). -->
    <Border x:Name="Plate" Grid.RowSpan="2" Background="{ThemeResource HumeHoverOverlayBrush}" />
    <!-- Editorial heading: eyebrow, title and subtitle above the card. -->
    <StackPanel x:Name="Heading" Visibility="Collapsed" Spacing="1" Margin="2,0,2,10" IsHitTestVisible="False">
        <TextBlock x:Name="HeadingEyebrow" Style="{StaticResource HumeOverlineText}" Foreground="{ThemeResource HumeTextTertiaryBrush}" />
        <TextBlock x:Name="HeadingTitle" Style="{StaticResource HumeHeadlineText}" TextTrimming="CharacterEllipsis" MaxLines="1" />
        <TextBlock x:Name="HeadingSubtitle" Style="{StaticResource HumeSecondaryText}" FontSize="{StaticResource HumeFontBodyLarge}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <Grid x:Name="Root" Grid.Row="1" Width="{StaticResource HumeBillboardWidth}" Height="{StaticResource HumeBillboardHeight}" CornerRadius="{StaticResource HumeRadiusBoard}" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
          ContextRequested="OnContextRequested">
        <controls:ArtworkImage x:Name="Art" DecodeSize="720" ArtworkCornerRadius="{StaticResource HumeRadiusBoard}" PlaceholderIcon="MicVocal" />
        <Border IsHitTestVisible="False" CornerRadius="{StaticResource HumeRadiusBoard}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.3" />
                    <GradientStop Color="#8C000000" Offset="0.68" />
                    <GradientStop Color="#E0000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Badge (pill radius = height / 2). -->
        <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Padding="10,0"
                Height="{StaticResource HumeBadgeHeight}" CornerRadius="{StaticResource HumeRadiusBadge}"
                Background="#8C1A1A1D" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <TextBlock x:Name="BadgeText" Style="{StaticResource HumeBoardEyebrowText}" FontSize="{StaticResource HumeFontBadge}"
                       CharacterSpacing="80" Foreground="#FFFFFF" VerticalAlignment="Center" />
        </Border>

        <!-- Editorial: the album's cover bottom left (clear of the play button), a short line beside it. -->
        <Grid x:Name="Editorial" VerticalAlignment="Bottom" Margin="16,0,72,16" ColumnSpacing="14" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ArtworkImage x:Name="Cover" Width="64" Height="64" DecodeSize="128" ArtworkCornerRadius="{StaticResource HumeRadiusArtwork}" PlaceholderIcon="Disc3" />
            <TextBlock x:Name="EditorialLine" Grid.Column="1" Style="{StaticResource HumeBoardSubtitleText}" Foreground="#FFFFFF" VerticalAlignment="Bottom"
                       TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Grid>

        <StackPanel x:Name="Story" VerticalAlignment="Bottom" Padding="20,0,72,16" Spacing="1" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" Style="{StaticResource HumeBoardTitleText}" FontSize="{StaticResource HumeFontBillboardTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource HumeBoardSubtitleText}" />
            <TextBlock x:Name="DetailText" Style="{StaticResource HumeBoardDetailText}" Margin="0,2,0,0" />
        </StackPanel>
        <Button x:Name="PlayButton" x:Load="False" Style="{StaticResource HumeOverlayButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" IsTabStop="False"
                ToolTipService.ToolTip="Play" AutomationProperties.Name="Play" Click="OnPlayClick">
            <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" Margin="2,0,0,0" />
        </Button>
    </Grid>
    </Grid>
</UserControl>
