<UserControl
    x:Class="HumeMusic.Controls.MediaTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    IsTabStop="False">

    <Grid x:Name="Root" RowSpacing="2" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
          ContextRequested="OnContextRequested">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="Plate" Grid.RowSpan="3" Background="{ThemeResource HumeHoverOverlayBrush}" />

        <!-- Square artwork: the height follows the width inside layout (no SizeChanged feedback). -->
        <controls:AspectBox>
        <Grid x:Name="ArtHost" SizeChanged="OnArtSizeChanged">
            <controls:ArtworkImage x:Name="Art" />
            <!-- Stations have no artwork of their own: their colour field and their name. -->
            <Grid x:Name="StationArt" x:Load="False" CornerRadius="{StaticResource HumeRadiusArtwork}">
                <controls:MotionArtwork x:Name="StationField" />
                <controls:CoverLabels x:Name="StationLabels" Label="Radio" />
            </Grid>
            <!-- Mixes have no artwork of their own: their artists on a field of colour. -->
            <controls:MixCover x:Name="MixArt" x:Load="False" />
            <Button x:Name="PlayButton" x:Load="False" Style="{StaticResource HumeOverlayButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                    IsTabStop="False" ToolTipService.ToolTip="Play" AutomationProperties.Name="Play"
                    Click="OnPlayClick">
                <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" Margin="2,0,0,0" />
            </Button>
        </Grid>
        </controls:AspectBox>

        <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource HumeBodyStrongText}" />
        <!-- A smart playlist is marked by a small sparkle beside "Smart playlist", never on its artwork. -->
        <!-- No ColumnSpacing: it would indent every subtitle, sparkle or not. -->
        <Grid x:Name="SubtitleRow" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:LucideIcon x:Name="SmartIcon" x:Load="False" Icon="Sparkles" Width="{StaticResource HumeIconXS}" Height="{StaticResource HumeIconXS}" Margin="0,0,4,0" VerticalAlignment="Center"
                                 Foreground="{ThemeResource HumeTextSecondaryBrush}" />
            <TextBlock x:Name="SubtitleText" Grid.Column="1" Style="{StaticResource HumeSecondaryText}" />
        </Grid>
    </Grid>
</UserControl>
