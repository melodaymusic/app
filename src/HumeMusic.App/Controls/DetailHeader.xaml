<UserControl
    x:Class="HumeMusic.Controls.DetailHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    IsTabStop="False">

    <!--
        The one header for every detail page (album, playlist, collection): cover, title, a subtitle
        link, meta line, description and actions, laid out identically everywhere. It stays fixed at
        the top of the page and condenses to cover, title and actions while the content scrolls.
    -->
    <Grid x:Name="Root" Padding="{StaticResource HumeDetailHeaderPadding}" ColumnSpacing="{StaticResource HumeDetailHeaderSpacing}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Receives the cover's shadow. -->
        <Border x:Name="ShadowReceiver" Grid.ColumnSpan="2" Margin="-40,-40,-40,-40" IsHitTestVisible="False" />

        <controls:ArtworkImage x:Name="Cover" DecodeSize="480" ArtworkCornerRadius="{StaticResource HumeRadiusLargeArtwork}" VerticalAlignment="Bottom" />
        <!-- A live cover over the picture (Meloday's breathing sun), the same size and shape as it. -->
        <Border x:Name="LiveCoverHost" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="{StaticResource HumeRadiusLargeArtwork}"
                Width="{Binding Width, ElementName=Cover}" Height="{Binding Height, ElementName=Cover}" Visibility="Collapsed" IsHitTestVisible="False" />

        <StackPanel x:Name="TextPanel" Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource HumeHeroText}" TextWrapping="WrapWholeWords" MaxLines="2"
                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            <HyperlinkButton x:Name="SubtitleLink" Style="{StaticResource HumeHeroSubtitleLinkStyle}" Click="OnSubtitleClick" Visibility="Collapsed">
                <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" />
            </HyperlinkButton>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- A smart playlist: a small sparkle before "Smart playlist". -->
                <controls:LucideIcon x:Name="SmartIcon" Icon="Sparkles" Width="{StaticResource HumeIconXS}" Height="{StaticResource HumeIconXS}" VerticalAlignment="Center" Visibility="Collapsed"
                                     Foreground="{ThemeResource HumeTextSecondaryBrush}" />
                <TextBlock x:Name="MetaLine" Style="{StaticResource HumeSecondaryText}" Visibility="Collapsed" />
            </StackPanel>

            <!-- Editorial notes, clipped with a "More" toggle. -->
            <StackPanel x:Name="Notes" Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" Visibility="Collapsed" helpers:Anim.Appear="True">
                <TextBlock x:Name="NotesText" Style="{StaticResource HumeParagraphText}" MaxLines="2" TextTrimming="WordEllipsis"
                           IsTextTrimmedChanged="OnNotesTrimmedChanged" />
                <HyperlinkButton x:Name="NotesToggle" Style="{StaticResource HumeMoreLinkStyle}" Content="More" Click="OnToggleNotes" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button Style="{StaticResource HumePrimaryButtonStyle}" Click="OnPlay" AutomationProperties.Name="Play" AutomationProperties.AutomationId="DetailPlayButton">
                    <controls:IconLabel Icon="Play" IsFilled="True" Text="Play" />
                </Button>
                <Button Style="{StaticResource HumeSecondaryButtonStyle}" Click="OnShuffle" AutomationProperties.Name="Shuffle">
                    <controls:IconLabel Icon="Shuffle" Text="Shuffle" />
                </Button>
                <controls:PinButton x:Name="Pin" />
                <!-- One more action for a page that has one (Meloday's "Keep on Plex"). -->
                <ContentPresenter x:Name="ExtraActionsHost" VerticalAlignment="Center" />
                <!-- Add to a playlist (albums and collections; a playlist's own actions live in its ... menu). -->
                <Button x:Name="AddToPlaylistButton" Style="{StaticResource HumeRoundActionButtonStyle}" Click="OnAddToPlaylist" Visibility="Collapsed"
                        ToolTipService.ToolTip="Add to Playlist" AutomationProperties.Name="Add to Playlist" AutomationProperties.AutomationId="AddToPlaylistButton">
                    <controls:LucideIcon Icon="ListPlus" />
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource HumeRoundActionButtonStyle}" Click="OnMore"
                        ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
                    <controls:LucideIcon Icon="Ellipsis" />
                </Button>
                <!-- Your rating (albums; Plex doesn't rate playlists or collections). -->
                <controls:StarRating x:Name="HeaderRating" StarSize="{StaticResource HumeStarM}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="StatusLine" Style="{StaticResource HumeSecondaryText}" Margin="0,8,0,0" TextWrapping="WrapWholeWords" MaxWidth="720"
                       HorizontalAlignment="Left" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
