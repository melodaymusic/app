<UserControl
    x:Class="HumeMusic.Controls.ChipTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    IsTabStop="False">

    <!-- Chips in a row: the chosen one's pill slides to it from the last, behind the chips. -->
    <Grid x:Name="Host">
        <Border x:Name="PillIndicator" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                Background="{ThemeResource HumeChipSelectedBrush}" CornerRadius="{StaticResource HumeRadiusChip}" />
        <ListView x:Name="List" SelectionMode="Single" ItemContainerStyle="{StaticResource HumeChipItemStyle}"
                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled" SelectionChanged="OnSelectionChanged">
            <ListView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Themes/NavList.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <!-- Chips are pills: radius = height / 2. -->
                    <StaticResource x:Key="ListViewItemCornerRadius" ResourceKey="HumeRadiusChip" />
                    <!-- The sliding pill behind marks the chosen chip, so chips draw no selection of their own. -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="HumeHoverOverlayBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="HumePressedOverlayBrush" />
                </ResourceDictionary>
            </ListView.Resources>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" Background="Transparent" controls:ScrollBehavior.PassVerticalWheel="True" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:IChipTab">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LucideIcon Icon="{x:Bind Icon}" Width="{StaticResource HumeIconM}" Height="{StaticResource HumeIconM}" />
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource HumeBodyText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
