<UserControl
    x:Class="HumeMusic.Controls.MediaListRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    xmlns:helpers="using:HumeMusic.Helpers"
    IsTabStop="False">

    <!--
        An album, artist, playlist or collection as a row of a list (the library pages' list view): its artwork, its name and
        what it is, and at the far end a detail (the year, how many tracks). Hovering shows a play button; right-click opens the
        item menu, as on a tile. Opening the item is the hosting list's ItemClick.
    -->
    <Grid x:Name="Root" ColumnSpacing="16" Padding="4,6,4,6" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
          ContextRequested="OnContextRequested">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:ArtworkImage x:Name="Art" Width="52" Height="52" DecodeSize="104" ArtworkCornerRadius="{StaticResource HumeRadiusThumb}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource HumeBodyStrongText}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource HumeSecondaryText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="DetailText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource HumeSecondaryText}" />
        <Button x:Name="PlayButton" Grid.Column="3" Style="{StaticResource HumeIconButtonStyle}" Width="{StaticResource HumeButtonS}" Height="{StaticResource HumeButtonS}"
                Opacity="0" IsHitTestVisible="False" helpers:Anim.Fade="True" IsTabStop="False"
                ToolTipService.ToolTip="Play" AutomationProperties.Name="Play" Click="OnPlayClick">
            <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" Margin="2,0,0,0" />
        </Button>
    </Grid>
</UserControl>
