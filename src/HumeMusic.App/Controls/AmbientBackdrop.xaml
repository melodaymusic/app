<UserControl
    x:Class="HumeMusic.Controls.AmbientBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HumeMusic.Controls"
    IsHitTestVisible="False" IsTabStop="False">

    <!--
        The colour behind the whole window. Frosted panels (sidebar, player, queue) blur whatever is
        here, so the glass always has something to show:
          1. the now-playing track's Plex UltraBlur, dimmed so pages read first;
          2. a page's own UltraBlur (artist pages) at full strength, with a shade sized for white text;
          3. a page's UltraBlur as a header that fades out down the page (album, playlist, collection).
    -->
    <!-- The layers' fades are set in code, so they follow the Motion setting. -->
    <Grid>
        <Border x:Name="BaseLayer" />

        <!-- Each crossfading pair has its own grid, so reordering the pair never lifts an image above the layers after it. -->
        <Grid>
            <Image x:Name="PlayingA" Stretch="UniformToFill" Opacity="0" />
            <Image x:Name="PlayingB" Stretch="UniformToFill" Opacity="0" />
        </Grid>
        <Border x:Name="DimLayer" />

        <!-- Album / playlist / collection pages: Plex UltraBlur at the top, dissolving into the page below. -->
        <local:FadedArtwork x:Name="HeaderLayer" FadeLeft="0" FadeTop="0" FadeBottom="0.7" />
        <Border x:Name="HeaderShade" Height="680" VerticalAlignment="Top" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#59000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="0.6" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Image x:Name="PageA" Stretch="UniformToFill" Opacity="0" />
            <Image x:Name="PageB" Stretch="UniformToFill" Opacity="0" />
        </Grid>
        <Border x:Name="PageShade" Background="Black" Opacity="0" />

        <Border x:Name="WashLayer" Height="680" VerticalAlignment="Top" />
    </Grid>
</UserControl>
