<UserControl
    x:Class="HumeMusic.Controls.SquareBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HumeMusic.Controls"
    IsTabStop="False">

    <!--
        Squareboard: a billboard at 1:1, its name over the art in the bottom left. Tag stations show an
        artist from the station as a large circle on the photo's own palette colour, with a gentle shade
        rising from the bottom left for the name; Plex's stations move in their colour field, and Meloday
        shows its cover, live.
    -->
    <Grid>
        <!-- Hover plate: grows from the centre behind the card (see CardHover). -->
        <Border x:Name="Plate" Background="{ThemeResource HumeHoverOverlayBrush}" />
        <controls:AspectBox x:Name="Box">
            <Grid x:Name="Root" CornerRadius="{StaticResource HumeRadiusBoard}" Background="#2A2930"
                  PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited"
                  ContextRequested="OnContextRequested">
                <!--
                    The artist, inset as a circle (95% of the card) on the card's colour, with a gentle shade
                    from its bottom left (on the photo only, not the card) so the name reads on any photo.
                    A 1000-unit box scaled to fit.
                -->
                <Viewbox x:Name="Portrait" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed">
                    <Grid Width="1000" Height="1000">
                        <controls:ArtworkImage x:Name="PortraitImage" Width="950" Height="950" DecodeSize="480" ArtworkCornerRadius="475" ShowOutline="False"
                                               PlaceholderIcon="MicVocal" />
                        <Ellipse Width="950" Height="950">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.05,0.95" GradientOrigin="0.05,0.95" RadiusX="1" RadiusY="1" MappingMode="RelativeToBoundingBox">
                                    <GradientStop Color="#8C000000" Offset="0" />
                                    <GradientStop Color="#40000000" Offset="0.4" />
                                    <GradientStop Color="#00000000" Offset="0.75" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- And a second shade from the top right, behind the name. -->
                        <Ellipse Width="950" Height="950">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.95,0.05" GradientOrigin="0.95,0.05" RadiusX="1" RadiusY="1" MappingMode="RelativeToBoundingBox">
                                    <GradientStop Color="#8C000000" Offset="0" />
                                    <GradientStop Color="#40000000" Offset="0.4" />
                                    <GradientStop Color="#00000000" Offset="0.75" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Viewbox>
                <controls:MotionArtwork x:Name="Field" />
                <!-- Meloday: its cover, live (the part of the day's sun, breathing), with the mix's name. -->
                <controls:MelodayArt x:Name="MelodayCover" Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- A station: its name top right and "Radio" bottom left, as Meloday's cover sets its own. -->
                <controls:CoverLabels x:Name="StationLabels" Label="Radio" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" Style="{StaticResource HumeBoardTitleText}" FontSize="{StaticResource HumeFontColourTitle}" TextWrapping="WrapWholeWords" MaxLines="2"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,56,14" IsHitTestVisible="False" />
                <Button x:Name="PlayButton" x:Load="False" Style="{StaticResource HumeOverlayButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" IsTabStop="False"
                        ToolTipService.ToolTip="Play" AutomationProperties.Name="Play" Click="OnPlayClick">
                    <controls:LucideIcon Icon="Play" IsFilled="True" Width="{StaticResource HumeIconS}" Height="{StaticResource HumeIconS}" Margin="2,0,0,0" />
                </Button>
            </Grid>
        </controls:AspectBox>
    </Grid>
</UserControl>
